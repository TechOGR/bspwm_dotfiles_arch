import os
import sys
import json
import math
import time
import socket
import subprocess
from urllib.parse import quote_plus

sys.path.insert(0, os.path.expanduser('~/.config/bspwm/lib'))
import riceui as ui  # noqa: E402
import avatar as avatar_lib  # noqa: E402  (profile picture made by AvatarForge)
from riceui import Gtk, Gdk, GLib, GdkPixbuf, Pango, cairo  # noqa: E402
from gi.repository import Gio  # noqa: E402

USAGE = os.path.join(ui.HOME, '.cache', os.environ.get('USER', 'user'), 'applauncher-usage.json')
CATEGORIES = [
    ('all', '󰀻', 'All apps', None),
    ('frequent', '󰋚', 'Frequent', None),
    ('dev', '󰅩', 'Development', {'Development', 'IDE', 'TextEditor'}),
    ('net', '󰖟', 'Internet', {'Network', 'WebBrowser', 'Email', 'Chat', 'InstantMessaging'}),
    ('media', '󰝚', 'Multimedia', {'AudioVideo', 'Audio', 'Video', 'Player', 'Music'}),
    ('gfx', '󰏘', 'Graphics', {'Graphics', 'Photography', 'Viewer', '2DGraphics', '3DGraphics'}),
    ('office', '󰈙', 'Office', {'Office', 'WordProcessor', 'Spreadsheet', 'Presentation'}),
    ('games', '󰊴', 'Games', {'Game'}),
    ('system', '󰒓', 'System', {'System', 'Settings', 'Monitor', 'TerminalEmulator', 'PackageManager'}),
    ('utils', '󰦬', 'Utilities', {'Utility', 'Accessories', 'FileManager', 'Archiving', 'FileTools'}),
]


def load_usage():
    try:
        with open(USAGE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_usage(data):
    try:
        with open(USAGE, 'w') as f:
            json.dump(data, f)
    except OSError:
        pass


class App:
    __slots__ = ('info', 'id', 'name', 'generic', 'hay', 'cats', 'icon')

    def __init__(self, info):
        self.info = info
        self.id = info.get_id() or ''
        self.name = info.get_display_name() or info.get_name() or self.id
        self.generic = info.get_generic_name() or info.get_description() or ''
        keywords = ' '.join(info.get_keywords() or [])
        self.hay = ' '.join([self.generic, keywords, info.get_executable() or '', self.id]).lower()
        self.cats = set((info.get_categories() or '').split(';'))
        self.icon = info.get_icon()

    def score(self, q):
        if not q:
            return 1
        name = self.name.lower()
        if name == q:
            return 1000
        if name.startswith(q):
            return 800 - len(name)
        if any(w.startswith(q) for w in name.replace('-', ' ').split()):
            return 600 - len(name)
        if q in name:
            return 400
        if q in self.hay:
            return 200
        it = iter(name)  # fuzzy: letters of q in order
        if all(ch in it for ch in q):
            return 50
        return 0


class Launcher(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.set_title('AppLauncher')
        ui.rgba_window(self)
        geo = ui.monitor_geometry()
        self.W, self.H = geo.width, geo.height
        self.move(geo.x, geo.y)
        self.set_size_request(self.W, self.H)
        self.set_resizable(False)
        self.pal = ui.load_palette()
        self.c = ui.rgb_palette(self.pal)
        self.bg = ui.backdrop(self.W, self.H, self.pal, darken=0.55)
        self.usage = load_usage()
        self.dock = ui.load_dock_conf()
        self.category = 'all'
        self.t0 = time.monotonic()
        self.closing = None
        self.armed = None
        self.install_css()

        apps = [App(a) for a in Gio.AppInfo.get_all() if a.should_show()]
        self.apps = sorted(apps, key=lambda a: a.name.lower())

        # ── layout: floating panel centered on the backdrop
        pw, ph = min(1180, int(self.W * 0.66)), min(760, int(self.H * 0.76))
        panel = Gtk.Box(spacing=0)
        panel.get_style_context().add_class('panel')
        panel.set_size_request(pw, ph)
        panel.set_halign(Gtk.Align.CENTER)
        panel.set_valign(Gtk.Align.CENTER)
        self.panel = panel
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.get_style_context().add_class('hud')
        root.pack_start(panel, True, False, 0)
        self.add(root)

        panel.pack_start(self.build_sidebar(), False, False, 0)
        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        main.get_style_context().add_class('main')
        panel.pack_start(main, True, True, 0)

        self.search = Gtk.SearchEntry()
        self.search.get_style_context().add_class('search')
        self.search.set_placeholder_text('Search apps…   (no match + Enter = web search)')
        self.search.connect('search-changed', lambda *_: self.refresh())
        main.pack_start(self.search, False, False, 0)

        self.section = Gtk.Label(xalign=0)
        self.section.get_style_context().add_class('section')
        main.pack_start(self.section, False, False, 0)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroll = scroll
        main.pack_start(scroll, True, True, 0)
        self.flow = Gtk.FlowBox()
        self.flow.set_valign(Gtk.Align.START)
        self.flow.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.flow.set_activate_on_single_click(True)
        self.flow.set_homogeneous(True)
        self.flow.set_min_children_per_line(4)
        self.flow.set_max_children_per_line(8)
        self.flow.set_column_spacing(10)
        self.flow.set_row_spacing(10)
        self.flow.set_can_focus(False)
        self.flow.connect('child-activated', lambda _f, ch: self.launch(ch.app))
        scroll.add(self.flow)

        self.empty = Gtk.Label()
        self.empty.get_style_context().add_class('empty')
        self.empty.set_no_show_all(True)
        main.pack_start(self.empty, False, False, 20)

        foot = Gtk.Label(xalign=0.5)
        foot.get_style_context().add_class('foot')
        foot.set_text('⏎ LAUNCH    ←↑↓→ NAVIGATE    TAB CATEGORY    RIGHT CLICK  PIN TO DOCK    ESC CLOSE')
        main.pack_start(foot, False, False, 0)
        self.toast = Gtk.Label()
        self.toast.get_style_context().add_class('toast')
        self.toast.set_no_show_all(True)
        main.pack_start(self.toast, False, False, 0)

        self.tiles = {}
        for app in self.apps:
            child = self.build_tile(app)
            self.flow.add(child)
            self.tiles[app.id] = child
        self.flow.set_sort_func(self.sort_func)
        self.flow.set_filter_func(self.filter_func)

        self.add_events(Gdk.EventMask.KEY_PRESS_MASK | Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect('draw', self.on_draw)
        self.connect('key-press-event', self.on_key)
        self.connect('button-press-event', self.on_bg_click)
        self.connect('map-event', lambda *_: (ui.grab_input(self), self.search.grab_focus()))
        self.connect('destroy', Gtk.main_quit)
        self.add_tick_callback(self.on_tick)
        self.set_category('all')

    # ────────────────────────────────────────────────────────── building
