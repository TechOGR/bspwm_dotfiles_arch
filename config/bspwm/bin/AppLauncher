''').encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 2)

    def build_sidebar(self):
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        side.get_style_context().add_class('side')
        side.set_size_request(230, -1)
        avatar = Gtk.DrawingArea()
        avatar.set_size_request(-1, 96)
        # same avatar as RiceEditor / UserCard (AvatarForge)
        path = avatar_lib.current_path()
        self.avatar = None
        if path and os.path.exists(path):
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 72, 72, True)
                self.avatar = Gdk.cairo_surface_create_from_pixbuf(pix, 1, None)
            except GLib.Error:
                pass
        avatar.connect('draw', self.draw_avatar)
        self.avatar_area = avatar
        side.pack_start(avatar, False, False, 0)
        user = Gtk.Label(label=os.environ.get('USER', 'user').upper())
        user.get_style_context().add_class('user')
        side.pack_start(user, False, False, 0)
        host = Gtk.Label(label=f'@{socket.gethostname()}  ·  {len(self.apps)} apps')
        host.get_style_context().add_class('host')
        side.pack_start(host, False, False, 12)

        self.cat_buttons = {}
        for key, icon, title, cats in CATEGORIES:
            count = self.count_cat(key, cats)
            if key not in ('all', 'frequent') and not count:
                continue
            b = Gtk.Button()
            b.get_style_context().add_class('cat')
            row = Gtk.Box(spacing=8)
            ic = Gtk.Label(label=icon)
            ic.get_style_context().add_class('cat-icon')
            row.pack_start(ic, False, False, 0)
            row.pack_start(Gtk.Label(label=title, xalign=0), True, True, 0)
            n = Gtk.Label(label=str(count))
            n.get_style_context().add_class('cat-count')
            row.pack_end(n, False, False, 0)
            b.add(row)
            b.set_can_focus(False)
            b.connect('clicked', lambda _b, k=key: self.set_category(k))
            side.pack_start(b, False, False, 0)
            self.cat_buttons[key] = b

        power = Gtk.Box(spacing=6, homogeneous=True)
        for icon, tip, cmd in (('󰌾', 'Lock', ['ScreenLocker']), ('󰍃', 'Log out', ['bspc', 'quit']),
                               ('󰜉', 'Reboot', ['systemctl', 'reboot']),
                               ('󰐥', 'Power off', ['systemctl', 'poweroff'])):
            b = Gtk.Button(label=icon)
            b.get_style_context().add_class('power')
            b.set_tooltip_text(tip)
            b.set_can_focus(False)
            b.connect('clicked', self.on_power, tip, cmd)
            power.pack_start(b, True, True, 0)
        side.pack_end(power, False, False, 0)
        return side

    def draw_avatar(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        cx, cy, r = W / 2, H / 2, 38
        t = time.monotonic()
        if self.avatar:
            cr.save()
            cr.arc(cx, cy, r - 4, 0, 2 * math.pi)
            cr.clip()
            cr.set_source_surface(self.avatar, cx - 36, cy - 36)
            cr.paint()
            cr.restore()
        cr.set_line_width(2)
        for i in range(3):
            a = t * 1.3 + i * 2.094
            cr.arc(cx, cy, r + 3, a, a + 1.2)
            cr.set_source_rgba(*self.c['blue'], 0.9)
            cr.stroke()
        cr.set_line_width(1)
        cr.arc(cx, cy, r + 8, -t * 0.6, -t * 0.6 + 4.5)
        cr.set_source_rgba(*self.c['magenta'], 0.6)
        cr.stroke()
        return True

    def build_tile(self, app):
        child = Gtk.FlowBoxChild()
        child.app = app
        ev = Gtk.EventBox()
        ev.connect('button-press-event', self.on_tile_click, app)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.get_style_context().add_class('tile')
        box.set_size_request(118, -1)
        overlay = Gtk.Overlay()
        img = Gtk.Image()
        img.set_pixel_size(52)
        if app.icon:
            img.set_from_gicon(app.icon, Gtk.IconSize.DIALOG)
        else:
            img.set_from_icon_name('application-x-executable', Gtk.IconSize.DIALOG)
        img.set_pixel_size(52)
        overlay.add(img)
        pin = Gtk.Label(label='󰐃')
        pin.get_style_context().add_class('pin')
        pin.set_halign(Gtk.Align.END)
        pin.set_valign(Gtk.Align.START)
        pin.set_margin_end(14)
        pin.set_no_show_all(True)
        pin.set_visible(app.id in self.dock['apps'])
        overlay.add_overlay(pin)
        child.pin = pin
        box.pack_start(overlay, False, False, 0)
        name = Gtk.Label(label=app.name)
        name.get_style_context().add_class('tile-name')
        name.set_ellipsize(Pango.EllipsizeMode.END)
        name.set_max_width_chars(14)
        box.pack_start(name, False, False, 0)
        tip = app.name + (f'\n{app.generic}' if app.generic else '') + '\nRight click: pin / unpin in the dock'
        box.set_tooltip_text(tip)
        ev.add(box)
        child.add(ev)
        return child

    def count_cat(self, key, cats):
        if key == 'all':
            return len(self.apps)
        if key == 'frequent':
            return sum(1 for a in self.apps if self.usage.get(a.id))
        return sum(1 for a in self.apps if a.cats & cats)

    # ────────────────────────────────────────────────────────── filtering
    def set_category(self, key):
        self.category = key
        for k, b in self.cat_buttons.items():
            (b.get_style_context().add_class if k == key else b.get_style_context().remove_class)('active')
        self.refresh()

    def query(self):
        return self.search.get_text().strip().lower()

    def filter_func(self, child):
        app = child.app
        q = self.query()
        if q:
            return app.score(q) > 0  # searching ignores the category
        if self.category == 'all':
            return True
        if self.category == 'frequent':
            return bool(self.usage.get(app.id))
        cats = next(c for k, _, _, c in CATEGORIES if k == self.category)
        return bool(app.cats & cats)

    def sort_func(self, a, b):
        q = self.query()
        if q:
            sa, sb = a.app.score(q), b.app.score(q)
            if sa != sb:
                return sb - sa
        elif self.category == 'frequent':
            ua, ub = self.usage.get(a.app.id, 0), self.usage.get(b.app.id, 0)
            if ua != ub:
                return ub - ua
        return (a.app.name.lower() > b.app.name.lower()) - (a.app.name.lower() < b.app.name.lower())

    def visible_children(self):
        out = [ch for ch in self.flow.get_children() if ch.get_child_visible() and self.filter_func(ch)]
        return sorted(out, key=lambda ch: ch.get_index())

    def refresh(self):
        self.flow.invalidate_filter()
        self.flow.invalidate_sort()
        vis = self.visible_children()
        q = self.query()
        title = next(t for k, _, t, _ in CATEGORIES if k == self.category)
        self.section.set_text((f'RESULTS FOR "{q.upper()}"' if q else title.upper()) + f'  ·  {len(vis)}')
        if vis:
            self.flow.select_child(vis[0])
            self.empty.hide()
        else:
            self.empty.set_text(f'No app matches "{q}" — press Enter to search the web' if q
                                else 'Nothing here yet — apps you open will show up in Frequent')
            self.empty.show()
        self.scroll.get_vadjustment().set_value(0)

    # ────────────────────────────────────────────────────────── actions
    def launch(self, app):
        self.usage[app.id] = self.usage.get(app.id, 0) + 1
        save_usage(self.usage)
        try:
            ctx = Gdk.Display.get_default().get_app_launch_context()
            app.info.launch([], ctx)
        except GLib.Error as e:
            print(f'AppLauncher: {e}', file=sys.stderr)
        self.close()

    def web_search(self, q):
        subprocess.Popen(['xdg-open', f'https://duckduckgo.com/?q={quote_plus(q)}'],
                         start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.close()

    def toggle_pin(self, app):
        self.dock = ui.load_dock_conf()
        apps = self.dock['apps']
        if app.id in apps:
            apps.remove(app.id)
            msg = f'󰐄  {app.name} removed from the dock'
        else:
            apps.append(app.id)
            msg = f'󰐃  {app.name} pinned to the dock'
        ui.save_dock_conf(self.dock)
        self.tiles[app.id].pin.set_visible(app.id in apps)
        self.toast.set_text(msg)
        self.toast.show()
        GLib.timeout_add(1800, lambda: (self.toast.hide(), False)[1])

    def on_tile_click(self, _w, ev, app):
        if ev.button == 3:
            self.toggle_pin(app)
            return True
        return False

    def on_power(self, button, tip, cmd):
        ctx = button.get_style_context()
        if tip == 'Lock' or self.armed is button:
            subprocess.Popen(cmd, start_new_session=True)
            self.close()
            return
        if self.armed:
            self.armed.get_style_context().remove_class('armed')
        self.armed = button
        ctx.add_class('armed')
        button.set_tooltip_text(f'Click again to {tip.lower()}')
        self.toast.set_text(f'Click again to {tip.lower()}')
        self.toast.show()

        def disarm():
            if self.armed is button:
                ctx.remove_class('armed')
                self.armed = None
                self.toast.hide()
            return False
        GLib.timeout_add(3000, disarm)

    def move_selection(self, dx, dy):
        vis = self.visible_children()
        if not vis:
            return
        sel = self.flow.get_selected_children()
        idx = vis.index(sel[0]) if sel and sel[0] in vis else 0
        alloc = self.flow.get_allocated_width()
        tile = vis[0].get_allocated_width() + 10
        cols = max(1, alloc // tile) if tile > 10 else 6
        idx = max(0, min(len(vis) - 1, idx + dx + dy * cols))
        self.flow.select_child(vis[idx])
        a = vis[idx].get_allocation()
        adj = self.scroll.get_vadjustment()
        if a.y < adj.get_value():
            adj.set_value(a.y)
        elif a.y + a.height > adj.get_value() + adj.get_page_size():
            adj.set_value(a.y + a.height - adj.get_page_size())

    def on_key(self, _w, ev):
        k = ev.keyval
        if k == Gdk.KEY_Escape:
            if self.search.get_text():
                self.search.set_text('')
            else:
                self.close()
            return True
        if k in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            sel = self.flow.get_selected_children()
            if sel and sel[0] in self.visible_children():
                self.launch(sel[0].app)
            elif self.query():
                self.web_search(self.search.get_text().strip())
            return True
        moves = {Gdk.KEY_Left: (-1, 0), Gdk.KEY_Right: (1, 0), Gdk.KEY_Up: (0, -1), Gdk.KEY_Down: (0, 1)}
        if k in moves and not (k in (Gdk.KEY_Left, Gdk.KEY_Right) and self.search.get_text()
                               and ev.state & Gdk.ModifierType.SHIFT_MASK):
            self.move_selection(*moves[k])
            return True
        if k in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
            keys = list(self.cat_buttons)
            step = -1 if k == Gdk.KEY_ISO_Left_Tab else 1
            self.search.set_text('')
            self.set_category(keys[(keys.index(self.category) + step) % len(keys)])
            return True
        if k == Gdk.KEY_space and ev.state & Gdk.ModifierType.MOD4_MASK:
            self.close()  # Super+Space toggles
            return True
        return False

    def on_bg_click(self, _w, ev):
        # a click on the backdrop (outside the panel) closes the launcher
        a = self.panel.get_allocation()
        x, y = self.translate_event(ev)
        if not (a.x <= x <= a.x + a.width and a.y <= y <= a.y + a.height):
            self.close()
        return False

    def translate_event(self, ev):
        _, wx, wy = ev.window.get_origin()
        _, tx, ty = self.get_window().get_origin()
        return ev.x + wx - tx, ev.y + wy - ty

    # ─────────────────────────────────────────────────────────── drawing
    def on_draw(self, _w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_surface(self.bg, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        now = time.monotonic()
        acc, acc2 = self.c['blue'], self.c['magenta']
        # HUD title above the panel
        ui.text(cr, time.strftime('%H:%M'), self.W / 2, 40, 30, (*self.c['fg'], 0.95), bold=True,
                align='center', spacing=4)
        ui.text(cr, time.strftime('%A %d %B').upper(), self.W / 2, 92, 9, (*acc, 0.8),
                align='center', spacing=4)
        # scanning line under the date
        y = 118
        w = 420
        x0 = self.W / 2 - w / 2
        lg = cairo.LinearGradient(x0, 0, x0 + w, 0)
        lg.add_color_stop_rgba(0, *acc, 0)
        lg.add_color_stop_rgba(0.5, *acc, 0.8)
        lg.add_color_stop_rgba(1, *acc, 0)
        cr.rectangle(x0, y, w, 1)
        cr.set_source(lg)
        cr.fill()
        sx = x0 + (math.sin(now * 1.6) * 0.5 + 0.5) * w
        cr.arc(sx, y + 0.5, 2.5, 0, 2 * math.pi)
        cr.set_source_rgba(*acc2, 1)
        cr.fill()
        return False

    def on_tick(self, *_):
        now = time.monotonic()
        if self.closing:
            a = 1 - (now - self.closing) / 0.14
            if a <= 0:
                self.destroy()
                return False
        else:
            a = min(1.0, (now - self.t0) / 0.18)
        if self.get_window():
            self.get_window().set_opacity(max(0.0, a))
        self.avatar_area.queue_draw()
        self.queue_draw_area(0, 0, self.W, 130)
        return True

    def close(self):
        if not self.closing:
            self.closing = time.monotonic()


def main():
    GLib.set_prgname('AppLauncher')
    _lock = ui.single_instance('applauncher', toggle=True)  # noqa: F841
    win = Launcher()
    ui.quit_on_sigterm(win.close)
    win.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
