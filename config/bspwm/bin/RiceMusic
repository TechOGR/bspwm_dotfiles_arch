row.song:hover, row.song:selected { background-color: alpha(@acc, 0.14); }
list { background: transparent; }
.stitle2 { font-size: 9pt; font-weight: 700; }
''')
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)

    def ctl(self, glyph, cb, extra=''):
        b = Gtk.Button(label=glyph)
        for c in ('nbtn', 'ctl', *extra.split()):
            b.get_style_context().add_class(c)
        b.connect('clicked', lambda *_: cb())
        return b

    def t(self):
        return time.monotonic() - self.t0

    # ── equalizer
    def build_eq(self):
        box = ra.section(T('Equalizer'), '\U000f0ea2')
        self.eq_sw = Gtk.Switch()
        self.eq_sw.set_active(self.eq['on'])
        self.eq_sw.set_valign(Gtk.Align.CENTER)
        self.eq_sw.connect('notify::active', lambda *_: self.eq_toggle(self.eq_sw.get_active()))
        box.head.pack_start(Gtk.Box(), True, True, 0)
        box.head.pack_start(self.eq_sw, False, False, 0)
        box.pack_start(ra.label(T('For all the sound (browser, Spotify, MPD…)'), 'key'), False, False, 0)
        bands = Gtk.Box(spacing=4, homogeneous=True)
        self.eq_scales, self.eq_vals = [], []
        for i, lab in enumerate(riceeq.LABELS):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            v = ra.label('', 'eqval', xalign=0.5)
            sc = Gtk.Scale.new_with_range(Gtk.Orientation.VERTICAL, -riceeq.MAX_DB, riceeq.MAX_DB, 0.5)
            sc.set_inverted(True)
            sc.set_draw_value(False)
            sc.set_size_request(-1, 210)
            sc.add_mark(0, Gtk.PositionType.LEFT, None)
            sc.get_style_context().add_class('eq')
            sc.set_value(self.eq['gains'][i])
            sc.connect('value-changed', lambda s, i=i: self.eq_band(i, s.get_value()))
            col.pack_start(v, False, False, 0)
            col.pack_start(sc, True, True, 0)
            col.pack_start(ra.label(lab, 'eqlabel', xalign=0.5), False, False, 0)
            bands.pack_start(col, True, True, 0)
            self.eq_scales.append(sc)
            self.eq_vals.append(v)
        box.pack_start(bands, True, True, 6)
        box.pack_start(ra.label(T('Presets').upper(), 'stitle'), False, False, 0)
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_max_children_per_line(4)
        flow.set_min_children_per_line(3)
        flow.set_column_spacing(6)
        flow.set_row_spacing(6)
        self.preset_btns = {}
        for key in riceeq.ORDER:
            b = ra.button(riceeq.PRESET_NAMES[key][1 if ES else 0], lambda k=key: self.eq_preset(k), 'nbtn chipbtn')
            flow.add(b)
            self.preset_btns[key] = b
        box.pack_start(flow, False, False, 0)
        self.eq_marks()
        return box

    def eq_marks(self):
        for i, v in enumerate(self.eq_vals):
            g = self.eq['gains'][i]
            v.set_text(f'{g:+.1f}' if abs(g) >= 0.05 else '0')
        for k, b in self.preset_btns.items():
            (b.get_style_context().add_class if k == self.eq['preset'] else b.get_style_context().remove_class)('sel')

    def eq_band(self, i, val):
        if getattr(self, '_eq_setting', False):
            return
        self.eq['gains'][i] = round(val * 2) / 2
        self.eq['preset'] = 'custom'
        self.eq_marks()
        self.eq_push()

    def eq_preset(self, key):
        self.eq['gains'] = list(riceeq.PRESETS[key])
        self.eq['preset'] = key
        self._eq_setting = True
        for sc, g in zip(self.eq_scales, self.eq['gains']):
            sc.set_value(g)
        self._eq_setting = False
        if not self.eq['on'] and key != 'flat':
            self.eq_sw.set_active(True)     # a preset means: hear it
        self.eq_marks()
        self.eq_push()

    def eq_toggle(self, on):
        self.eq['on'] = on
        self.say(T('Equalizer on') if on else T('Equalizer off'))
        self.eq_push(0)

    def eq_push(self, delay=140):
        """Apply after the slider stops for a moment (pw-cli per step is too much)."""
        if self.eq_timer:
            GLib.source_remove(self.eq_timer)
        st = {'on': self.eq['on'], 'preset': self.eq['preset'], 'gains': list(self.eq['gains'])}

        def go():
            self.eq_timer = None
            ra.run_bg(lambda: riceeq.apply(st))
            return False
        self.eq_timer = GLib.timeout_add(delay, go) if delay else (go(), None)[1]

    # ── library (MPD)
    def build_lib(self):
        box = ra.section(T('Library'), '\U000f0cb8')
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text(T('Search in your music…'))
        self.search.connect('search-changed', lambda *_: self.lib_search())
        box.pack_start(self.search, False, False, 0)
        row = Gtk.Box(spacing=6)
        row.pack_start(ra.button(T('Queue'), self.lib_queue, 'nbtn chipbtn', '\U000f0cb8'), False, False, 0)
        row.pack_start(ra.button(T('Update library'), self.lib_update, 'nbtn chipbtn', '\U000f0450'), False, False, 0)
        row.pack_start(ra.button('ncmpcpp', self.open_ncmpcpp, 'nbtn chipbtn', '\U000f018d'), False, False, 0)
        box.pack_start(row, False, False, 0)
        self.lib_info = ra.label('', 'key', wrap=True)
        box.pack_start(self.lib_info, False, False, 0)
        self.songs = Gtk.ListBox()
        self.songs.set_activate_on_single_click(False)
        self.songs.connect('row-activated', lambda _l, r: self.lib_play(r))
        box.pack_start(self.scroller(self.songs), True, True, 0)
        GLib.idle_add(lambda: (self.lib_queue(), False)[1])
        return box

    def lib_rows(self, items, kind):
        ra.clear(self.songs)
        for pos, title, artist, path in items[:400]:
            r = Gtk.ListBoxRow()
            r.get_style_context().add_class('song')
            r.data = (kind, pos, path)
            b = Gtk.Box(spacing=10)
            b.pack_start(ra.label('\U000f0387', 'bglyph'), False, False, 0)
            t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            t.pack_start(ra.label(title, 'stitle2', ellipsize=True), False, False, 0)
            if artist:
                t.pack_start(ra.label(artist, 'key', ellipsize=True), False, False, 0)
            b.pack_start(t, True, True, 0)
            r.add(b)
            self.songs.add(r)
        self.songs.show_all()

    def lib_queue(self):
        def work():
            out = rm.run(['mpc', '-f', rm.SEP.join(['%position%', '%title%', '%artist%', '%file%']), 'playlist'])
            stats = rm.run(['mpc', 'stats'])
            items = []
            for line in out.splitlines():
                f = (line.split(rm.SEP) + ['', '', '', ''])[:4]
                items.append((f[0], f[1] or os.path.basename(f[3]), f[2], f[3]))
            return items, stats

        def done(r):
            if isinstance(r, Exception):
                return
            items, stats = r
            songs = next((ln.split(':')[1].strip() for ln in stats.splitlines() if ln.startswith('Songs:')), '0')
            if songs == '0':
                self.lib_info.set_text(f'{T("Your MPD library is empty: copy music to")} '
                                       f'{rm.mpd_music_dir().replace(HOME, "~")} {T("and press Update library.")}')
            else:
                self.lib_info.set_text(f'{T("Queue")} · {len(items)}  ·  {songs} {T("songs")}' if items else
                                       T('The queue is empty'))
            self.lib_rows(items, 'queue')
        ra.run_bg(work, done)

    def lib_search(self):
        q = self.search.get_text().strip()
        if len(q) < 2:
            return self.lib_queue()

        def work():
            out = rm.run(['mpc', '-f', rm.SEP.join(['%title%', '%artist%', '%file%']), 'search', 'any', q], timeout=6)
            return [('', *(ln.split(rm.SEP) + ['', '', ''])[:3]) for ln in out.splitlines() if ln]

        def done(items):
            if isinstance(items, Exception):
                return
            items = [(p, t or os.path.basename(f), a, f) for p, t, a, f in items]
            self.lib_info.set_text(f'{len(items)} {T("results")}')
            self.lib_rows(items, 'search')
        ra.run_bg(work, done)

    def lib_play(self, row):
        kind, pos, path = row.data
        if kind == 'queue':
            subprocess.Popen(['mpc', '-q', 'play', pos])
        else:
            subprocess.Popen(['sh', '-c', 'mpc -q add "$1" && mpc -q play "$(mpc playlist | wc -l)"', '_', path])
        self.pinned, self.player = True, 'mpd'

    def lib_update(self):
        self.say(T('Updating the library…'))
        ra.run_bg(lambda: rm.run(['mpc', '--wait', 'update'], timeout=600), lambda _r: self.lib_queue())

    def open_ncmpcpp(self):
        subprocess.Popen([os.path.join(HOME, '.config/bspwm/bin/OpenApps'), '--ncmpcpp'], start_new_session=True)

    # ── tabs / spectrum style
    def show_tab(self, key):
        self.stack.set_visible_child_name(key)
        for k, b in self.tab_btns.items():
            (b.get_style_context().add_class if k == key else b.get_style_context().remove_class)('sel')
        c = load_conf()
        c['tab'] = key
        save_conf(c)

    def set_spec(self, s):
        c = load_conf()
        c['spectrum'] = s
        save_conf(c)
        self.spec_style = spectrum_style(self.style)
        self.mark_spec()

    def mark_spec(self):
        cur = load_conf().get('spectrum', 'auto')
        cur = cur if cur in rs.STYLES else 'auto'
        for k, b in self.style_btns.items():
            (b.get_style_context().add_class if k == cur else b.get_style_context().remove_class)('sel')

    # ── players
    def poll_loop(self):
        while True:
            try:
                players = self.be.players()
                if not (self.pinned and self.player in players):
                    self.pinned = False
                    player = self.be.active(players, self.player)
                else:
                    player = self.player
                st = self.be.state(player) if player else None
                art = self.be.art_path(st['art']) if st else ''
                GLib.idle_add(self.update, players, player, st, art)
            except Exception:   # noqa: BLE001 - the loop never dies
                import traceback
                traceback.print_exc()
            time.sleep(1.0)

    def update(self, players, player, st, art):
        try:
            self._update(players, player, st, art)
        except Exception:   # noqa: BLE001
            import traceback
            traceback.print_exc()
        return False

    def _update(self, players, player, st, art):
        if players != self.players or player != self.player:
            self.players, self.player = players, player
            self.draw_sources()
        self.st = st
        if st:
            self.pos_at = (st.get('position', 0), time.monotonic())
        if (st or {}).get('art') != self.art_url:
            self.art_url = (st or {}).get('art')
            self.hero.set_art(art)
        playing = bool(st and st['status'] == 'Playing')
        self.b_play.set_label('\U000f03e4' if playing else '\U000f040a')
        for b, on, can in ((self.b_shuffle, st and st['shuffle'], st and st['can_shuffle']),
                           (self.b_loop, st and st['loop'] != 'None', st and st['can_loop'])):
            ctx = b.get_style_context()
            (ctx.add_class if on else ctx.remove_class)('on')
            (ctx.remove_class if can else ctx.add_class)('off')
        if st and st['loop'] == 'Track':
            self.b_loop.set_label('\U000f0458')
        else:
            self.b_loop.set_label('\U000f0456')
        if st and not self.vol_lock:
            self.vol_lock = True
            self.vol.set_value(st['volume'] * 100)
            self.vol_lock = False
        self.hero.queue_draw()
        return False

    def draw_sources(self):
        ra.clear(self.srcbox)
        if not self.players:
            self.srcbox.pack_start(ra.label(T('no sources: play something (YouTube, Spotify, MPD…)'), 'key'),
                                   False, False, 0)
        for p in self.players:
            glyph, name, _app = rm.source(p)
            b = ra.button(name, lambda p=p: self.pick(p), 'nbtn src', glyph)
            ctx = b.get_style_context()
            if p == self.player:
                ctx.add_class('sel')
                if self.pinned:
                    ctx.add_class('pin')
                    b.set_tooltip_text(T('Pinned: click again to follow the one playing'))
            self.srcbox.pack_start(b, False, False, 0)
        self.srcbox.show_all()

    def pick(self, p):
        if p == self.player and self.pinned:
            self.pinned = False       # follow the one playing again
        else:
            self.player, self.pinned = p, True
        self.draw_sources()

    def position(self):
        st = self.st or {}
        pos, at = self.pos_at
        if st.get('status') == 'Playing':
            pos += time.monotonic() - at
        return min(pos, st.get('length') or pos)

    def act(self, action, arg=None):
        if not self.player:
            return
        self.be.cmd(self.player, action, arg)
        GLib.timeout_add(250, lambda: (self.refresh_now(), False)[1])

    def refresh_now(self):
        p = self.player
        ra.run_bg(lambda: (self.be.state(p), p), lambda r: None if isinstance(r, Exception) or not r[0]
                  else self.update(self.players, r[1], r[0], self.be.art_path(r[0]['art'])))

    def seek_to(self, secs):
        self.act('seek', secs)
        self.pos_at = (secs, time.monotonic())

    def on_vol(self, s):
        if self.vol_lock or not self.player:
            return
        self.be.cmd(self.player, 'volume', s.get_value() / 100)

    def animate(self):
        if not self.get_visible():
            return True
        self.spec.queue_draw()
        self.prog.queue_draw()
        if self.spec_style == 'radial' or (self.st or {}).get('status') == 'Playing':
            self.hero.queue_draw()
        return True

    def on_key(self, w, ev):
        k = Gdk.keyval_name(ev.keyval)
        if isinstance(self.get_focus(), (Gtk.Entry, Gtk.SearchEntry)) and k not in ('Escape', 'Tab'):
            return False
        st = self.st or {}
        if k == 'space':
            self.act('toggle')
        elif k in ('Left', 'Right') and st.get('length'):
            self.seek_to(max(0, self.position() + (5 if k == 'Right' else -5)))
        elif k in ('Up', 'Down'):
            self.vol.set_value(self.vol.get_value() + (5 if k == 'Up' else -5))
        elif k in ('n', 'N'):
            self.act('next')
        elif k in ('p', 'P'):
            self.act('prev')
        elif k == 'Tab' and self.players:
            i = self.players.index(self.player) if self.player in self.players else -1
            self.pick(self.players[(i + 1) % len(self.players)])
        elif k in [str(i) for i in range(1, 8)]:
            self.set_spec(rs.STYLES[int(k) - 1])
        elif k in ('0',):
            self.set_spec('auto')
        elif k in ('e', 'E'):
            self.eq_sw.set_active(not self.eq_sw.get_active())
        else:
            return super().on_key(w, ev)
        return True


def main():
    _lock = ui.single_instance('ricemusic', toggle=True)  # noqa: F841
    GLib.set_prgname('RiceMusic')
    ra.float_rule('RiceMusic')
    w = RiceMusic()
    ui.quit_on_sigterm(w.destroy)
    w.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
