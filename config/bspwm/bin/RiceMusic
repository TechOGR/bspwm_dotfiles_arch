def load_conf():
    try:
        return json.load(open(CONF))
    except (OSError, ValueError):
        return {}


def save_conf(c):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF + '.tmp', 'w') as f:
        json.dump(c, f)
    os.replace(CONF + '.tmp', CONF)


def spectrum_style(style):
    s = load_conf().get('spectrum', 'auto')
    return rs.THEME_STYLE.get(style, 'bars') if s not in rs.STYLES else s


def mix(a, b, t):
    return tuple(a[i] + (b[i] - a[i]) * t for i in range(3))


def txt(cr, s, x, y, size, rgba, bold=False, width=None, lines=1, align='left', font=None):
    """Text in a box: wrapped to `lines`, ellipsized. -> its height."""
    from gi.repository import Pango, PangoCairo
    lay = PangoCairo.create_layout(cr)
    lay.set_font_description(Pango.FontDescription(f'{font or ui.FONT} {"Bold " if bold else ""}{size}'))
    if width:
        lay.set_width(int(width * Pango.SCALE))
        lay.set_ellipsize(Pango.EllipsizeMode.END)
        if lines > 1:
            lay.set_wrap(Pango.WrapMode.WORD_CHAR)
            lay.set_height(-lines)
        lay.set_alignment({'right': Pango.Alignment.RIGHT, 'center': Pango.Alignment.CENTER}.get(
            align, Pango.Alignment.LEFT))
    lay.set_text(s, -1)
    cr.move_to(x, y)
    cr.set_source_rgba(*rgba)
    PangoCairo.show_layout(cr, lay)
    return lay.get_pixel_size()[1]


# ═══════════════════════════════════════════════════════════ hero (cover + titles)
class Hero(Gtk.DrawingArea):
    COVER = 210

    def __init__(self, win):
        super().__init__()
        self.win = win
        self.pix = None
        self.set_size_request(-1, self.COVER + 24)
        self.connect('draw', self.draw)

    def set_art(self, path):
        pix = None
        if path:
            try:
                p = GdkPixbuf.Pixbuf.new_from_file(path)
                s = self.COVER * 2 / min(p.get_width(), p.get_height())
                p = p.scale_simple(max(1, int(p.get_width() * s)), max(1, int(p.get_height() * s)),
                                   GdkPixbuf.InterpType.BILINEAR)
                x, y = (p.get_width() - self.COVER * 2) // 2, (p.get_height() - self.COVER * 2) // 2
                pix = p.new_subpixbuf(max(0, x), max(0, y), self.COVER * 2, self.COVER * 2)
            except (GLib.Error, TypeError, ValueError):
                pix = None
        self.pix = pix
        self.queue_draw()

    def draw(self, _w, cr):
        W = self.get_allocated_width()
        w = self.win
        C = self.COVER
        x0, y0 = 6, 10
        acc = w.acc
        # radial spectrum around the cover (the radial style) / a soft glow
        if w.spec_style == 'radial':
            rs.draw(cr, 'radial', x0 - 20, y0 - 20, C + 40, C + 40, w.an, w.cols, w.t(), bands=36,
                    center=(x0 + C / 2, y0 + C / 2), radius=C / 2 + 4)
        else:
            lv = sum(w.an.frame()[0][:8]) / 8 if w.an else 0
            g = cairo.RadialGradient(x0 + C / 2, y0 + C / 2, C * 0.3, x0 + C / 2, y0 + C / 2, C * 0.75)
            g.add_color_stop_rgba(0, *acc, 0.25 + lv * 0.35)
            g.add_color_stop_rgba(1, *acc, 0)
            cr.set_source(g)
            cr.paint()
        cr.save()
        if w.spec_style == 'radial':
            cr.arc(x0 + C / 2, y0 + C / 2, C / 2, 0, 2 * math.pi)
        else:
            ui.rounded(cr, x0, y0, C, C, 22)
        cr.clip()
        if self.pix:
            cr.scale(0.5, 0.5)
            Gdk.cairo_set_source_pixbuf(cr, self.pix, x0 * 2, y0 * 2)
            cr.paint()
        else:
            g = cairo.LinearGradient(x0, y0, x0 + C, y0 + C)
            g.add_color_stop_rgb(0, *mix(w.c['bg'], acc, 0.35))
            g.add_color_stop_rgb(1, *mix(w.c['bg'], w.acc2, 0.25))
            cr.set_source(g)
            cr.paint()
            cr.restore()
            cr.save()
            ui.glyph(cr, (w.st or {}).get('source', ('\U000f075a',))[0], x0 + C / 2, y0 + C / 2, C * 0.34,
                     (*w.c['fg'], 0.85))
        cr.restore()
        if w.spec_style != 'radial':
            ui.rounded(cr, x0 + 0.5, y0 + 0.5, C - 1, C - 1, 22)
            cr.set_source_rgba(*acc, 0.6)
            cr.set_line_width(1.5)
            cr.stroke()
        # the texts
        st = w.st or {}
        tx = x0 + C + 30
        tw = W - tx - 6
        src = st.get('source')
        y = y0 + 8
        if src:
            txt(cr, f'{src[0]}  {rm.label(src).upper()}', tx, y, 9, (*acc, 1), bold=True, width=tw,
                font=f'{ui.FONT}, {ui.ICON_FONT}')
            y += 30
        title = st.get('title') or T('Nothing playing')
        y += txt(cr, title, tx, y, 20, (*w.c['fg'], 1), bold=True, width=tw, lines=2) + 6
        if st.get('artist'):
            y += txt(cr, st['artist'], tx, y, 12, (*acc, 0.95), width=tw) + 2
        if st.get('album'):
            txt(cr, st['album'], tx, y, 10, (*w.c['fg'], 0.55), width=tw)
        return True


# ═══════════════════════════════════════════════════════════ progress
class Progress(Gtk.DrawingArea):
    def __init__(self, win):
        super().__init__()
        self.win = win
        self.drag = None
        self.set_size_request(-1, 34)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                        Gdk.EventMask.POINTER_MOTION_MASK)
        self.connect('draw', self.draw)
        self.connect('button-press-event', lambda _w, e: self._at(e.x, True))
        self.connect('motion-notify-event', lambda _w, e: self.drag is not None and self._at(e.x, False))
        self.connect('button-release-event', self.release)

    def _at(self, x, start):
        W = self.get_allocated_width()
        self.drag = max(0.0, min(1.0, (x - 50) / max(1, W - 100)))
        self.queue_draw()
        return True

    def release(self, *_):
        if self.drag is not None and self.win.st and self.win.st.get('length'):
            self.win.seek_to(self.drag * self.win.st['length'])
        self.drag = None
        return True

    def draw(self, _w, cr):
        W, H = self.get_allocated_width(), self.get_allocated_height()
        w = self.win
        st = w.st or {}
        length = st.get('length') or 0
        pos = w.position()
        f = self.drag if self.drag is not None else (pos / length if length else 0)
        x, y, bw = 50, H / 2 - 3, W - 100
        ui.level_bar(cr, w.style, x, y, bw, 6, f, w.pal) if w.style else None
        if not w.style:
            ui.rounded(cr, x, y, bw, 6, 3)
            cr.set_source_rgba(*w.c['fg'], 0.12)
            cr.fill()
            ui.rounded(cr, x, y, bw * f, 6, 3)
            cr.set_source_rgba(*w.acc, 1)
            cr.fill()
        txt(cr, rm.fmt_time(f * length if self.drag is not None else pos), 0, H / 2 - 8, 9,
            (*w.c['fg'], 0.7), width=42, align='right')
        txt(cr, rm.fmt_time(length) if length else '--:--', W - 42, H / 2 - 8, 9, (*w.c['fg'], 0.7), width=42)
        return True


# ═══════════════════════════════════════════════════════════ spectrum
class Spectrum(Gtk.DrawingArea):
    def __init__(self, win, height=190):
        super().__init__()
        self.win = win
        self.set_size_request(-1, height)
        self.connect('draw', self.draw)

    def draw(self, _w, cr):
        W, H = self.get_allocated_width(), self.get_allocated_height()
        w = self.win
        style = w.spec_style
        if style == 'radial':      # the radial one is around the cover: here the terrain under it
            style = 'terrain'
        rs.draw(cr, style, 4, 4, W - 8, H - 8, w.an, w.cols, w.t(), bands=56 if style != 'wave' else None)
        return True


# ═══════════════════════════════════════════════════════════ the window
class RiceMusic(ra.CenterWindow):
    def __init__(self):
        super().__init__('RiceMusic', T('Music'), '\U000f075a', (1240, 800))
        self.be = rm.Backend()
        self.players, self.player, self.pinned, self.st = None, None, False, None
        self.pos_at = (0.0, time.monotonic())
        self.art_url = None
        self.t0 = time.monotonic()
        # RICE_SPECTRUM_DEVICE: another monitor to listen to (tests: a silent null sink)
        self.an = rs.Analyzer(bands=64, device=os.environ.get('RICE_SPECTRUM_DEVICE', '@DEFAULT_MONITOR@')).start()
        self.spec_style = spectrum_style(self.style)
        self.cols = [mix(self.acc2, self.c['bg'], 0.15), self.acc, mix(self.acc, (1, 1, 1), 0.5)]
        self.eq = riceeq.load()
        self.eq_timer = None
        self.install_extra_css()
        self.subtitle.set_text(T('Space play · ←→ seek · ↑↓ volume · N/P next/prev · Tab source · 1-7 spectrum · '
                                 'E equalizer · Esc close'))
        self.srcbox = Gtk.Box(spacing=8)
        self.head_right.pack_start(self.srcbox, False, False, 0)

        # ── left: now playing + spectrum
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        now = ra.section(T('Music'), '\U000f0387')
        self.hero = Hero(self)
        now.pack_start(self.hero, False, False, 0)
        self.prog = Progress(self)
        now.pack_start(self.prog, False, False, 0)
        ctl = Gtk.Box(spacing=12)
        ctl.set_halign(Gtk.Align.CENTER)
        self.b_shuffle = self.ctl('\U000f049d', lambda: self.act('shuffle'))
        self.b_prev = self.ctl('\U000f04ae', lambda: self.act('prev'))
        self.b_play = self.ctl('\U000f040a', lambda: self.act('toggle'), 'big')
        self.b_next = self.ctl('\U000f04ad', lambda: self.act('next'))
        self.b_loop = self.ctl('\U000f0456', lambda: self.act('loop', (self.st or {}).get('loop')))
        for b in (self.b_shuffle, self.b_prev, self.b_play, self.b_next, self.b_loop):
            ctl.pack_start(b, False, False, 0)
        vol = Gtk.Box(spacing=10)
        vol.pack_start(ra.label('\U000f057e', 'sglyph'), False, False, 0)
        self.vol = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.vol.set_draw_value(False)
        self.vol.set_size_request(200, -1)
        self.vol_lock = False
        self.vol.connect('value-changed', self.on_vol)
        vol.pack_start(self.vol, True, True, 0)
        ctl.pack_start(Gtk.Box(), False, False, 12)
        ctl.pack_start(vol, False, False, 0)
        now.pack_start(ctl, False, False, 4)
        left.pack_start(now, False, False, 0)

        spec = ra.section(T('Spectrum'), '\U000f147d')
        self.style_btns = {}
        chips = Gtk.Box(spacing=6)
        chips.set_halign(Gtk.Align.END)
        for i, s in enumerate(['auto'] + rs.STYLES):
            name = T('automatic') if s == 'auto' else rs.STYLE_NAMES[s][1 if ES else 0]
            b = ra.button(name, lambda s=s: self.set_spec(s), 'nbtn chipbtn')
            b.set_tooltip_text(f'{i}' if i else '')
            chips.pack_start(b, False, False, 0)
            self.style_btns[s] = b
        spec.head.pack_start(Gtk.Box(), True, True, 0)
        spec.head.pack_start(chips, False, False, 0)
        self.spec = Spectrum(self)
        spec.pack_start(self.spec, True, True, 0)
        left.pack_start(spec, True, True, 0)
        self.body.pack_start(left, True, True, 0)

        # ── right: equalizer / library
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        right.set_size_request(420, -1)
        tabs = Gtk.Box(spacing=8)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.tab_btns = {}
        for key, glyph, title in (('eq', '\U000f0ea2', T('Equalizer')), ('lib', '\U000f0cb8', T('Library'))):
            b = ra.button(title, lambda k=key: self.show_tab(k), 'nbtn tab', glyph)
            tabs.pack_start(b, True, True, 0)
            self.tab_btns[key] = b
        right.pack_start(tabs, False, False, 0)
        self.stack.add_named(self.build_eq(), 'eq')
        self.stack.add_named(self.build_lib(), 'lib')
        right.pack_start(self.stack, True, True, 0)
        self.body.pack_start(right, False, False, 0)

        self.mark_spec()
        GLib.idle_add(lambda: (self.show_tab(load_conf().get('tab', 'eq')), False)[1])
        threading.Thread(target=self.poll_loop, daemon=True).start()
        GLib.timeout_add(1000 // 30, self.animate)
        self.connect('destroy', lambda *_: self.an.stop())

    # ── look
    def install_extra_css(self):
        css = Gtk.CssProvider()
        css.load_from_data(b'''
button.ctl { min-width: 44px; min-height: 44px; border-radius: 22px; padding: 0; }
button.ctl label { font-family: "Material Design Icons Desktop"; font-size: 18pt; }
button.ctl.big { min-width: 64px; min-height: 64px; border-radius: 32px; background-color: alpha(@acc, 0.3);
    border-color: @acc; }
button.ctl.big label { font-size: 26pt; }
button.ctl.on { border-color: @acc; color: @acc; }
button.ctl.on label { color: @acc; }
button.ctl.off { opacity: 0.35; }
button.chipbtn { padding: 3px 10px; border-radius: 10px; }
button.chipbtn label { font-size: 8pt; }
button.chipbtn.sel, button.tab.sel { background-color: alpha(@acc, 0.25); border-color: @acc; }
button.src { padding: 4px 12px; border-radius: 14px; }
button.src.sel { background-color: alpha(@acc, 0.25); border-color: @acc; }
button.src.pin { border-width: 2px; }
scale.eq trough { min-width: 6px; background-color: alpha(@fg, 0.12); border-radius: 3px; border: none; }
scale.eq highlight { background-image: none; background-color: @acc; border-radius: 3px; }
scale.eq slider { min-width: 18px; min-height: 18px; border-radius: 9px; background-image: none;
    background-color: @fg; border: 2px solid @acc; box-shadow: 0 0 6px alpha(@acc, 0.6); }
scale trough { background-color: alpha(@fg, 0.12); border: none; border-radius: 3px; min-height: 5px; }
scale highlight { background-image: none; background-color: @acc; border-radius: 3px; }
scale slider { background-image: none; background-color: @fg; border: 2px solid @acc; border-radius: 9px;
    min-width: 14px; min-height: 14px; }
.eqlabel { font-size: 7pt; color: alpha(@fg, 0.6); }
.eqval { font-size: 7pt; font-weight: 800; color: @acc; }
