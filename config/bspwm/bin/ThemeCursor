FALLBACK = 'Bibata-Modern-Classic'
SIZE = 24          # default nominal size (--size)
ANIMS = ('full', 'calm', 'off')
KEEP = 4            # cursor themes kept in ~/.icons (switching back is instant)
TAU = 2 * math.pi
PI = math.pi

