def glow_amount(kit, t):
    if STYLES[kit].get('glowfn'):
        return STYLES[kit]['glowfn'](t)
    if kit == 'neon':
        return neon_flicker(t)
    if kit == 'storm':
        return 0.6 + 0.4 * storm_flash(t)
    return 0.75 + 0.25 * pulse(t)


# ═══════════════════════════════════════════════════════════ drawing
def draw_shape(cr, kit, st, P, shape, t):
    path = SHAPES[shape]
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    cr.set_fill_rule(cairo.FILL_RULE_WINDING)
    oc = P[st['outline']] if st['outline'] else P['bg']
    ow = st['ow'] or 0.7
    # soft shadow
    cr.save()
    cr.translate(0.5, 1.1)
    path(cr, t)
    cr.set_line_width(ow * 2 + 1.0)
    src(cr, (0, 0, 0), 0.28)
    cr.stroke_preserve()
    cr.fill()
    cr.restore()
    # glow
    if st['glow']:
        g = glow_amount(kit, t)
        for w, a in ((4.6, 0.10), (3.0, 0.20)):
            path(cr, t)
            cr.set_line_width(ow * 2 + w)
            src(cr, P[st['glow']], a * g)
            cr.stroke()
    # outline under the fill: only the outer edge shows (a light outline
    # gets a dark rim so it still reads over white pages)
    if st['outline'] and lum(oc) > 0.5:
        path(cr, t)
        cr.set_line_width(ow * 2 + 1.1)
        src(cr, P['bg'], 0.75)
        cr.stroke()
    if st['outline']:
        path(cr, t)
        cr.set_line_width(ow * 2)
        src(cr, oc)
        cr.stroke()
    cr.save()
    path(cr, t)
    cr.clip()
    if shape == 'forbid':
        src(cr, P['red'])
        cr.paint()
    else:
        st['fill'](cr, t, P)
    cr.restore()
    if st['outline'] and st['outline'] != 'bg':
        # a thin inner line in the outline color keeps the edge crisp
        path(cr, t)
        cr.set_line_width(0.45)
        src(cr, oc, 0.9)
        cr.stroke()
    if st.get('extra'):
        st['extra'](cr, t, P, shape, path)


def draw_spinner(cr, st, P, cx, cy, r, t, bgdisc=True):
    acc, acc2 = P[st['acc']], P[st['acc2']]
    kind = st.get('spinner', 'arc')
    if bgdisc:
        cr.arc(cx, cy, r + r * 0.42, 0, TAU)
        src(cr, (0, 0, 0), 0.25)
        cr.fill()
        cr.arc(cx, cy, r + r * 0.32, 0, TAU)
        src(cr, P['bg'], 0.85)
        cr.fill()
    if kind == 'blocks':
        n = 8
        for i in range(n):
            a = TAU * i / n
            on = ((i - t * n) % n) / n
            s = r * 0.42
            src(cr, mix(acc2, acc, on), 0.25 + 0.75 * on)
            cr.rectangle(round(cx + math.cos(a) * r * 0.85 - s / 2), round(cy + math.sin(a) * r * 0.85 - s / 2),
                         s, s)
            cr.fill()
        return
    if kind == 'ticks':
        n = 12
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_width(r * 0.2)
        for i in range(n):
            a = TAU * i / n
            on = 1 - ((t * n - i) % n) / n
            src(cr, mix(acc2, acc, on), 0.2 + 0.8 * on)
            cr.move_to(cx + math.cos(a) * r * 0.5, cy + math.sin(a) * r * 0.5)
            cr.line_to(cx + math.cos(a) * r, cy + math.sin(a) * r)
            cr.stroke()
        return
    w = r * 0.32
    cr.set_line_width(w)
    cr.arc(cx, cy, r * 0.8, 0, TAU)
    src(cr, acc2, 0.22)
    cr.stroke()
    a0 = TAU * t
    span = math.pi * (0.9 + 0.5 * math.sin(TAU * t))
    seg = 24
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    for i in range(seg):
        f = i / seg
        a = a0 - span * (1 - f)
        cr.arc(cx, cy, r * 0.8, a, a + span / seg + 0.02)
        src(cr, mix(acc2, acc, f), 0.15 + 0.85 * f)
        cr.stroke()
    cr.arc(cx + math.cos(a0) * r * 0.8, cy + math.sin(a0) * r * 0.8, w * 0.75, 0, TAU)
    src(cr, mix(acc, (1, 1, 1), 0.5))
    cr.fill()
    cr.arc(cx, cy, r * 0.22 * (0.6 + 0.4 * pulse(t, 2)), 0, TAU)
    src(cr, acc)
    cr.fill()


def draw_help(cr, st, P, t):
    """A bouncing "?" badge next to the pointer."""
    y = 23.5 - 2.0 * abs(math.sin(TAU * t))
    cr.arc(24, y + 0.8, 5.4, 0, TAU)
    src(cr, (0, 0, 0), 0.3)
    cr.fill()
    cr.arc(24, y, 5.2, 0, TAU)
    src(cr, P['bg'])
    cr.fill()
    cr.arc(24, y, 4.3, 0, TAU)
    acc = P[st['acc']]
    src(cr, acc)
    cr.fill()
    cr.select_font_face('Sans', cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(7)
    ext = cr.text_extents('?')
    cr.move_to(24 - ext.x_advance / 2, y + ext.height / 2)
    src(cr, P['bg'] if lum(acc) > 0.45 else (1, 1, 1))
    cr.show_text('?')


def render(kit, shape, size, t, P):
    st = STYLES[kit]
    pixel = st.get('pixel')
    s = size // 2 if pixel else size
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, s, s)
    cr = cairo.Context(surf)
    if pixel:
        cr.set_antialias(cairo.ANTIALIAS_NONE)
    cr.scale(s / 32, s / 32)
    if shape == 'wait':
        draw_spinner(cr, st, P, 16, 16, 9.5, t)
    else:
        draw_shape(cr, kit, st, P, shape, t)
        if shape == 'progress':
            draw_spinner(cr, st, P, 24.5, 24.5, 4.6, t)
        elif shape == 'help':
            draw_help(cr, st, P, t)
    surf.flush()
    if not pixel:
        return surf
    big = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    c2 = cairo.Context(big)
    c2.scale(size / s, size / s)
    c2.set_source_surface(surf, 0, 0)
    c2.get_source().set_filter(cairo.FILTER_NEAREST)
    c2.paint()
    big.flush()
    return big


# ═══════════════════════════════════════════════════════════ xcursor
def xcursor(frames):
    """frames: [(nominal, surface, xhot, yhot, delay)] -> Xcursor file bytes."""
    n = len(frames)
    head = struct.pack('<4sIII', b'Xcur', 16, 0x10000, n)
    toc, chunks = b'', b''
    pos = 16 + n * 12
    for nominal, surf, xh, yh, delay in frames:
        w, h = surf.get_width(), surf.get_height()
        stride = surf.get_stride()
        data = bytes(surf.get_data())
        if stride != w * 4:
            data = b''.join(data[y * stride:y * stride + w * 4] for y in range(h))
        if sys.byteorder != 'little':      # cairo is native endian, Xcursor little endian
            data = b''.join(data[i:i + 4][::-1] for i in range(0, len(data), 4))
        chunk = struct.pack('<IIIIIIIII', 36, 0xfffd0002, nominal, 1, w, h,
                            min(xh, w - 1), min(yh, h - 1), delay) + data
        toc += struct.pack('<III', 0xfffd0002, nominal, pos)
        chunks += chunk
        pos += len(chunk)
    return head + toc + chunks


def timing(st, shape, anim='full'):
    """(frames, delay ms) of a cursor: calm is slower, off is still."""
    n, d = st.get('frames', 32), st.get('delay', 55)
    if shape == 'wait':
        n, d = (12, 80) if st.get('spinner') == 'blocks' else (24, 40)
    elif anim == 'off' and shape not in ALWAYS:
        return 1, d
    return n, int(d * 1.8) if anim == 'calm' else d


def build(kit, P, dest, size=SIZE, anim='full'):
    st = STYLES[kit]
    cur = os.path.join(dest, 'cursors')
    os.makedirs(cur, exist_ok=True)
    for shape, names in NAMES.items():
        hx, hy = HOT.get(shape, (16, 16))
        n, d = timing(st, shape, anim)
        frames = []
        for i in range(n):
            surf = render(kit, shape, size, i / n, P)
            frames.append((size, surf, round(hx * size / 32), round(hy * size / 32), d))
        with open(os.path.join(cur, names[0]), 'wb') as f:
            f.write(xcursor(frames))
        for alias in names[1:]:
            os.symlink(names[0], os.path.join(cur, alias))
    with open(os.path.join(dest, 'index.theme'), 'w') as f:
        f.write(f'[Icon Theme]\nName={os.path.basename(dest)}\n'
                f'Comment=Animated cursor of the {kit} rice theme (bin/ThemeCursor)\nInherits={FALLBACK}\n')


def sheet(out):
    """A preview of every theme (ThemeCursor --sheet out.png)."""
    shapes = ['arrow', 'hand', 'text', 'help', 'wait', 'progress', 'cross', 'forbid', 'move', 'ew', 'nwse']
    S = 64
    kits = list(STYLES)
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, S * len(shapes) + 110, S * len(kits) * 2)
    cr = cairo.Context(surf)
    cr.set_source_rgb(0.5, 0.5, 0.52)
    cr.paint()
    for r, kit in enumerate(kits):
        pal = palette_of(kit)
        for half, bgc in enumerate(((0.13, 0.13, 0.15), (0.92, 0.92, 0.94))):
            y = (r * 2 + half) * S
            cr.set_source_rgb(*bgc)
            cr.rectangle(0, y, surf.get_width(), S)
            cr.fill()
            cr.set_source_rgb(*(1 - c for c in bgc))
            cr.move_to(6, y + S / 2)
            cr.show_text(kit)
            for i, shape in enumerate(shapes):
                img = render(kit, shape, S, 0.13 if half else 0.03, pal)
                cr.set_source_surface(img, 110 + i * S, y)
                cr.paint()
    surf.write_to_png(out)


def main():
    args = sys.argv[1:]
    if args[:1] == ['--sheet']:
        sheet(args[1] if len(args) > 1 else 'cursor-sheet.png')
        return
    if not args:
        sys.exit('usage: ThemeCursor <style> [--size N] [--anim full|calm|off] [key=#rrggbb ...]')
    kit = args[0] if args[0] in STYLES else 'minimal'
    P = palette_of(kit)   # the given colors (the palette in use) win
    given = {}
    size, anim = SIZE, 'full'
    rest = iter(args[1:])
    for a in rest:
        if a == '--size':
            try:
                size = max(16, min(128, int(next(rest, SIZE))))
            except ValueError:
                pass
            continue
        if a == '--anim':
            v = next(rest, 'full')
            anim = v if v in ANIMS else 'full'
            continue
        k, _, v = a.partition('=')
        if k in P and len(v.lstrip('#')) == 6:
            given[k] = v
            P[k] = rgb(v)
    with open(os.path.abspath(__file__), 'rb') as f:
        code = f.read()
    tag = hashlib.md5(code + repr((kit, sorted(given.items()), size, anim)).encode()).hexdigest()[:8]
    name = f'{PREFIX}{kit}-{tag}'
    dest = os.path.join(ICONS, name)
    if not os.path.exists(os.path.join(dest, 'index.theme')):
        tmp = dest + '.tmp'
        shutil.rmtree(tmp, ignore_errors=True)
        build(kit, P, tmp, size, anim)
        shutil.rmtree(dest, ignore_errors=True)
        os.replace(tmp, dest)
    os.utime(dest)
    # keep only the newest few
    old = sorted((d for d in glob.glob(os.path.join(ICONS, PREFIX + '*')) if d != dest),
                 key=os.path.getmtime, reverse=True)
    for d in old[KEEP - 1:]:
        shutil.rmtree(d, ignore_errors=True)
    print(name)


if __name__ == '__main__':
    main()
