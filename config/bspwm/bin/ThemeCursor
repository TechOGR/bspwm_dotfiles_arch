PAL_KEYS = ('bg', 'fg', 'black', 'blackb', 'red', 'green', 'yellow', 'blue', 'magenta', 'cyan')


def palette_of(kit):
    """The style's own palette (lib/ricekit.py or EXTRA) as rgb tuples."""
    pal = dict(DEFAULT_PAL)
    if kit in EXTRA:
        pal.update(zip(PAL_KEYS, EXTRA[kit][2].split()))
        return {k: rgb(v) for k, v in pal.items()}
    try:
        sys.path.insert(0, os.path.join(HOME, '.config/bspwm/lib'))
        import ricekit
        pal.update({k: v for k, v in ricekit.palette(kit).items() if k in pal})
    except Exception:
        pass
    return {k: rgb(v) for k, v in pal.items()}


