#!/bin/sh
# =============================================================
# Script Name: MonitorSetup
# Description: Dynamic multi-monitor configuration for bspwm using xrandr
# Features:
#   - Auto-detect connected monitors (up to 4 laid out, more are left alone)
#   - Respects an already-configured primary monitor (nvidia-settings,
#     xorg.conf, or a manual `xrandr --primary`), falling back to the
#     first detected output if none is set
#   - Resolution: the monitor's PREFERRED mode (the "+" in xrandr: native
#     panel size, or the VM window size with VMware/VirtualBox/QEMU guest
#     tools), then the current one, then the biggest listed
#   - Optional per-output override in ~/.config/bspwm/config/monitors.conf
#   - Only one xrandr probe, and no modeset at all when the screen is
#     already the way we want it (no black flash at login)
#   - Dynamic workspace assignment
#   - `MonitorSetup --check`: exit 1 when a screen is not in its wanted mode
#
#   monitors.conf (optional, one line per output, "*" = any output;
#   written by RiceEditor -> Display):
#       # OUTPUT     MODE        [RATE] [xrandr options...]
#       Virtual-1    1600x900
#       HDMI-1       2560x1440   144    --rotate left --right-of eDP-1
#       DP-1         -           -      --off
#       *            1920x1080
#   MODE/RATE "-" = keep the automatic choice. The options go straight
#   to xrandr (--rotate --reflect --scale --brightness --gamma --pos
#   --left-of ... --off); --primary picks the primary output. A saved
#   placement replaces the automatic layout below while its reference
#   output is connected. Global lines:
#       @mode   OUTPUT W H RATE   custom mode (cvt), made before the probe
#       @dpms   SECONDS | off     screen power off after idle
#       @dpi    96                Xft.dpi (xsettingsd is set by RiceEditor)
#
# Author: TechOGR
# Repo:   https://github.com/TechOGR/bspwm_dotfiles_arch
# Date:   24.04.2025
#
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

OVERRIDES="$HOME/.config/bspwm/config/monitors.conf"
ACTION=${1:-}   # "" or --check (the positional args are reused below)

# Custom modes first, so the probe below lists them
grep -E '^[[:space:]]*@mode[[:space:]]' "$OVERRIDES" 2>/dev/null |
while read -r _ out w h r _; do
    set -- $(cvt "$w" "$h" "${r:-60}" 2>/dev/null | sed -n 's/^Modeline //p' | tr -d '"')
    [ $# -gt 1 ] || continue
    xrandr --newmode "$@" 2>/dev/null   # fails harmlessly when it exists
    xrandr --addmode "$out" "$1" 2>/dev/null
done

# One probe; everything below reads this cached copy
XRANDR_OUTPUT=$(xrandr --query 2>/dev/null)
[ -n "$XRANDR_OUTPUT" ] || { echo "MonitorSetup: xrandr failed" >&2; exit 1; }

# Per connected output, one line:
#   name primary(0/1) current_mode current_x current_y wanted_mode wanted_rate extra
# (current_mode is the "*" mode, "-" when the output is off)
# wanted = override > preferred ("+") > current ("*") > first listed mode
# (xrandr lists the biggest first). The rate is the one carrying the
# marker on that mode's line, else the first one. extra = the saved
# xrandr options joined with commas ("-" = none).
MONITORS=$(printf '%s\n' "$XRANDR_OUTPUT" | awk -v ovf="$OVERRIDES" '
    BEGIN {
        while ((getline l < ovf) > 0) {
            sub(/#.*/, "", l); n = split(l, f, " ")
            if (n < 2 || f[1] ~ /^@/) continue
            omode[f[1]] = f[2]; orate[f[1]] = (n >= 3 ? f[3] : "-"); x = ""
            for (i = 4; i <= n; i++) {
                if (f[i] == "--primary") { cprim = f[1]; continue }
                x = x (x == "" ? "" : ",") f[i]
            }
            oextra[f[1]] = x
        }
    }
    function flush() {
        if (name == "") return
        if (cprim != "") primary = (name == cprim) ? 1 : 0
        m = pmode; r = prate; x = ""
        if (m == "") { m = cmode; r = crate }
        if (m == "") { m = fmode; r = frate }
        k = (name in omode) ? name : (("*" in omode) ? "*" : "")
        if (k != "") {
            if (omode[k] != "-") { m = omode[k]; r = (orate[k] == "-" ? "" : orate[k]) }
            x = oextra[k]
        }
        print name, primary, (cur == "" || cmode == "" ? "-" : cmode), cx + 0, cy + 0, (m == "" ? "-" : m), (r == "" ? "-" : r), (x == "" ? "-" : x)
        name = ""
    }
    /^[^ \t]/ {
        flush()
        if ($2 != "connected") next
        name = $1; primary = ($3 == "primary") ? 1 : 0
        geo = (primary ? $4 : $3); cur = ""; cx = cy = 0
        if (geo ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {
            split(geo, g, "+"); cur = g[1]; cx = g[2]; cy = g[3]
        }
        pmode = prate = cmode = crate = fmode = frate = ""
        next
    }
    name != "" && $1 ~ /^[0-9]+x[0-9]+/ {
        mode = $1; first = ""; pr = ""; cr = ""
        for (i = 2; i <= NF; i++) {
            t = $i
            if (t == "+") { pr = prev; continue }
            if (t == "*") { cr = prev; continue }
            if (t == "*+" || t == "+*") { pr = cr = prev; continue }
            rate = t; gsub(/[*+]/, "", rate)
            if (first == "") first = rate
            if (index(t, "+")) pr = rate
            if (index(t, "*")) cr = rate
            prev = rate
        }
        if (fmode == "") { fmode = mode; frate = first }
        if (pr != "" && pmode == "") { pmode = mode; prate = pr }
        if (cr != "" && cmode == "") { cmode = mode; crate = cr }
    }
    END { flush() }
')

# Outputs that are gone but still hold a CRTC (e.g. an unplugged screen).
# Checking the geometry first avoids one xrandr call per empty VM output.
OFF_ARGS=$(printf '%s\n' "$XRANDR_OUTPUT" |
    awk '$2 == "disconnected" && $3 ~ /^[0-9]+x[0-9]+\+/ { printf "--output %s --off ", $1 }')

# Screens switched off in monitors.conf (never all of them)
is_off='$8 ~ /(^|,)--off(,|$)/'
if printf '%s\n' "$MONITORS" | awk "NF && !($is_off) { f = 1 } END { exit !f }"; then
    for o in $(printf '%s\n' "$MONITORS" | awk "NF && $is_off { print \$1 }"); do
        OFF_ARGS="$OFF_ARGS--output $o --off "
    done
    MONITORS=$(printf '%s\n' "$MONITORS" | awk "NF && !($is_off)")
fi

# Put the primary output first, keep xrandr order for the rest
MONITORS=$(printf '%s\n' "$MONITORS" | awk 'NF { if ($2 == 1) print; else rest = rest $0 "\n" } END { printf "%s", rest }')
set -- $(printf '%s\n' "$MONITORS" | awk 'NF { print $1 }')
NUM_MONITORS=$#

field() {   # field <output> <n>
    printf '%s\n' "$MONITORS" | awk -v m="$1" -v n="$2" '$1 == m { print $n; exit }'
}

# --check: exit 0 when every screen already runs its wanted mode, so
# ScreenWatch only re-applies what something else (VM autofit) changed
if [ "$ACTION" = --check ]; then
    printf '%s\n' "$MONITORS" | awk 'NF && $6 != "-" && $3 != $6 { bad = 1 } END { exit bad }'
    exit
fi

PLACE_RE='--(pos|left-of|right-of|above|below|same-as) [^ ]+'

# xrandr arguments for one output: mode/rate + placement + saved options
out_args() {   # out_args <output> <placement...>
    mon=$1; shift
    mode=$(field "$mon" 6); rate=$(field "$mon" 7)
    extra=$(field "$mon" 8 | tr ',' ' ' | sed -E 's/(^| )--off( |$)/ /')
    [ "$extra" = "-" ] && extra=""
    a="--output $mon"
    if [ "$mode" = "-" ]; then a="$a --auto"; else a="$a --mode $mode"; fi
    [ "$rate" != "-" ] && a="$a --rate $rate"
    place="$*"
    if printf '%s\n' "$extra" | grep -Eq -- "$PLACE_RE"; then
        # the saved placement wins, unless it points at a screen that is gone
        ref=$(printf '%s\n' "$extra" | grep -Eo -- "$PLACE_RE" | awk '$1 != "--pos" { print $2 }')
        if [ -n "$ref" ] && [ "$(field "$ref" 1)" != "$ref" ] || [ "$ref" = "$mon" ]; then
            extra=$(printf '%s\n' "$extra" | sed -E "s/$PLACE_RE//g")
        else
            place=$(printf '%s\n' "$place" | sed -E "s/$PLACE_RE//g")
        fi
    fi
    echo "$a $place $extra"
}

# Nothing to do when a single screen is already primary, at 0,0, in the
# wanted mode (a modeset makes the screen flash and bspwm re-layout).
already_ok() {
    [ "$NUM_MONITORS" -eq 1 ] && [ -z "$OFF_ARGS" ] && [ "$(field "$1" 8)" = "-" ] || return 1
    [ "$(field "$1" 2)" = 1 ] && [ "$(field "$1" 3)" = "$(field "$1" 6)" ] &&
        [ "$(field "$1" 4)" = 0 ] && [ "$(field "$1" 5)" = 0 ]
}

case $NUM_MONITORS in
    0)
        echo "Warning: No connected monitors detected"
        ;;

    1)
        already_ok "$1" || xrandr $OFF_ARGS $(out_args "$1" --primary --pos 0x0)
        bspc monitor "$1" -d 1 2 3 4 5 6
        ;;

    2)
        xrandr $OFF_ARGS $(out_args "$1" --primary --pos 0x0) \
               $(out_args "$2" --right-of "$1")
        bspc monitor "$1" -d 1 2 3 4
        bspc monitor "$2" -d 5 6 7 8
        bspc wm -O "$1" "$2"
        ;;

    3)
        xrandr $OFF_ARGS $(out_args "$1" --primary --pos 0x0) \
               $(out_args "$2" --left-of "$1") \
               $(out_args "$3" --right-of "$1")
        bspc monitor "$1" -d 1 2 3
        bspc monitor "$2" -d 4 5 6
        bspc monitor "$3" -d 7 8 9
        bspc wm -O "$1" "$2" "$3"
        ;;

    4)
        xrandr $OFF_ARGS $(out_args "$1" --primary --pos 0x0) \
               $(out_args "$2" --left-of "$1") \
               $(out_args "$3" --right-of "$1") \
               $(out_args "$4" --above "$1")
        bspc monitor "$1" -d 1 2 3
        bspc monitor "$2" -d 4 5
        bspc monitor "$3" -d 6 7
        bspc monitor "$4" -d 8 9
        bspc wm -O "$1" "$2" "$3" "$4"
        ;;

    *)
        echo "Warning: Configuration not supported for more than 4 monitors"
        ;;
esac

# Screen power / DPI (RiceEditor -> Display). Idle LOCK is BetterLock's
# job (xset s + xss-lock); this is only when the monitor powers off.
grep -E '^[[:space:]]*@(dpms|dpi)[[:space:]]' "$OVERRIDES" 2>/dev/null |
while read -r key val _; do
    case $key in
        @dpms)
            if [ "$val" = off ] || [ "$val" = 0 ]; then xset -dpms
            else xset +dpms dpms "$val" "$val" "$val"; fi ;;
        @dpi)
            printf 'Xft.dpi: %s\n' "$val" | xrdb -merge ;;
    esac
done
