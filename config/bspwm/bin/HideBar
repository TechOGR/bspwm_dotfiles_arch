#!/bin/sh
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
# Date:    03.02.2025 20:31:58
#
# HideBar - Hide polybar or eww bars for TechOGR dotfiles
# Dependencies:
#   → bspwm, polybar, eww
#
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

# Configuration
read -r current_rice <"$HOME"/.config/bspwm/.rice
THEME_CONFIG="$HOME/.config/bspwm/rices/$current_rice/theme-config.bash"
eww_bar_path="$HOME/.config/bspwm/rices/$current_rice/bar"

# Get padding value from theme-config.bash
get_paddings() {
    awk -F'"' '
        /^TOP_PADDING/    { top = $2 }
        /^BOTTOM_PADDING/ { bottom = $2 }
        /^LEFT_PADDING/   { left = $2 }
        /^RIGHT_PADDING/  { right = $2 }
        END { print top, bottom, left, right }
    ' "$THEME_CONFIG"
}

set_padding() {
    bspc config top_padding "$1"
    # the dock keeps its own reserve at the bottom (it re-applies it itself)
    pgrep -f '^python3 .*/bin/Dock$' >/dev/null || bspc config bottom_padding "$2"
    bspc config left_padding "$3"
    bspc config right_padding "$4"
}

is_eww_theme() {
    [ "$current_rice" = "z0mbi3" ] || [ "$current_rice" = "andrea" ]
}

toggle_bar() {
    local action m

    action="$1"

    if is_eww_theme; then
        if [ "$action" = "hide" ]; then
            eww -c "$eww_bar_path" close-all
        else
            for m in $(bspc query -M --names); do
                eww -c "$eww_bar_path" open bar --id "$m" --arg monitor="$m"
            done
        fi
    else
        polybar-msg cmd "$action"
    fi
}

toggle_bars() {
    if [ "$1" = "hide" ]; then
        set_padding 2 2 2 2
        toggle_bar hide
    else
        set_padding $(get_paddings)
        toggle_bar show
    fi
}

# With auto-hide on (RiceEditor -> Polybar) the BarCtl daemon owns the
# bar: -u pins it visible over the windows, -h lets it hide again.
if ! is_eww_theme && "$HOME"/.config/bspwm/bin/BarCtl autohide 2>/dev/null; then
    case "$1" in
        -h|--hide)   exec "$HOME"/.config/bspwm/bin/BarCtl unpin ;;
        -u|--unhide) exec "$HOME"/.config/bspwm/bin/BarCtl pin ;;
    esac
fi

case "$1" in
    -h|--hide)   toggle_bars hide ;;
    -u|--unhide) toggle_bars unhide ;;
    *)	echo "Uso: $0 [-h|--hide] [-u|--unhide]" ;;
esac
