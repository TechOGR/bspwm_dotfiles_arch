#!/usr/bin/env python3
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
#
# ResizeHandles - resize any window from its borders and corners, like a
# desktop: near a border the pointer becomes the arrow of that border
# (↔ ↕ and the four diagonals at the corners) and dragging resizes the
# window (tiled windows move their split, floating ones their side).
#
# Each window gets eight invisible input-only handles just OUTSIDE its
# border (in the gap between windows), so a click inside an app is never
# taken. Input-only windows are never drawn: nothing for the compositor,
# nothing that can flicker. They follow bspwm's events (geometry, stack,
# desktops, fullscreen, monocle).
#
#   ResizeHandles              run (config/modules/01-bspwm.sh)
#   ResizeHandles --restart | --stop
#
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

import os
import sys
import json
import time
import signal
import subprocess

HOME = os.path.expanduser('~')
LOCK = os.path.join(HOME, '.cache', os.environ.get('USER', 'user'), '.resizehandles.lock')
CORNER = 22        # px a corner handle reaches along each border
MIN_W = 5          # px of the thinnest border handle
# name of the handle -> (bspc -z handle, cursor names, horizontal, vertical)
HANDLES = {
    'top': ('top', ('n-resize', 'top_side'), 0, 1),
    'bottom': ('bottom', ('s-resize', 'bottom_side'), 0, 1),
    'left': ('left', ('w-resize', 'left_side'), 1, 0),
    'right': ('right', ('e-resize', 'right_side'), 1, 0),
    'top_left': ('top_left', ('nw-resize', 'top_left_corner'), 1, 1),
    'top_right': ('top_right', ('ne-resize', 'top_right_corner'), 1, 1),
    'bottom_left': ('bottom_left', ('sw-resize', 'bottom_left_corner'), 1, 1),
    'bottom_right': ('bottom_right', ('se-resize', 'bottom_right_corner'), 1, 1),
}


def running_pid():
    try:
        pid = int(open(LOCK).read().strip() or 0)
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def cli():
    arg = sys.argv[1] if len(sys.argv) > 1 else ''
    pid = running_pid()
    if arg in ('--stop', '--restart') and pid:
        os.kill(pid, signal.SIGTERM)
        for _ in range(40):
            if running_pid() is None:
                break
            time.sleep(0.05)
    if arg == '--stop':
        sys.exit(0)
    if running_pid():
        sys.exit(0)
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    with open(LOCK, 'w') as f:
        f.write(str(os.getpid()))


def bspc(*args):
    return subprocess.run(['bspc', *args], capture_output=True, text=True).stdout.strip()


def rects(w, h, t):
    """The handles of a window of w x h (its outer border box), each as
    x, y, width, height relative to it; t = thickness outside."""
    c = CORNER
    return {
        'top': (c - t, -t, w - 2 * c + 2 * t, t),
        'bottom': (c - t, h, w - 2 * c + 2 * t, t),
        'left': (-t, c - t, t, h - 2 * c + 2 * t),
        'right': (w, c - t, t, h - 2 * c + 2 * t),
        'top_left': (-t, -t, c, c),
        'top_right': (w - c + t, -t, c, c),
        'bottom_left': (-t, h - c + t, c, c),
        'bottom_right': (w - c + t, h - c + t, c, c),
    }


def main():
    cli()
    import gi
    gi.require_version('Gdk', '3.0')
    gi.require_version('GdkX11', '3.0')
    from gi.repository import Gdk, GLib, GdkX11

    display = Gdk.Display.get_default()
    if display is None:
        sys.exit(1)
    loop = GLib.MainLoop()
    cursors = {}
    for name, (_z, names, _h, _v) in HANDLES.items():
        cur = None
        for n in names:
            cur = Gdk.Cursor.new_from_name(display, n)
            if cur:
                break
        cursors[name] = cur
    st = {'wins': {}, 'timer': None, 'drag': None, 'foreign': {}}

    def foreign(cid):
        if cid not in st['foreign']:
            try:
                st['foreign'][cid] = GdkX11.X11Window.foreign_new_for_display(display, cid)
            except Exception:
                st['foreign'][cid] = None
        return st['foreign'][cid]

    def new_handle(name):
        attr = Gdk.WindowAttr()
        attr.window_type = Gdk.WindowType.TEMP   # override-redirect: bspwm leaves it alone
        attr.wclass = Gdk.WindowWindowClass.INPUT_ONLY
        attr.x, attr.y, attr.width, attr.height = -10, -10, 1, 1
        attr.event_mask = (Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                           Gdk.EventMask.POINTER_MOTION_MASK)
        attr.cursor = cursors[name]
        mask = Gdk.WindowAttributesType.X | Gdk.WindowAttributesType.Y
        if attr.cursor:
            mask |= Gdk.WindowAttributesType.CURSOR
        gw = Gdk.Window.new(None, attr, mask)
        gw.handle = name
        return gw

    def wanted():
        """{client id: (x, y, w, h, thickness)} of the windows that can be
        resized on the visible desktops (outer border box)."""
        out = {}
        gap = int(bspc('config', 'window_gap') or 0)
        for desk in bspc('query', '-D', '-d', '.active').split():
            try:
                tree = json.loads(bspc('query', '-T', '-d', desk) or '{}')
            except ValueError:
                continue
            monocle = tree.get('layout') == 'monocle'
            stack = [tree.get('root')]
            while stack:
                n = stack.pop()
                if not n:
                    continue
                stack += [n.get('firstChild'), n.get('secondChild')]
                cl = n.get('client')
                if not cl or n.get('hidden') or cl.get('state') == 'fullscreen':
                    continue
                floating = cl.get('state') == 'floating'
                if monocle and not floating:
                    continue   # one window filling the desktop: nothing to resize against
                r = cl['floatingRectangle'] if floating else cl['tiledRectangle']
                bw = cl.get('borderWidth', 0)
                # in the gap: half of it between two tiled windows
                t = max(MIN_W, 10 if floating else gap // 2 + 1)
                out[n['id']] = (r['x'] - bw, r['y'] - bw, r['width'] + 2 * bw, r['height'] + 2 * bw, t)
        return out

    def sync():
        st['timer'] = None
        if st['drag']:
            return False
        want = wanted()
        for cid in list(st['wins']):
            if cid not in want:
                for gw in st['wins'].pop(cid).values():
                    gw.destroy()
                st['foreign'].pop(cid, None)
        for cid, (x, y, w, h, t) in want.items():
            hs = st['wins'].get(cid)
            if hs is None:
                hs = st['wins'][cid] = {name: new_handle(name) for name in HANDLES}
            target = foreign(cid)
            for name, (hx, hy, hw, hh) in rects(w, h, t).items():
                gw = hs[name]
                if hw <= 0 or hh <= 0:
                    gw.hide()
                    continue
                gw.move_resize(int(x + hx), int(y + hy), int(hw), int(hh))
                gw.show()
                if target is not None:
                    try:
                        gw.restack(target, True)   # over its window, under anything above it
                    except Exception:
                        pass
        display.flush()
        return False

    def schedule(delay=30):
        if st['timer']:
            GLib.source_remove(st['timer'])
        st['timer'] = GLib.timeout_add(delay, sync)

    def owner(gw):
        for cid, hs in st['wins'].items():
            if gw in hs.values():
                return cid
        return None

    def on_event(ev):
        t = ev.get_event_type()
        gw = ev.get_window()
        name = getattr(gw, 'handle', None) if gw else None
        if t == Gdk.EventType.BUTTON_PRESS and name and ev.get_button()[1] == 1:
            cid = owner(gw)
            if cid:
                _ok, rx, ry = ev.get_root_coords()
                st['drag'] = {'cid': cid, 'name': name, 'x': rx, 'y': ry, 'last': 0}
                bspc('node', hex(cid), '-f')
        elif t == Gdk.EventType.MOTION_NOTIFY and st['drag']:
            d = st['drag']
            now = time.monotonic()
            if now - d['last'] < 0.012:   # ~80 resizes a second at most
                return
            _ok, rx, ry = ev.get_root_coords()
            z, _c, horiz, vert = HANDLES[d['name']]
            dx = int(rx - d['x']) if horiz else 0
            dy = int(ry - d['y']) if vert else 0
            if dx or dy:
                subprocess.run(['bspc', 'node', hex(d['cid']), '-z', z, str(dx), str(dy)],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                d['x'] += dx
                d['y'] += dy
                d['last'] = now
        elif t == Gdk.EventType.BUTTON_RELEASE and st['drag']:
            st['drag'] = None
            schedule(10)

    Gdk.event_handler_set(on_event)

    buf = {'data': b''}

    def on_bspwm(fd, _cond):
        try:
            chunk = os.read(fd, 65536)
        except BlockingIOError:
            return True
        if not chunk:
            loop.quit()
            return False
        if not st['drag']:
            schedule()
        return True

    proc = subprocess.Popen(['bspc', 'subscribe', 'node_add', 'node_remove', 'node_swap', 'node_transfer',
                             'node_stack', 'node_geometry', 'node_state', 'node_flag', 'node_layer',
                             'desktop_focus', 'desktop_layout', 'monitor_geometry'],
                            stdout=subprocess.PIPE, bufsize=0)
    fd = proc.stdout.fileno()
    os.set_blocking(fd, False)
    GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, fd, GLib.IO_IN | GLib.IO_HUP, on_bspwm)
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, lambda: (loop.quit(), False)[1])
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, lambda: (loop.quit(), False)[1])
    schedule(0)
    loop.run()
    proc.terminate()
    for hs in st['wins'].values():
        for gw in hs.values():
            gw.destroy()
    display.flush()
    try:
        if running_pid() == os.getpid():
            os.remove(LOCK)
    except OSError:
        pass


if __name__ == '__main__':
    main()
