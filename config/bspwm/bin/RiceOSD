#!/usr/bin/env python3
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
#
# RiceOSD - the on-screen display of volume, brightness, microphone and
# caffeine, in the theme's style: its scene and window frame (waves,
# lightning, tentacles, vines...), a Material icon and a level bar whose
# end is the style's own dot (a flame, an orb, a drop, a flower...).
# Without a theme style it is a plain glassy panel.
#
#   RiceOSD volume 45 | volume muted
#   RiceOSD brightness 70
#   RiceOSD mic on|off
#   RiceOSD caffeine on|off
#   RiceOSD text GLYPH "Title" ["body"]
#
# One OSD at a time: a call while it is shown only updates it (state file
# + SIGUSR1); it hides itself 1.6 s after the last update. The caller
# never waits (the OSD runs detached).
#
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

import os
import sys
import json
import time
import signal
import subprocess

HOME = os.path.expanduser('~')
BSPWM = os.path.join(HOME, '.config/bspwm')
RUN = os.environ.get('XDG_RUNTIME_DIR') or os.path.join(HOME, '.cache')
STATE = os.path.join(RUN, 'riceosd.json')
PIDF = os.path.join(RUN, 'riceosd.pid')
SHOW_S = 1.6

G = {   # Material Design Icons
    'vol_mute': '\U000f075f', 'vol_low': '\U000f057f', 'vol_mid': '\U000f0580', 'vol_high': '\U000f057e',
    'bright_low': '\U000f00dd', 'bright_mid': '\U000f00de', 'bright_high': '\U000f00e0',
    'mic': '\U000f036c', 'mic_off': '\U000f036d', 'coffee': '\U000f0176', 'coffee_off': '\U000f0faa',
    'bell': '\U000f009a',
}


def lang_es():
    try:
        sys.path.insert(0, os.path.join(BSPWM, 'lib'))
        import ricelang
        return ricelang.get_lang() == 'es'
    except Exception:
        return True


def build(args):
    """The OSD contents for a command line: icon, title, value text, level."""
    es = lang_es()
    kind = args[0] if args else ''
    val = args[1] if len(args) > 1 else ''
    if kind == 'volume':
        if val == 'muted':
            return dict(icon=G['vol_mute'], title='Volumen' if es else 'Volume', value='Mute', level=0, off=True)
        n = int(float(val or 0))
        icon = G['vol_high'] if n > 66 else G['vol_mid'] if n > 33 else G['vol_low'] if n else G['vol_mute']
        return dict(icon=icon, title='Volumen' if es else 'Volume', value=f'{n}%', level=n / 100)
    if kind == 'brightness':
        n = int(float(val or 0))
        icon = G['bright_high'] if n > 66 else G['bright_mid'] if n > 33 else G['bright_low']
        return dict(icon=icon, title='Brillo' if es else 'Brightness', value=f'{n}%', level=n / 100)
    if kind == 'mic':
        on = val != 'off'
        return dict(icon=G['mic'] if on else G['mic_off'], title='Micrófono' if es else 'Microphone',
                    value=('Activo' if es else 'Live') if on else ('Silenciado' if es else 'Muted'), off=not on)
    if kind == 'caffeine':
        on = val == 'on'
        return dict(icon=G['coffee'] if on else G['coffee_off'], title='Cafeína' if es else 'Caffeine',
                    value=('Activada' if es else 'On') if on else ('Desactivada' if es else 'Off'), off=not on)
    if kind == 'text':
        return dict(icon=val or G['bell'], title=args[2] if len(args) > 2 else '',
                    value=args[3] if len(args) > 3 else '')
    return None


def running():
    try:
        pid = int(open(PIDF).read().strip())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def client(args):
    data = build(args)
    if not data:
        print('usage: RiceOSD volume N|muted · brightness N · mic on|off · caffeine on|off',
              file=sys.stderr)
        sys.exit(2)
    data['t'] = time.time()
    tmp = STATE + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(data, f)
    os.replace(tmp, STATE)
    pid = running()
    if pid:
        os.kill(pid, signal.SIGUSR1)
    else:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), '--daemon'], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def daemon():
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, GLib
    import cairo
    sys.path.insert(0, os.path.join(BSPWM, 'lib'))
    import riceui as ui

    with open(PIDF, 'w') as f:
        f.write(str(os.getpid()))
    GLib.set_prgname('RiceOSD')
    pal = ui.load_palette()
    style = ui.theme_style()
    M = 40 if style else 12   # room for the frame's ornaments
    W, H = 380 + 2 * M, 96 + 2 * M
    st = {'data': {}, 'timer': None, 'shown': 0}

    win = Gtk.Window(type=Gtk.WindowType.POPUP)
    win.set_title('RiceOSD')
    win.set_wmclass('RiceOSD', 'RiceOSD')
    ui.rgba_window(win)
    win.set_default_size(W, H)
    win.set_size_request(W, H)
    geo = ui.monitor_geometry()
    win.move(geo.x + (geo.width - W) // 2, geo.y + geo.height - H - int(geo.height * 0.09))
    win.set_keep_above(True)
    win.set_accept_focus(False)

    def draw(_w, cr):
        d = st['data']
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        s = ui.themed_panel(cr, W, H, M, pal, radius=22, style=style, anim=ui.panel_anim(win, style=style))
        acc = ui.style_accent(s, pal) if s else ui.hex_rgb(pal['blue'])
        off = d.get('off')
        fg = ui.hex_rgb(pal['fg'])
        icol = ui.hex_rgb(pal['red']) if off else acc
        ui.glyph(cr, d.get('icon', ''), M + 50, H / 2, 26, (*icol, 1), glow=0.35)
        x0 = M + 96
        right = W - M - 28
        if 'level' in d:
            ui.text(cr, d.get('title', ''), x0, M + 20, 11, (*fg, 0.8), bold=True)
            ui.text(cr, d.get('value', ''), right, M + 18, 13, (*fg, 1), bold=True, align='right')
            ui.level_bar(cr, s, x0, M + 56, right - x0, 10, d['level'], pal)
        else:
            ui.text(cr, d.get('title', ''), x0, H / 2 - 24, 11, (*fg, 0.8), bold=True)
            ui.text(cr, d.get('value', ''), x0, H / 2 + 2, 14, (*(ui.hex_rgb(pal['red']) if off else fg), 1),
                    bold=True)
        return True

    def hide():
        st['timer'] = None
        # a call that came while hiding: show it instead of leaving
        if time.time() - st['data'].get('t', 0) < SHOW_S - 0.05:
            arm()
            return False
        try:
            os.remove(PIDF)
        except OSError:
            pass
        if not reload():   # nothing newer arrived in the meantime
            Gtk.main_quit()
        return False

    def arm():
        if st['timer']:
            GLib.source_remove(st['timer'])
        st['timer'] = GLib.timeout_add(int(SHOW_S * 1000), hide)

    def reload(*_):
        try:
            d = json.load(open(STATE))
        except (OSError, ValueError):
            return False
        if d.get('t', 0) <= st['data'].get('t', 0):
            return False
        st['data'] = d
        if not running():
            with open(PIDF, 'w') as f:
                f.write(str(os.getpid()))
        win.queue_draw()
        arm()
        return True

    win.connect('draw', draw)
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGUSR1, lambda: (reload(), True)[1])
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, lambda: (Gtk.main_quit(), False)[1])
    reload()
    win.show_all()
    win.realize()
    win.get_window().input_shape_combine_region(cairo.Region(), 0, 0)
    Gtk.main()
    if running() == os.getpid():
        os.remove(PIDF)


if __name__ == '__main__':
    if sys.argv[1:2] == ['--daemon']:
        daemon()
    else:
        client(sys.argv[1:])
