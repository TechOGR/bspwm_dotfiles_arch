#!/bin/sh
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
#
# Respawn - run a daemon of the rice and start it again if it crashes.
#
#   Respawn CMD [ARGS...]
#
# A clean exit (0: stopped with --stop / --restart, bspwm quitting,
# another instance already running) or a kill on purpose (SIGTERM,
# SIGINT, SIGKILL) ends it. Anything else (a Python error, an abort
# from GDK, a segfault) starts the daemon again after a second, the
# frames / bar decorations come back by themselves. More than 5 crashes
# in a minute: it gives up (a daemon that can't start must not loop).
# Crashes are logged to ~/.cache/$USER/respawn.log.
#
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

[ $# -gt 0 ] || { echo "usage: ${0##*/} CMD [ARGS...]" >&2; exit 2; }
LOG="$HOME/.cache/${USER:-user}/respawn.log"
mkdir -p "${LOG%/*}"
name=${1##*/}
crashes=0
since=$(date +%s)

# The daemon touches $RESPAWN_BEAT every few seconds (RoundBorders,
# WorkspacePill): if that stops for 20 s it is hung (its frames frozen on
# screen), it is killed and started again like after a crash.
BEAT="$HOME/.cache/${USER:-user}/respawn-$name.beat"
ERR="$HOME/.cache/${USER:-user}/respawn-$name.err"
export RESPAWN_BEAT="$BEAT"

while :; do
    rm -f "$BEAT"
    [ -f "$ERR" ] && [ "$(wc -c < "$ERR")" -gt 200000 ] && tail -c 100000 "$ERR" > "$ERR.tmp" && mv -f "$ERR.tmp" "$ERR"
    "$@" 2>>"$ERR" &
    pid=$!
    hung=0
    trap 'kill "$pid" 2>/dev/null; exit 0' TERM INT
    while kill -0 "$pid" 2>/dev/null; do
        sleep 5
        if [ -f "$BEAT" ] && [ $(( $(date +%s) - $(stat -c %Y "$BEAT") )) -gt 20 ]; then
            printf '%s  %s hung (no heartbeat for 20 s): killed\n' "$(date '+%F %T')" "$name" >> "$LOG"
            kill -9 "$pid" 2>/dev/null
            hung=1
        fi
    done
    wait "$pid"
    rc=$?
    if [ "$hung" = 0 ]; then
        case $rc in
            0|130|137|143) exit "$rc" ;;    # clean exit / killed on purpose
        esac
    fi
    now=$(date +%s)
    if [ $((now - since)) -gt 60 ]; then
        since=$now
        crashes=0
    fi
    crashes=$((crashes + 1))
    printf '%s  %s exited with %s (crash %s in this minute, see %s)\n' "$(date '+%F %T')" "$name" "$rc" \
        "$crashes" "$ERR" >> "$LOG"
    if [ "$crashes" -gt 5 ]; then
        printf '%s  %s: too many crashes, not restarting it\n' "$(date '+%F %T')" "$name" >> "$LOG"
        exit "$rc"
    fi
    sleep 1
done
