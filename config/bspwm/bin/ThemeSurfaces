#!/usr/bin/env python3
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
#
# ThemeSurfaces - the theme's panel (scene, reading veil, the style's
# frame with its ornaments) rendered as pictures for the menus that
# can't draw it themselves:
#   jgmenu            @icon behind the main menu (prepend.csv)
#   rofi clipboard    super + alt + c  (rofi-themes/Clipboard.rasi)
#   rofi passwords    super + alt + x  (rofi-themes/Pass.rasi)
# The rasi files import surface-*.rasi (window background-image); a
# neutral default ships with the rice, this writes the themed ones.
# Run by config/modules/06-jgmenu.sh on every theme / palette change.
#
#   ThemeSurfaces            render for the current theme
#
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR/bspwm_dotfiles_arch>
# Licensed under GPL-3.0 license
# =============================================================

import os
import sys

sys.path.insert(0, os.path.expanduser('~/.config/bspwm/lib'))
import riceui as ui  # noqa: E402
from riceui import Gdk, cairo  # noqa: E402

HOME = os.path.expanduser('~')
OUT = os.path.join(HOME, '.cache', 'rice-surfaces')
ROFI = os.path.join(HOME, '.config/bspwm/config/rofi-themes')
JG_W, JG_H = 288, 576        # jgmenu's main menu window (menu_width 273 + icon room, its items)
M = 3     # the frame right at the window's edge: picom's shadow and rounded corners (14 px, as
          # the menus' own) then hug the theme's frame instead of drawing a second border around it


def render(path, W, H, pal, style, radius=14, frame=True):
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, W, H)
    cr = cairo.Context(surf)
    ui.themed_panel(cr, W, H, M, pal, radius=radius, veil=0.66, style=style, frame=frame)
    surf.write_to_png(path + '.tmp')
    os.replace(path + '.tmp', path)


def screen_size():
    try:
        geo = Gdk.Display.get_default().get_monitor(0).get_geometry()
        return geo.width, geo.height
    except Exception:
        return 1920, 1080


def rasi(name, png, pad):
    """surface-NAME.rasi: the picture as the window's background."""
    text = (f'/* GENERATED by bin/ThemeSurfaces for the current theme -- do not edit */\n'
            f'window {{\n'
            f'    background-image: url("{png}", both);\n'
            f'    background-color: transparent;\n'
            f'    border: 0px;\n'
            f'    border-radius: 0px;\n'
            f'}}\n'
            f'mainbox {{ padding: {pad}px; }}\n')
    path = os.path.join(ROFI, f'surface-{name}.rasi')
    with open(path + '.tmp', 'w') as f:
        f.write(text)
    os.replace(path + '.tmp', path)


def main():
    os.makedirs(OUT, exist_ok=True)
    pal = ui.load_palette()
    style = ui.theme_style()
    SW, SH = screen_size()
    # jgmenu: the whole main menu, cut in square tiles (jgmenu fits an
    # @icon in a square of 256 px at most: menu.csv puts the 2 x 4 tiles
    # of 144 px back together)
    full = os.path.join(OUT, 'jgmenu.png')
    # the scene only: bin/JgMenuSkin draws the frame above the menu, with room
    # for its ornaments (inside the menu they were cut at its edges)
    render(full, JG_W, JG_H, pal, style, radius=14, frame=False)
    img = cairo.ImageSurface.create_from_png(full)
    T = 144
    for r in range(JG_H // T):
        for c in range(JG_W // T):
            t = cairo.ImageSurface(cairo.FORMAT_ARGB32, T, T)
            tc = cairo.Context(t)
            tc.set_source_surface(img, -c * T, -r * T)
            tc.paint()
            t.write_to_png(os.path.join(OUT, f'jgmenu-{r}{c}.png'))
    # rofi windows, the size their rasi gives them
    for name, fw, fh in (('clipboard', 0.47, 0.42), ('pass', 0.37, 0.40)):
        png = os.path.join(OUT, f'rofi-{name}.png')
        render(png, int(SW * fw), int(SH * fh), pal, style)
        rasi(name, png, M + 26)


if __name__ == '__main__':
    main()
