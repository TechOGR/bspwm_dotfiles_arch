#!/usr/bin/env python3
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
#
# RoundBorders - window frames: the theme's style around every window
# (and the ring just outside a framed window resizes it: the pointer takes
# the arrow of that border or corner, dragging moves it)
# (WIN_SKIN, RiceEditor -> Windows / Themes) and, without a style, borders
# that follow picom's rounded corners on xrender (the "lite" profile).
#
# With a style it draws, right above each window, the frame of that style
# (lib/wscard.py paint_window: wavy liquid glass, leaves, flames, HUD
# brackets, lava seam...), dimmed on unfocused windows, recolored by
# RiceEditor -> Palette ("windows" tint).
#
# picom rounds a window by clipping it, border included; its GLX backend
# then redraws the border along the curve, xrender does not, so the
# border vanished at every corner. This draws, right above each window,
# only the border ring (an X shape: 4 strips + the corners) with the same
# radius, width and colors as bspwm. Redrawn only when bspwm reports a
# change; with GLX, no border or no corner radius it just waits.
#
#   RoundBorders             run (started by config/modules/01-bspwm.sh)
#   RoundBorders --reload    re-read radius / width / colors now
#   RoundBorders --restart | --stop
#
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

import os
import re
import sys
import json
import time
import signal
import subprocess
sys.path.insert(0, os.path.join(os.path.expanduser('~'), '.config/bspwm/lib'))
import bspcsafe  # noqa: E402,F401  every bspc call has a time limit (no bspwm freeze)

HOME = os.path.expanduser('~')
BSPWM = os.path.join(HOME, '.config/bspwm')
PICOM_CONF = os.path.join(BSPWM, 'config/picom/picom.conf')
LOCK = os.path.join(HOME, '.cache', os.environ.get('USER', 'user'), '.roundborders.lock')
# picom-rules.conf gives these square corners: no ring for them
SQUARE = {'mpv', 'Viewnior', 'retroarch'}
# translucent terminals get the theme's background drawn under them; they
# are found by the program behind the window (Term opens them as FloaTerm...)
TERM_PROCS = {'alacritty', 'kitty', 'ghostty', 'st', 'xterm', 'uxterm', 'urxvt', 'foot', 'wezterm-gui',
              'xfce4-terminal', 'konsole', 'gnome-terminal-', 'terminator', 'tilix', 'termite', 'sakura'}
TERMINALS = {'kitty', 'alacritty', 'com.mitchellh.ghostty', 'st', 'st-256color', 'xterm', 'uxterm', 'urxvt',
             'foot', 'wezterm', 'org.wezfurlong.wezterm', 'xfce4-terminal', 'bspwm-scratch'}


def running_pid():
    try:
        with open(LOCK) as f:
            pid = int(f.read().strip() or 0)
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def cli():
    arg = sys.argv[1] if len(sys.argv) > 1 else ''
    pid = running_pid()
    sig = {'--stop': signal.SIGTERM, '--restart': signal.SIGTERM, '--reload': signal.SIGHUP}.get(arg)
    if sig and pid:
        os.kill(pid, sig)
        if arg == '--restart':
            for _ in range(40):
                if running_pid() is None:
                    break
                time.sleep(0.05)
    if arg in ('--stop', '--reload'):
        sys.exit(0)


def bspc(*args):
    return subprocess.run(['bspc', *args], capture_output=True, text=True).stdout.strip()


def xrender():
    """True when picom runs on xrender (PicomStart adds it in lite)."""
    out = subprocess.run(['pgrep', '-a', '-x', 'picom'], capture_output=True, text=True).stdout
    if not out:
        return False
    if '--backend xrender' in out or '--backend=xrender' in out:
        return True
    m = re.search(r'^backend\s*=\s*"?(\w+)', open(PICOM_CONF).read(), re.M)
    return bool(m and m.group(1) == 'xrender')


def corner_radius():
    try:
        m = re.search(r'^corner-radius\s*=\s*(\d+)', open(PICOM_CONF).read(), re.M)
        return int(m.group(1)) if m else 0
    except OSError:
        return 0


def theme_var(name):
    try:
        rice = open(os.path.join(BSPWM, '.rice')).read().strip()
        text = open(os.path.join(BSPWM, 'rices', rice, 'theme-config.bash')).read()
    except OSError:
        return ''
    m = re.search(rf'^{name}=["\']?([\w.]*)', text, re.M)
    return m.group(1) if m else ''


class Stacking:
    """bspwm's _NET_CLIENT_LIST_STACKING (bottom to top) read with libX11
    on a connection of its own (GDK's get_window_stack() comes back empty
    under bspwm and property_get can't be called from Python)."""

    def __init__(self):
        import ctypes
        self.c = ctypes
        x = self.x = ctypes.CDLL('libX11.so.6')
        x.XOpenDisplay.restype = ctypes.c_void_p
        x.XOpenDisplay.argtypes = [ctypes.c_char_p]
        x.XDefaultRootWindow.restype = ctypes.c_ulong
        x.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
        x.XInternAtom.restype = ctypes.c_ulong
        x.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
        x.XGetWindowProperty.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_long,
                                         ctypes.c_long, ctypes.c_int, ctypes.c_ulong,
                                         ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_int),
                                         ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_ulong),
                                         ctypes.POINTER(ctypes.c_void_p)]
        x.XFree.argtypes = [ctypes.c_void_p]
        self.dpy = x.XOpenDisplay(None)
        self.root = x.XDefaultRootWindow(self.dpy) if self.dpy else 0
        self.atom = x.XInternAtom(self.dpy, b'_NET_CLIENT_LIST_STACKING', 0) if self.dpy else 0

    def read(self):
        if not self.dpy:
            return []
        c = self.c
        typ, fmt, n, after, data = c.c_ulong(), c.c_int(), c.c_ulong(), c.c_ulong(), c.c_void_p()
        ok = self.x.XGetWindowProperty(self.dpy, self.root, self.atom, 0, 4096, 0, 33,   # 33 = XA_WINDOW
                                       c.byref(typ), c.byref(fmt), c.byref(n), c.byref(after), c.byref(data))
        if ok != 0 or not data.value:
            return []
        try:
            arr = c.cast(data, c.POINTER(c.c_ulong))
            return [arr[i] for i in range(n.value)]
        finally:
            self.x.XFree(data)


def perf_lite():
    """Lite performance profile (bin/PerfProfile, cached per boot)?"""
    try:
        return subprocess.run([os.path.join(BSPWM, 'bin/PerfProfile')], capture_output=True, text=True,
                              timeout=10).stdout.strip() == 'lite'
    except (OSError, subprocess.TimeoutExpired):
        return False


def win_skin():
    """WIN_SKIN of theme-config.bash: the style window frames are drawn in."""
    return theme_var('WIN_SKIN')


def main():
    cli()
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    gi.require_version('GdkX11', '3.0')
    from gi.repository import Gtk, Gdk, GLib, GdkX11
    import cairo
    sys.path.insert(0, os.path.join(BSPWM, 'lib'))
    import riceui as ui
    try:
        import wscard
    except Exception:
        wscard = None
    _lock = ui.single_instance('roundborders')  # noqa: F841  writes LOCK
    GLib.set_prgname('RoundBorders')
    # X errors on other programs' windows are expected: a window can close
    # between an event and our restack/shape of it (BadWindow). GDK aborts
    # the program on an untrapped X error, and then every frame / texture
    # vanished at once: this trap, never popped, ignores them.
    Gdk.Display.get_default().error_trap_push()

    st = {'conf': None, 'rings': {}, 'backs': {}, 'back_want': {}, 'timer': None, 'raise': set(),
          'shaped': {}, 'on_screen': set(), 'rects': {}, 'tiled': set(), 'tiled_top': None}

    def hexcolor(h):
        h = (h or '#000000').lstrip('#')[-6:]
        return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))

    def read_conf():
        skin = win_skin()
        skin = skin if wscard and skin in wscard.CARDS else ''
        st['conf'] = {
            'skin': skin,
            'backdrop': bool(skin) and theme_var('WIN_BACKDROP') != 'false',
            'tint': wscard and wscard.ws.tint_target('windows'),
            'xrender': xrender(),
            'r': corner_radius(),
            'bw': int(bspc('config', 'border_width') or 0),
            'gap': int(bspc('config', 'window_gap') or 0),
            'lite': perf_lite(),
            'focused': hexcolor(bspc('config', 'focused_border_color')),
            'normal': hexcolor(bspc('config', 'normal_border_color')),
        }

    term_cache = {}

    def is_terminal(cid, cl):
        """A terminal window? By its class, else by the process that owns it
        (read once per window)."""
        if cid not in term_cache:
            names = {(cl.get('className') or '').lower(), (cl.get('instanceName') or '').lower()}
            ok = bool(names & TERMINALS)
            if not ok:
                out = subprocess.run(['xprop', '-id', hex(cid), '_NET_WM_PID'], capture_output=True,
                                     text=True).stdout
                m = re.search(r'= (\d+)', out)
                try:
                    comm = open(f'/proc/{m.group(1)}/comm').read().strip() if m else ''
                except OSError:
                    comm = ''
                ok = comm in TERM_PROCS
            term_cache[cid] = ok
        return term_cache[cid]

    def wanted():
        """{client id: (frame x, y, w, h, focused)} for the windows on screen
        (and st['back_want']: the terminals that get a themed background)."""
        c = st['conf']
        st['back_want'] = {}
        st['alive'] = {int(i, 16) for i in bspc('query', '-N', '-n', '.window').split()}
        if not (c['skin'] or c['xrender'] and c['r'] > 0 and c['bw'] > 0):
            return {}
        out = {}
        st['on_screen'] = set()
        st['rects'] = {}
        st['tiled'] = set()
        f = bspc('query', '-N', '-n', 'focused.window')
        focused = int(f, 16) if f else None
        for desk in bspc('query', '-D', '-d', '.active').split():
            try:
                tree = json.loads(bspc('query', '-T', '-d', desk) or '{}')
            except ValueError:
                continue
            stack = [tree.get('root')]
            while stack:
                n = stack.pop()
                if not n:
                    continue
                stack += [n.get('firstChild'), n.get('secondChild')]
                cl = n.get('client')
                if cl:
                    st['on_screen'].add(n['id'])
                    rr = cl['floatingRectangle'] if cl.get('state') == 'floating' else cl['tiledRectangle']
                    if not n.get('hidden'):
                        st['rects'][n['id']] = (rr['x'], rr['y'], rr['width'], rr['height'])
                if not cl or n.get('hidden') or cl.get('state') == 'fullscreen':
                    continue
                if cl.get('className') in SQUARE:
                    continue
                bw = cl.get('borderWidth', c['bw'])
                if bw <= 0 and not c['skin']:
                    continue
                r = cl['floatingRectangle'] if cl.get('state') == 'floating' else cl['tiledRectangle']
                out[n['id']] = (r['x'] - bw, r['y'] - bw, r['width'] + 2 * bw, r['height'] + 2 * bw, bw,
                                n['id'] == focused)
                if cl.get('state') != 'floating':
                    st['tiled'].add(n['id'])
                if c['backdrop'] and is_terminal(n['id'], cl):
                    st['back_want'][n['id']] = (r['x'], r['y'], r['width'], r['height'], bw)
        return out

    def ring_region(w, h, bw, r):
        reg = cairo.Region()
        for rect in ((0, 0, w, bw), (0, h - bw, w, bw), (0, 0, bw, h), (w - bw, 0, bw, h),
                     (0, 0, r, r), (w - r, 0, r, r), (0, h - r, r, r), (w - r, h - r, r, r)):
            reg.union(cairo.RectangleInt(*map(int, rect)))
        return reg

    E = wscard.WINDOW_REACH if wscard else 0   # room for ornaments outside the window

    # ── resize from the frame: the ring just outside each window (in the gap)
    # takes the pointer, shows the arrow of that border / corner and drags it
    CORNER = 22
    CURSORS = {'top': 'n-resize', 'bottom': 's-resize', 'left': 'w-resize', 'right': 'e-resize',
               'top_left': 'nw-resize', 'top_right': 'ne-resize', 'bottom_left': 'sw-resize',
               'bottom_right': 'se-resize'}
    cursors = {}

    def cursor(name):
        if name not in cursors:
            try:
                cursors[name] = Gdk.Cursor.new_from_name(Gdk.Display.get_default(), CURSORS[name])
            except Exception:
                cursors[name] = None
        return cursors[name]

    def handle_band(cid, w, h):
        """The input region of a frame overlay (w x h, window at E..): a band
        just outside the window's border."""
        t = 10 if cid not in st['tiled'] else max(5, st['conf'].get('gap', 0) // 2 + 1)
        reg = cairo.Region(cairo.RectangleInt(E - t, E - t, w - 2 * E + 2 * t, h - 2 * E + 2 * t))
        reg.subtract(cairo.Region(cairo.RectangleInt(E, E, w - 2 * E, h - 2 * E)))
        return reg

    def handle_at(win, ex, ey):
        w0, h0 = win.info['w'] - 2 * E, win.info['h'] - 2 * E
        horiz = 'left' if ex < E + CORNER else 'right' if ex > E + w0 - CORNER else ''
        vert = 'top' if ey < E + CORNER else 'bottom' if ey > E + h0 - CORNER else ''
        return f'{vert}_{horiz}' if vert and horiz else vert or horiz or None

    def on_motion(win, ev):
        d = st.get('drag')
        if d:
            now = time.monotonic()
            if now - d['last'] < 0.012:
                return True
            dx = int(ev.x_root - d['x']) if 'left' in d['name'] or 'right' in d['name'] else 0
            dy = int(ev.y_root - d['y']) if 'top' in d['name'] or 'bottom' in d['name'] else 0
            if dx or dy:
                subprocess.run(['bspc', 'node', hex(d['cid']), '-z', d['name'], str(dx), str(dy)],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                d['x'] += dx
                d['y'] += dy
                d['last'] = now
            return True
        name = handle_at(win, ev.x, ev.y)
        if name and getattr(win, 'cursor_name', None) != name:
            win.cursor_name = name
            win.get_window().set_cursor(cursor(name))
        return True

    def on_press(win, ev):
        if ev.button != 1 or not getattr(win, 'cid', None):
            return False
        name = handle_at(win, ev.x, ev.y)
        if name:
            st['drag'] = {'cid': win.cid, 'name': name, 'x': ev.x_root, 'y': ev.y_root, 'last': 0}
            subprocess.run(['bspc', 'node', hex(win.cid), '-f'], capture_output=True)
        return True

    def on_release(_win, _ev):
        st['drag'] = None
        return True

    def frame_cache(win):
        """The frame of a window drawn once per size / style / tint (a focus
        change only changes its opacity: the rich styles take 40-100 ms to
        draw) and its X shape: exactly the painted pixels plus the resize
        band, so the compositor blends a thin frame instead of 90 px bands
        around every window. Lite leaves out the glow inside the edge."""
        info = win.info
        w, h, bw = info['w'], info['h'], info['bw']
        key = (info['skin'], w, h, bw, st['conf']['r'], info.get('tint'), st['conf']['lite'], info.get('tiled'))
        cache = getattr(win, 'cache', None)
        if not cache or cache[0] != key:
            surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
            fw, fh = w - 2 * E, h - 2 * E
            wscard.paint_window(cairo.Context(surf), info['skin'], E + bw / 2, E + bw / 2, fw - bw, fh - bw,
                                min(st['conf']['r'], fw / 2, fh / 2), True, inner_glow=not st['conf']['lite'])
            reg = wscard.alpha_region(surf)
            reg.union(handle_band(win.cid, w, h))
            cache = win.cache = (key, surf, reg)
        return cache

    def draw(win, cr):
        info = win.info
        w, h, bw = info['w'], info['h'], info['bw']
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        if info.get('skin'):
            # the frame is drawn once per size / style / tint and kept: a
            # focus change only changes how opaque it is (the rich styles
            # take 40-100 ms to draw, twice per click was felt)
            cache = frame_cache(win)
            cr.set_source_surface(cache[1], 0, 0)
            cr.paint_with_alpha(1.0 if info['focused'] else 0.45)
            return True
        r = max(0.0, st['conf']['r'] - bw / 2)
        x, y, ww, hh = bw / 2, bw / 2, w - bw, h - bw
        r = min(r, ww / 2, hh / 2)
        cr.new_sub_path()
        cr.arc(x + ww - r, y + r, r, -1.5708, 0)
        cr.arc(x + ww - r, y + hh - r, r, 0, 1.5708)
        cr.arc(x + r, y + hh - r, r, 1.5708, 3.1416)
        cr.arc(x + r, y + r, r, 3.1416, 4.7124)
        cr.close_path()
        cr.set_line_width(bw)
        cr.set_source_rgb(*st['conf']['focused' if info['focused'] else 'normal'])
        cr.stroke()
        return True

    foreign = {}

    def foreign_win(cid):
        target = foreign.get(cid)
        if target is None:
            try:
                target = GdkX11.X11Window.foreign_new_for_display(Gdk.Display.get_default(), cid)
            except Exception:
                target = None
            foreign[cid] = target
        return target

    regions = {}

    def style_region(skin, w, h, bw, r):
        """The window cut to the style's outline (wavy, zigzag, jagged,
        chamfered...), cached per size."""
        key = (skin, w, h, bw, r)
        if key not in regions:
            if len(regions) > 64:
                regions.clear()
            regions[key] = wscard.window_region(skin, w, h, bw, r)
        return regions[key]

    def shape_clients(want):
        """Give each window the shape of the theme's outline (X Shape on
        the client itself: its corners and edges follow the waves / cuts of
        the frame instead of staying a rectangle). Windows that leave the
        style (fullscreen, another theme) get their plain shape back."""
        skin = st['conf']['skin']
        cut = wscard and skin in wscard.SHAPED
        r = st['conf']['r']
        for cid, (_x, _y, w, h, bw, _f) in want.items():
            key = (skin, w - 2 * bw, h - 2 * bw, bw, r) if cut else None
            if st['shaped'].get(cid) == key:
                continue
            gw = foreign_win(cid)
            if gw is None:
                continue
            try:
                gw.shape_combine_region(style_region(*key) if key else None, 0, 0)
            except Exception:
                continue
            if key:
                st['shaped'][cid] = key
            else:
                st['shaped'].pop(cid, None)
        alive = st.get('alive', set())
        for cid in list(st['shaped']):
            if cid in want:
                continue
            if cid not in alive:
                st['shaped'].pop(cid)
                foreign.pop(cid, None)
            elif cid in st['on_screen']:   # fullscreen / hidden now: rectangle again
                unshape(cid)

    def unshape(cid):
        st['shaped'].pop(cid, None)
        gw = foreign_win(cid)
        if gw is not None:
            try:
                gw.shape_combine_region(None, 0, 0)
            except Exception:
                pass

    def covering(cid):
        """Is the window over (or under) another one on screen?"""
        r = st.get('rects', {}).get(cid)
        if not r:
            return False
        x, y, w, h = r
        return any(o != cid and x < ox + ow and ox < x + w and y < oy + oh and oy < y + h
                   for o, (ox, oy, ow, oh) in st['rects'].items())

    def restack(cid, win, where='above', new=False):
        """Frames go right above their window, through our own X
        connection (in order with everything else we send, no fork).
        Backgrounds go to the very bottom of the stack, where bspwm never
        moves windows relative to them (restacking them on every click
        made the frames flicker). Only a terminal over another window
        (monocle, a float over a browser) gets its background right
        under it, so the scene hides what is behind."""
        gw = win.get_window()
        if not gw:
            return
        if where == 'below':
            win.mode = 'under' if covering(cid) else 'bottom'
            target = foreign_win(cid) if win.mode == 'under' else None
            if target is not None:
                try:
                    gw.restack(target, False)
                    return
                except Exception:
                    pass
            gw.lower()
            # a video wallpaper (VideoWall) sits at the bottom too: go over it
            vids = subprocess.run(['xdotool', 'search', '--class', '^VideoWall$'], capture_output=True,
                                  text=True).stdout.split()
            for v in vids[-1:]:
                try:
                    gw.restack(GdkX11.X11Window.foreign_new_for_display(Gdk.Display.get_default(),
                                                                       int(v)), True)
                except Exception:
                    pass
            return
        # the frame of a tiled window sits over the topmost tiled window:
        # when bspwm raises a tiled window on focus it puts it right over
        # the previous topmost one, still under the frames, so a click never
        # hides a frame (it flickered for the 25 ms until the restack)
        anchor = st['tiled_top'] if cid in st['tiled'] and st.get('tiled_top') else cid
        target = foreign_win(anchor)
        if target is not None:
            gw.restack(target, True)
        else:
            subprocess.run(['xdo', 'above', '-t', hex(anchor), hex(gw.get_xid())],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        reshape(win)

    def reshape(win):
        """Set the frame's X shape again (same region, cached). picom's
        damage tracking doesn't repaint what a restacked translucent window
        covers: a frame moved over a window kept showing the wallpaper in
        its band. A ShapeNotify makes picom take the whole frame area again
        (cheaper than use-damage = false, which repaints the full screen)."""
        reg = getattr(win, 'shape_reg', None)
        gw = win.get_window()
        if reg is not None and gw is not None:
            gw.shape_combine_region(reg, 0, 0)

    def draw_back(win, cr):
        i = win.info
        wscard.paint_backdrop(cr, st['conf']['skin'], i['w'], i['h'], max(0, st['conf']['r'] - i['bw']))
        return True

    def sync_backs(restack_all):
        """Themed backgrounds right under the translucent terminals."""
        want = st.get('back_want', {})
        for cid in list(st['backs']):
            if cid not in want:
                if cid in st.get('alive', ()):   # on another desktop: keep it, hidden
                    st['backs'][cid].hide()
                else:
                    st['backs'].pop(cid).destroy()
        for cid, (x, y, w, h, bw) in want.items():
            win = st['backs'].get(cid)
            new = win is None
            if new:
                win = Gtk.Window(type=Gtk.WindowType.POPUP)
                win.set_title('RoundBorders')
                win.set_app_paintable(True)
                vis = win.get_screen().get_rgba_visual()
                if vis:
                    win.set_visual(vis)
                win.info = {}
                win.connect('draw', draw_back)
                st['backs'][cid] = win
            info = {'x': x, 'y': y, 'w': w, 'h': h, 'bw': bw, 'skin': st['conf']['skin'],
                    'tint': st['conf']['tint'], 'r': st['conf']['r']}
            if not new and not win.get_visible():   # back from another desktop
                win.show()
                restack(cid, win, 'below', True)
            changed = info != win.info
            mode = 'under' if covering(cid) else 'bottom'
            if not changed:
                # only a background under its terminal follows it in the stack
                if mode != getattr(win, 'mode', None) or mode == 'under' and (restack_all or cid in st['raise']):
                    restack(cid, win, 'below')
                continue
            if (x, y, w, h) != tuple(win.info.get(k) for k in ('x', 'y', 'w', 'h')):
                win.set_size_request(w, h)
                win.resize(w, h)
                win.move(x, y)
            win.info = info
            if new:
                win.realize()
                win.get_window().input_shape_combine_region(cairo.Region(), 0, 0)
            skin = st['conf']['skin']
            win.get_window().shape_combine_region(
                style_region(skin, w, h, bw, st['conf']['r']) if wscard and skin in wscard.SHAPED else None, 0, 0)
            if new:
                win.connect('map-event', lambda w, _e, c=cid: (restack(c, w, 'below', True), False)[1])
                win.show()
                # and once more when everything settled (map, theme reload)
                GLib.timeout_add(500, lambda w=win, c=cid: (w.get_window() and restack(c, w, 'below', True), False)[1])
            if new:
                restack(cid, win, 'below', True)
            win.queue_draw()

    def tiled_top():
        """The highest tiled window in the X stack (_NET_CLIENT_LIST_STACKING)."""
        stack = stacking.read()
        for xid in reversed(stack):
            if xid in st['tiled']:
                return xid
        return None

    def fast_restack():
        """bspwm just changed the stacking (it rewrites the root's
        _NET_CLIENT_LIST_STACKING as it restacks): put every frame back over
        its window and every background under its terminal right now, with
        no bspc round trip. Waiting for the bspc event, the 10 ms batch and
        the queries (~40 ms) let a raised window cover its frames, a frame
        stay over a window just opened on top, a terminal show the window
        behind it instead of its scene - the flicker on focus."""
        stack = stacking.read()
        if stack == st.get('stack'):
            return
        st['stack'] = stack
        st['tiled_top'] = next((x for x in reversed(stack) if x in st['tiled']), None)
        for cid, win in st['backs'].items():
            if win.get_visible() and getattr(win, 'mode', None) == 'under':
                restack(cid, win, 'below')
        for xid in stack:   # bottom to top: upper windows' frames end higher
            win = st['rings'].get(xid)
            if win is not None and win.get_visible():
                restack(xid, win)
        Gdk.Display.get_default().flush()

    def on_gdk_event(ev):
        if ev.type == Gdk.EventType.PROPERTY_NOTIFY and ev.window == root_win:
            try:
                if ev.property.atom.name() == '_NET_CLIENT_LIST_STACKING':
                    fast_restack()
            except Exception:
                pass
        Gtk.main_do_event(ev)

    stacking = Stacking()
    root_win = Gdk.get_default_root_window()
    root_win.set_events(root_win.get_events() | Gdk.EventMask.PROPERTY_CHANGE_MASK)
    Gdk.event_handler_set(on_gdk_event)

    def sync(restack_all=False):
        st['timer'] = None
        want = wanted()
        top = tiled_top()
        if top != st.get('tiled_top'):
            st['tiled_top'] = top
            restack_all = True   # the tiled frames follow the new top
        shape_clients(want)
        sync_backs(restack_all)
        # monocle: only the tiled window on top shows its frame (the ones
        # under it, same place, would draw over it)
        if top in want:
            tr = want[top][:4]
            for cid in [c for c in want if c != top and c in st['tiled'] and want[c][:4] == tr]:
                del want[cid]
        for cid in list(st['rings']):
            if cid not in want:
                if cid in st.get('alive', ()):   # on another desktop: keep it, hidden
                    st['rings'][cid].hide()
                else:
                    st['rings'].pop(cid).destroy()
                    foreign.pop(cid, None)
        skin = st['conf']['skin']
        for cid, (x, y, w, h, bw, foc) in want.items():
            if skin:   # the overlay reaches E px past the window for ornaments
                x, y, w, h = x - E, y - E, w + 2 * E, h + 2 * E
            win = st['rings'].get(cid)
            new = win is None
            if new:
                win = Gtk.Window(type=Gtk.WindowType.POPUP)
                win.set_title('RoundBorders')
                win.set_app_paintable(True)
                vis = win.get_screen().get_rgba_visual()
                if vis:
                    win.set_visual(vis)
                win.info = {}
                win.cid = cid
                win.connect('draw', draw)
                win.add_events(Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.BUTTON_PRESS_MASK |
                               Gdk.EventMask.BUTTON_RELEASE_MASK)
                win.connect('motion-notify-event', on_motion)
                win.connect('button-press-event', on_press)
                win.connect('button-release-event', on_release)
                st['rings'][cid] = win
            info = {'x': x, 'y': y, 'w': w, 'h': h, 'bw': bw, 'focused': foc, 'skin': skin,
                    'tint': st['conf']['tint'], 'tiled': cid in st['tiled']}
            if not new and not win.get_visible():   # back from another desktop
                win.show()
                restack(cid, win, 'above', True)
            if info == win.info:
                # nothing to redraw (the flicker on every click came from
                # reshaping + repainting all frames): only put it back on top
                if restack_all or cid in st['raise']:
                    restack(cid, win)
                continue
            if all(win.info.get(k) == info[k] for k in info if k != 'focused'):
                # focus moved: same shape and place, just repaint
                win.info = info
                win.queue_draw()
                if cid in st['raise']:
                    restack(cid, win)
                continue
            geometry = (x, y, w, h, bw) != tuple(win.info.get(k) for k in ('x', 'y', 'w', 'h', 'bw'))
            win.info = info
            if geometry:
                win.set_size_request(w, h)
                win.resize(w, h)
                win.move(x, y)
            if new:
                win.realize()
            gw = win.get_window()
            r = min(st['conf']['r'], w // 2, h // 2)
            win.shape_reg = frame_cache(win)[2] if skin else ring_region(w, h, bw, r)
            gw.shape_combine_region(win.shape_reg, 0, 0)
            # skinned frames: the band outside the window resizes it; plain
            # border rings (xrender) take no input
            gw.input_shape_combine_region(handle_band(cid, w, h) if skin else cairo.Region(), 0, 0)
            if new:
                win.connect('map-event', lambda w, _e, c=cid: (restack(c, w, 'above', True), False)[1])
                win.show()
                GLib.timeout_add(500, lambda w=win, c=cid: (w.get_window() and restack(c, w, 'above', True), False)[1])
            restack(cid, win, 'above', new)
            win.queue_draw()
        st['raise'] = set()
        return False

    def schedule(restack_all=False):
        # several events within 10 ms: one sync, and a restack if any asked
        st['pending_restack'] = st.get('pending_restack', False) or restack_all
        if st['timer']:
            GLib.source_remove(st['timer'])

        def fire():
            r, st['pending_restack'] = st['pending_restack'], False
            return sync(r)
        st['timer'] = GLib.timeout_add(10, fire)

    buf = {'data': b''}

    def on_event(fd, _cond):
        try:
            chunk = os.read(fd, 65536)
        except BlockingIOError:
            return True
        if not chunk:
            Gtk.main_quit()
            return False
        buf['data'] += chunk
        *lines, buf['data'] = buf['data'].split(b'\n')
        restack_all = any(ln.startswith((b'node_stack', b'node_add', b'node_transfer', b'desktop_focus',
                                         b'node_swap', b'node_state', b'node_flag')) for ln in lines)
        for ln in lines:   # bspwm raises a focused window: only its overlays go back over it
            if ln.startswith(b'node_focus'):
                try:
                    st['raise'].add(int(ln.split()[-1], 16))
                except ValueError:
                    pass
        schedule(restack_all)
        return True

    def reload():
        read_conf()
        for win in list(st['rings'].values()) + list(st['backs'].values()):
            win.info = {}
        schedule(True)
        return True

    read_conf()
    proc = subprocess.Popen(['bspc', 'subscribe', 'node_add', 'node_remove', 'node_swap', 'node_transfer',
                             'node_focus', 'node_stack', 'node_geometry', 'node_state', 'node_flag',
                             'node_layer', 'desktop_focus', 'desktop_layout'],
                            stdout=subprocess.PIPE, bufsize=0)
    fd = proc.stdout.fileno()
    os.set_blocking(fd, False)
    GLib.unix_fd_add_full(GLib.PRIORITY_HIGH, fd, GLib.IO_IN | GLib.IO_HUP, on_event)
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGHUP, reload)
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, lambda: (Gtk.main_quit(), False)[1])
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, lambda: (Gtk.main_quit(), False)[1])
    # border colors / width / radius change without a bspwm event: RiceEditor
    # and the theme modules send --reload (SIGHUP)
    tries = {'n': 0}

    def wait_picom():
        # at login Theme.sh (which starts us) runs before PicomStart
        tries['n'] += 1
        if st['conf']['xrender'] or st['conf']['skin']:
            return False
        if subprocess.run(['pgrep', '-x', 'picom'], capture_output=True).returncode == 0:
            reload()
            return False
        return tries['n'] < 30
    GLib.timeout_add_seconds(2, wait_picom)
    schedule(True)
    Gtk.main()
    proc.terminate()
    for cid in list(st['shaped']):   # leave the windows as rectangles
        unshape(cid)
    Gdk.Display.get_default().flush()


if __name__ == '__main__':
    main()
