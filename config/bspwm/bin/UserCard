        css.load_from_data((ui.hud_css(self.pal) + '''
.card { padding: 18px; background-color: alpha(@bg, 0.95); border: 1px solid alpha(@accent, 0.5);
        border-radius: 20px; }
.user { font-size: 15pt; font-weight: 800; letter-spacing: 1px; }
.hud label.host { font-size: 9pt; color: @cyan; }
.panel2 { background-color: alpha(@black, 0.6); border: 1px solid alpha(@fg, 0.06); border-radius: 14px;
          padding: 10px 12px; }
.hud label.ic { color: @accent; font-size: 10pt; }
.hud label.key { font-size: 6.5pt; font-weight: 800; letter-spacing: 2px; color: alpha(@fg, 0.45); }
.val { font-size: 9pt; font-weight: 700; }
.hud label.wicon { font-size: 26pt; color: @cyan; min-width: 44px; }
.wdesc { font-size: 10pt; font-weight: 800; }
.hud label.wtemp { font-size: 18pt; font-weight: 800; color: @accent2; }
button.tog { background-image: none; background-color: alpha(@black, 0.6); box-shadow: none;
             border: 1px solid alpha(@fg, 0.07); border-radius: 14px; padding: 8px 4px; }
button.tog:hover { border-color: @accent; }
button.tog.on { border-color: alpha(@cyan, 0.8); background-color: alpha(@cyan, 0.08);
                box-shadow: 0 0 14px alpha(@cyan, 0.25); }
