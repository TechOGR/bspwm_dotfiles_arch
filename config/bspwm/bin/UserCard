import os
import sys
import math
import time
import json
import socket
import platform
import threading
import subprocess

sys.path.insert(0, os.path.expanduser('~/.config/bspwm/lib'))
import riceui as ui  # noqa: E402
from riceui import Gtk, Gdk, GLib, GdkPixbuf, cairo  # noqa: E402
import avatar  # noqa: E402

SCRIPTS = os.path.join(ui.BSPWM, 'eww/profilecard/scripts')
W = 392


def sh(cmd, timeout=6):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                              shell=isinstance(cmd, str)).stdout.strip()
    except Exception:
        return ''


def spawn(*cmd):
    subprocess.Popen(list(cmd), start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def os_name():
    try:
        for line in open('/etc/os-release'):
            if line.startswith('PRETTY_NAME='):
                return line.split('=', 1)[1].strip().strip('"')
    except OSError:
        pass
    return platform.system()


def uptime():
    try:
        secs = int(float(open('/proc/uptime').read().split()[0]))
    except (OSError, ValueError):
        return '?'
    d, r = divmod(secs, 86400)
    h, m = divmod(r // 60, 60)
    return (f'{d}d ' if d else '') + f'{h}h {m:02d}m'


# ─────────────────────────────────────────────────────────── system stats
class Stats:
    def __init__(self):
        self.prev = None

    def cpu(self):
        try:
            v = list(map(int, open('/proc/stat').readline().split()[1:]))
        except (OSError, ValueError):
            return 0
        idle, total = v[3] + v[4], sum(v)
        if not self.prev:
            self.prev = (idle, total)
            return 0
        di, dt = idle - self.prev[0], total - self.prev[1]
        self.prev = (idle, total)
        return max(0, min(100, 100 * (1 - di / dt))) if dt else 0

    @staticmethod
    def ram():
        info = {}
        try:
            for line in open('/proc/meminfo'):
                k, v = line.split(':')
                info[k] = int(v.split()[0])
            used = info['MemTotal'] - info['MemAvailable']
            return 100 * used / info['MemTotal'], used / 1048576, info['MemTotal'] / 1048576
        except (OSError, KeyError, ValueError):
            return 0, 0, 0

    @staticmethod
    def disk():
        st = os.statvfs('/')
        total = st.f_blocks * st.f_frsize
        used = total - st.f_bfree * st.f_frsize
        return 100 * used / total if total else 0, used / 1e9, total / 1e9

    @staticmethod
    def temp():
        best = None
        for base in ('/sys/class/thermal', '/sys/class/hwmon'):
            try:
                for d in os.listdir(base):
                    for f in ('temp', 'temp1_input'):
                        p = os.path.join(base, d, f)
                        if os.path.exists(p):
                            t = int(open(p).read()) / 1000
                            if 0 < t < 130:
                                best = max(best or 0, t)
            except OSError:
                pass
        return best


class Ring(Gtk.DrawingArea):
    """Neon gauge ring."""

    def __init__(self, card, icon, color):
        super().__init__()
        self.card, self.icon, self.color = card, icon, color
        self.value, self.shown, self.label, self.sub = 0.0, 0.0, '--', ''
        self.set_size_request(78, 96)
        self.connect('draw', self.draw)

    def set(self, value, label, sub=''):
        self.value, self.label, self.sub = value, label, sub
        self.queue_draw()

    def draw(self, w, cr):
        c = self.card.c
        col = c[self.color]
        Wd = w.get_allocated_width()
        cx, cy, r = Wd / 2, 38, 30
        cr.set_line_width(5)
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.set_source_rgba(*c['fg'], 0.08)
        cr.stroke()
        v = max(0.0, min(1.0, self.value / 100))
        if v > 0:
            a0 = -math.pi / 2
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.arc(cx, cy, r, a0, a0 + v * 2 * math.pi)
            cr.set_source_rgba(*col, 1)
            cr.stroke()
            cr.set_line_width(11)
            cr.arc(cx, cy, r, a0, a0 + v * 2 * math.pi)
            cr.set_source_rgba(*col, 0.12)
            cr.stroke()
        ui.text(cr, self.icon, cx, cy - 12, 10, (*col, 1), align='center', valign='middle')
        ui.text(cr, self.label, cx, cy + 7, 9, (*c['fg'], 0.95), bold=True, align='center', valign='middle')
        ui.text(cr, self.sub, cx, 84, 6.5, (*c['fg'], 0.5), align='center', valign='middle', spacing=1)
        return False


class Avatar(Gtk.DrawingArea):
    def __init__(self, card, size=92):
        super().__init__()
        self.card, self.size = card, size
        self.set_size_request(size + 12, size + 12)
        self.mtime = None
        self.pix = None
        self.reload()
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.set_tooltip_text('Change the avatar (AvatarForge)')
        self.connect('draw', self.draw)
        self.connect('button-press-event', lambda *_: (spawn(os.path.join(ui.BSPWM, 'bin/AvatarForge')),
                                                       card.close()))
        self.connect('realize', lambda w: w.get_window().set_cursor(
            Gdk.Cursor.new_from_name(w.get_display(), 'pointer')))
        GLib.timeout_add_seconds(2, self.reload)

    def reload(self):
        path = avatar.current_path()
        try:
            m = os.path.getmtime(path)
        except OSError:
            m = None
        if m != self.mtime:
            self.mtime = m
            try:
                self.pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, self.size * 2, self.size * 2, True)
            except GLib.Error:
                self.pix = None
            self.queue_draw()
        return True

    def draw(self, w, cr):
        c = self.card.c
        s = self.size
        x0 = y0 = 6
        r = s * 0.24
        ui.rounded(cr, x0 - 4, y0 - 4, s + 8, s + 8, r + 4)
        g = cairo.LinearGradient(0, 0, s, s)
        g.add_color_stop_rgba(0, *c['cyan'], 1)
        g.add_color_stop_rgba(1, *c['magenta'], 1)
        cr.set_source(g)
        cr.set_line_width(2)
        cr.stroke()
        ui.rounded(cr, x0, y0, s, s, r)
        cr.save()
        cr.clip()
        cr.set_source_rgb(*c['black'])
        cr.paint()
        if self.pix:
            k = s / max(self.pix.get_width(), self.pix.get_height())
            cr.translate(x0 + (s - self.pix.get_width() * k) / 2, y0 + (s - self.pix.get_height() * k) / 2)
            cr.scale(k, k)
            Gdk.cairo_set_source_pixbuf(cr, self.pix, 0, 0)
            cr.get_source().set_filter(cairo.FILTER_GOOD)
            cr.paint()
        cr.restore()
        return False


# ─────────────────────────────────────────────────────────────── card
class Card(Gtk.Window):
    TOGGLES = [
        # key, label, icon(on), icon(off), status cmd -> on?, toggle cmd
        ('net', 'Network', '󰈀', '󰖪', None, ['OpenApps', '--netmanager']),
        ('bt', 'Bluetooth', '󰂯', '󰂲', None, [os.path.join(SCRIPTS, 'Bluetooth'), '--toggle']),
        ('air', 'Airplane', '󰀝', '󰀞', None, [os.path.join(SCRIPTS, 'Airplane'), '--toggle']),
        ('night', 'Night light', '󰹐', '󱠃', None, [os.path.join(SCRIPTS, 'Redshift'), 'toggle']),
        ('game', 'Game mode', '󰺵', '󰺵', None, [os.path.join(SCRIPTS, 'GameMode'), '--toggle']),
        ('caf', 'Caffeine', '󰅶', '󰾪', None, ['CaffeinePolybar', '--toggle']),
    ]

    def __init__(self):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.set_title('UserCard')
        ui.rgba_window(self)
        self.pal = ui.load_palette()
        self.c = ui.rgb_palette(self.pal)
        self.stats = Stats()
        self.closing = None
        self.t0 = time.monotonic()
        self.install_css()

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.get_style_context().add_class('hud')
        self.add(outer)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.get_style_context().add_class('card')
        box.set_size_request(W, -1)
        outer.pack_start(box, True, True, 0)

        # ── profile
        head = Gtk.Box(spacing=14)
        head.pack_start(Avatar(self), False, False, 0)
        who = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        who.set_valign(Gtk.Align.CENTER)
        user = Gtk.Label(label=os.environ.get('USER', 'user'), xalign=0)
        user.get_style_context().add_class('user')
        who.pack_start(user, False, False, 0)
        host = Gtk.Label(xalign=0)
        host.set_markup(f'<span foreground="{self.pal["magenta"]}">@</span>{socket.gethostname()}')
        host.get_style_context().add_class('host')
        who.pack_start(host, False, False, 0)
        self.up = Gtk.Label(xalign=0)
        self.up.get_style_context().add_class('dim')
        who.pack_start(self.up, False, False, 2)
        head.pack_start(who, True, True, 0)
        btns = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        btns.set_valign(Gtk.Align.CENTER)
        for icon, tip, cmd in (('󰌾', 'Lock', ['ScreenLocker']), ('󰐥', 'Session menu', ['PowerMenu'])):
            b = self.icon_btn(icon, tip, cmd)
            btns.pack_start(b, False, False, 0)
        head.pack_end(btns, False, False, 0)
        box.pack_start(head, False, False, 0)

        # ── system info
        grid = Gtk.Grid(column_spacing=10, row_spacing=6)
        grid.get_style_context().add_class('panel2')
        self.info = {}
        rows = [('os', '󰣇', 'OS'), ('kernel', '', 'KERNEL'), ('wm', '󱂬', 'WM'),
                ('shell', '', 'SHELL'), ('pkgs', '󰏖', 'PACKAGES'), ('upd', '󰚰', 'UPDATES')]
        for i, (key, icon, name) in enumerate(rows):
            col, row = (i % 2) * 3, i // 2
            ic = Gtk.Label(label=icon)
            ic.get_style_context().add_class('ic')
            grid.attach(ic, col, row, 1, 1)
            k = Gtk.Label(label=name, xalign=0)
            k.get_style_context().add_class('key')
            grid.attach(k, col + 1, row, 1, 1)
            v = Gtk.Label(label='…', xalign=0)
            v.set_ellipsize(3)
            v.set_max_width_chars(13)
            v.get_style_context().add_class('val')
            grid.attach(v, col + 2, row, 1, 1)
            self.info[key] = v
        self.info['os'].set_text(os_name().split()[0])
        self.info['kernel'].set_text(platform.release().split('-')[0])
        self.info['wm'].set_text('bspwm')
        self.info['shell'].set_text(os.path.basename(os.environ.get('SHELL', 'sh')))
        ev = Gtk.EventBox()
        ev.add(grid)
        ev.set_tooltip_text('Click to update the system')
        ev.connect('button-press-event', lambda *_: (spawn('OpenApps', '--update'), self.close()))
        box.pack_start(ev, False, False, 0)

        # ── weather
        wx = Gtk.Box(spacing=12)
        wx.get_style_context().add_class('panel2')
        self.w_icon = Gtk.Label(label='󰖐')
        self.w_icon.get_style_context().add_class('wicon')
        wx.pack_start(self.w_icon, False, False, 0)
        wt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        wt.set_valign(Gtk.Align.CENTER)
        self.w_desc = Gtk.Label(label='weather…', xalign=0)
        self.w_desc.get_style_context().add_class('wdesc')
        wt.pack_start(self.w_desc, False, False, 0)
        self.w_city = Gtk.Label(label='', xalign=0)
        self.w_city.get_style_context().add_class('dim')
        wt.pack_start(self.w_city, False, False, 0)
        wx.pack_start(wt, True, True, 0)
        self.w_temp = Gtk.Label(label='--°')
        self.w_temp.get_style_context().add_class('wtemp')
        wx.pack_end(self.w_temp, False, False, 0)
        box.pack_start(wx, False, False, 0)

        # ── gauges
        rings = Gtk.Box(homogeneous=True)
        rings.get_style_context().add_class('panel2')
        self.r_cpu = Ring(self, '󰻠', 'blue')
        self.r_ram = Ring(self, '󰍛', 'cyan')
        self.r_disk = Ring(self, '󰋊', 'magenta')
        self.r_temp = Ring(self, '󰔏', 'yellow')
        for r in (self.r_cpu, self.r_ram, self.r_disk, self.r_temp):
            rings.pack_start(r, True, True, 0)
        ev = Gtk.EventBox()
        ev.add(rings)
        ev.set_tooltip_text('Open the system monitor')
        ev.connect('button-press-event', lambda *_: (spawn('OpenApps', '--sysmonitor'), self.close()))
        box.pack_start(ev, False, False, 0)

        # ── toggles
        tg = Gtk.Grid(column_spacing=8, row_spacing=8, column_homogeneous=True)
        self.tog = {}
        for i, (key, label, on_i, _off_i, _st, cmd) in enumerate(self.TOGGLES):
            b = Gtk.Button()
            b.get_style_context().add_class('tog')
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            b.icon = Gtk.Label(label=on_i)
            b.icon.get_style_context().add_class('ticon')
            v.pack_start(b.icon, False, False, 0)
            b.text = Gtk.Label(label=label)
            b.text.get_style_context().add_class('tname')
            v.pack_start(b.text, False, False, 0)
            b.state = Gtk.Label(label='…')
            b.state.set_ellipsize(3)
            b.state.set_max_width_chars(11)
            b.state.get_style_context().add_class('tstate')
            v.pack_start(b.state, False, False, 0)
            b.add(v)
            b.connect('clicked', lambda _b, k=key, c=cmd: self.toggle(k, c))
            tg.attach(b, i % 3, i // 3, 1, 1)
            self.tog[key] = b
        box.pack_start(tg, False, False, 0)

        # ── shortcuts
        sc = Gtk.Box(spacing=6, homogeneous=True)
        for icon, tip, cmd in (('󰏘', 'Rice Editor', ['RiceEditor']), ('󰸉', 'Wallpapers', ['WallSelect']),
                               ('󰌌', 'Keybinds', ['OpenApps', '--KeyHelp']),
                               ('󰹑', 'Screenshot', ['ScreenShoTer']), ('󰎈', 'Music', ['MusicPlayer']),
                               ('󰀄', 'Avatar', [os.path.join(ui.BSPWM, 'bin/AvatarForge')])):
            sc.pack_start(self.icon_btn(icon, tip, cmd, 'short'), True, True, 0)
        box.pack_start(sc, False, False, 0)

        self.add_events(Gdk.EventMask.KEY_PRESS_MASK | Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect('key-press-event', self.on_key)
        self.connect('button-press-event', self.on_click)
        self.connect('draw', self.on_draw)
        self.connect('map-event', lambda *_: ui.grab_input(self))
        self.connect('destroy', Gtk.main_quit)
        self.connect('size-allocate', lambda *_: self.place())
        self.add_tick_callback(self.fade)

        self.tick_stats()
        GLib.timeout_add(2000, self.tick_stats)
        self.bg_refresh()
        GLib.timeout_add(4000, self.bg_refresh)
        threading.Thread(target=self.fetch_weather, daemon=True).start()

    # ─────────────────────────────────────────────────────────── helpers
