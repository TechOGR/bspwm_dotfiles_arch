button.ibtn, button.short { background-image: none; background-color: alpha(@black, 0.6); box-shadow: none;
             border: 1px solid alpha(@fg, 0.08); border-radius: 10px; padding: 5px 9px; color: @fg;
             font-size: 11pt; }
button.ibtn:hover, button.short:hover { border-color: @accent; color: @accent;
             box-shadow: 0 0 12px alpha(@accent, 0.3); }
''').encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def icon_btn(self, icon, tip, cmd, cls='ibtn'):
        b = Gtk.Button(label=icon)
        b.get_style_context().add_class(cls)
        b.set_tooltip_text(tip)
        b.connect('clicked', lambda *_: (spawn(*cmd), self.close()))
        return b

    def place(self):
        geo = ui.monitor_geometry()
        try:
            sys.path.insert(0, os.path.join(ui.BSPWM, 'lib'))
            import barconf
            conf = barconf.load()
            top = conf['height'] + conf['offset_y'] + 10 if conf['position'] == 'top' else 14
        except Exception:
            top = 50
        self.move(geo.x + 14, geo.y + top)

    # ─────────────────────────────────────────────────────────── data
    def tick_stats(self):
        cpu = self.stats.cpu()
        self.r_cpu.set(cpu, f'{cpu:.0f}%', 'CPU')
        p, used, total = self.stats.ram()
        self.r_ram.set(p, f'{p:.0f}%', f'{used:.1f}/{total:.0f}G')
        p, used, total = self.stats.disk()
        self.r_disk.set(p, f'{p:.0f}%', f'{used:.0f}/{total:.0f}G')
        t = self.stats.temp()
        self.r_temp.set(t or 0, f'{t:.0f}°' if t else 'N/A', 'TEMP')
        self.up.set_text(f'󰔟  up {uptime()}')
        return not self.closing

    def bg_refresh(self):
        threading.Thread(target=self.fetch, daemon=True).start()
        return not self.closing

    def fetch(self):
        d = {}
        try:
            d['upd'] = open(os.path.expanduser('~/.cache/Updates.txt')).read().strip() or '0'
        except OSError:
            d['upd'] = '?'
        if not getattr(self, 'pkgs', None):
            self.pkgs = sh('pacman -Qq | wc -l') or '?'
        d['pkgs'] = self.pkgs
        net = sh("nmcli -t -f TYPE,STATE,CONNECTION dev status | awk -F: '$2==\"connected\" && $1!=\"loopback\""
                 " {print $1\":\"$3; exit}'")
        d['net'] = (bool(net), net.split(':', 1)[-1] if net else 'offline')
        bt = sh([os.path.join(SCRIPTS, 'Bluetooth'), '--name'])
        d['bt'] = (bt not in ('Off', 'Null', ''), 'no adapter' if bt in ('Null', '') else bt)
        air = sh([os.path.join(SCRIPTS, 'Airplane'), '--status'])
        d['air'] = (air == 'On', air or 'Off')
        night = sh([os.path.join(SCRIPTS, 'Redshift'), 'state'])
        d['night'] = (night == 'on', night or 'off')
        game = sh([os.path.join(SCRIPTS, 'GameMode'), '--status'])
        d['game'] = (game == 'On', game or 'Off')
        try:
            caf = open(os.path.join(os.environ.get('XDG_CACHE_HOME', os.path.expanduser('~/.cache')),
                                    'caffeine_state')).read().strip() == 'on'
        except OSError:
            caf = False
        d['caf'] = (caf, 'on' if caf else 'off')
        GLib.idle_add(self.apply_data, d)

    def fetch_weather(self):
        """Network bound: its own thread, cached 10 min between openings."""
        cache = os.path.join(ui.HOME, '.cache', os.environ.get('USER', 'user'), 'usercard_weather.json')
        try:
            if time.time() - os.path.getmtime(cache) < 600:
                with open(cache) as f:
                    GLib.idle_add(self.apply_weather, json.load(f))
                return
        except (OSError, ValueError):
            pass
        w = [sh(['Weather', k], 10) for k in ('icon', 'current_temp', 'weather_desc', 'city')]
        if any(w):
            with open(cache, 'w') as f:
                json.dump(w, f)
        GLib.idle_add(self.apply_weather, w)

    def apply_weather(self, w):
        icon, temp, desc, city = (w + ['', '', '', ''])[:4]
        self.w_icon.set_text(icon or '󰖐')
        self.w_temp.set_text(f'{temp}°' if temp else '--°')
        self.w_desc.set_text(desc or 'no weather data')
        self.w_city.set_text(f'󰍎 {city}' if city else '')
        return False

    def apply_data(self, d):
        self.info['upd'].set_text(d['upd'])
        self.info['pkgs'].set_text(d['pkgs'])
        for key, off_icon in ((t[0], t[3]) for t in self.TOGGLES):
            on, state = d[key]
            b = self.tog[key]
            (b.get_style_context().add_class if on else b.get_style_context().remove_class)('on')
            on_icon = next(t[2] for t in self.TOGGLES if t[0] == key)
            b.icon.set_text(on_icon if on else off_icon)
            b.state.set_text(str(state).upper())
        return False

    def toggle(self, key, cmd):
        if key == 'net':
            spawn(*cmd)
            self.close()
            return
        threading.Thread(target=lambda: (sh(cmd, 20), self.fetch()), daemon=True).start()

    # ─────────────────────────────────────────────────────────── events
    def on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def on_click(self, _w, ev):
        w, h = self.get_size()
        wx, wy = self.get_position()
        if not (wx <= ev.x_root <= wx + w and wy <= ev.y_root <= wy + h):
            self.close()
        return False

    def on_draw(self, _w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        return False

    def fade(self, *_):
        now = time.monotonic()
        if self.closing:
            a = 1 - (now - self.closing) / 0.12
            if a <= 0:
                self.destroy()
                return False
        else:
            a = min(1.0, (now - self.t0) / 0.15)
        if self.get_window():
            self.get_window().set_opacity(max(0.0, a))
        return self.closing is not None or a < 1.0

    def close(self):
        if not self.closing:
            self.closing = time.monotonic()
            self.add_tick_callback(self.fade)


def main():
    GLib.set_prgname('UserCard')
    _lock = ui.single_instance('usercard', toggle=True)  # noqa: F841
    win = Card()
    ui.quit_on_sigterm(win.close)
    win.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
