#!/bin/sh
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
#
# AnimatedWall - kept for old scripts/keybinds: the video wallpaper is
#   VideoWall now (no xwinwrap needed, pauses under windows, etc.)
#
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

case $1 in
    --start) exec "$HOME/.config/bspwm/bin/VideoWall" --start "$2" ;;
    --stop)  exec "$HOME/.config/bspwm/bin/VideoWall" --stop ;;
    *)
        echo "Usage: AnimatedWall [--start video_path] [--stop]  (-> VideoWall)"
        exit 1
        ;;
esac
