#!/usr/bin/env python3
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
#
# ThemeIcons - Papirus folders in the theme: every blue folder of
# Papirus(-Dark) recolored with the palette (a gradient from its blue to
# its magenta) and the theme's emblem in a corner (a skull for Venom, a
# flame for Fire, a butterfly...). Written to ~/.local/share/icons/
# Rice-Folders, which inherits the base theme for everything else.
# Run by config/modules/03-gtk.sh on every theme / palette change.
#
#   ThemeIcons [BASE]     BASE: the icon theme to inherit (Papirus-Dark)
#
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

import os
import re
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.expanduser('~/.config/bspwm/lib'))

BASE = sys.argv[1] if len(sys.argv) > 1 else 'Papirus-Dark'
NAME = 'Rice-Folders'
OUT = os.path.expanduser(f'~/.local/share/icons/{NAME}')
EMBLEM = {'storm': '\U000f0593', 'venom': '\U000f068c', 'butterfly': '\U000f1589', 'snake': '\U000f150e',
          'fire': '\U000f0238', 'lava': '\U000f1a83', 'nature': '\U000f032a', 'liquid': '\U000f058c',
          'glass': '\U000f0674', 'crystal': '\U000f01c8', 'neon': '\U000f06e8', 'cyber': '\U000f06a9',
          'hud': '\U000f01a4', 'holo': '\U000f0018', 'pixel': '\U000f0bc9', 'sketch': '\U000f03eb',
          'minimal': '\U000f08c7'}


def find_theme(name):
    for d in (os.path.expanduser('~/.local/share/icons'), os.path.expanduser('~/.icons'), '/usr/share/icons'):
        if os.path.isdir(os.path.join(d, name)):
            return os.path.join(d, name)
    return None


def mix(a, b, t):
    a = [int(a[i:i + 2], 16) for i in (1, 3, 5)]
    b = [int(b[i:i + 2], 16) for i in (1, 3, 5)]
    return '#%02x%02x%02x' % tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def main():
    import riceui as ui
    base = find_theme(BASE)
    if not base:
        print(f'ThemeIcons: {BASE} not installed', file=sys.stderr)
        return 1
    pal = ui.load_palette()
    style = ui.theme_style() or 'minimal'
    front, acc2, bg = pal['blue'], pal['magenta'], pal['bg']
    back, glyph = mix(front, '#000000', 0.32), mix(bg, front, 0.25)
    em = EMBLEM.get(style, EMBLEM['minimal'])
    grad = (f'<defs><linearGradient id="rg" x1="0" y1="16" x2="0" y2="42" gradientUnits="userSpaceOnUse">'
            f'<stop offset="0" stop-color="{mix(front, "#ffffff", 0.15)}"/><stop offset="1" stop-color="{acc2}"/>'
            f'</linearGradient></defs>')
    badge = (f'<circle cx="38.5" cy="37" r="7.2" fill="{bg}" opacity="0.92"/>'
             f'<circle cx="38.5" cy="37" r="7.2" fill="none" stroke="{acc2}" stroke-width="0.9"/>'
             f'<text x="38.5" y="40.6" font-family="Material Design Icons Desktop" font-size="10" '
             f'text-anchor="middle" fill="{mix(acc2, "#ffffff", 0.35)}">{em}</text>')

    tmp = OUT + '.tmp'
    shutil.rmtree(tmp, ignore_errors=True)
    places = os.path.join(tmp, 'scalable/places')
    os.makedirs(places)
    src_dir = os.path.join(base, '48x48/places')
    n = 0
    cache = {}
    for name in os.listdir(src_dir) if os.path.isdir(src_dir) else []:
        real = os.path.realpath(os.path.join(src_dir, name))   # links chain to the colored folders
        if not re.match(r'(folder|user)-blue[-.]', os.path.basename(real)) or not real.endswith('.svg'):
            continue
        if real not in cache:
            svg = open(real).read()
            svg = svg.replace('#4877b1', back).replace('#5294e2', front).replace('#1d344f', glyph)
            svg = re.sub(r'(<svg[^>]*>)', r'\1' + grad, svg, count=1)
            svg = svg.replace(f'style="fill:{front}"', 'style="fill:url(#rg)"', 1)
            cache[real] = svg.replace('</svg>', badge + '</svg>')
        with open(os.path.join(places, name), 'w') as f:
            f.write(cache[real])
        n += 1
    with open(os.path.join(tmp, 'index.theme'), 'w') as f:
        f.write(f'''[Icon Theme]
Name={NAME}
Comment={BASE} folders in the rice's theme ({style}) -- generated by bin/ThemeIcons
Inherits={BASE},hicolor
Directories=scalable/places

[scalable/places]
Context=Places
Size=48
MinSize=8
MaxSize=512
Type=Scalable
''')
    shutil.rmtree(OUT, ignore_errors=True)
    os.replace(tmp, OUT)
    subprocess.run(['gtk-update-icon-cache', '-f', '-t', '-q', OUT], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)
    print(f'{NAME}: {n} folders ({style})')
    return 0


if __name__ == '__main__':
    sys.exit(main())
