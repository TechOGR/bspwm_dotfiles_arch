#!/usr/bin/env bash
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
#
# NetworkPolybar - HUD network module for polybar (tail mode)
#   ✔ Only the arrows and the speeds: download and upload in KB/s and
#     MB/s (bytes, never bits), fixed width so the bar never jiggles
#   ✔ Arrows and framing in the theme's style (RICE_KIT): double
#     chevrons for Storm, drops for Venom and Liquid, thin for Nature,
#     boxes for Pixel, [brackets] for HUD, // for Cyberpunk...
#   ✔ An idle direction dims; right click: both speeds <-> download only
#   ✔ Colors from the rice palette (the bar restarts on palette change)
#
# Usage: NetworkPolybar            (polybar: tail = true)
#        NetworkPolybar --cycle    (switch view, bound to click-right)
#
# Dependencies: iproute2, NetworkManager (nmcli, optional)
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

CACHE_DIR="$HOME/.cache/$USER"
MODE_FILE="$CACHE_DIR/network_view"
mkdir -p "$CACHE_DIR"

if [ "$1" = "--cycle" ]; then
    case $(cat "$MODE_FILE" 2>/dev/null) in
        compact) echo full > "$MODE_FILE" ;;
        *)       echo compact > "$MODE_FILE" ;;
    esac
    exit 0
fi

# ── palette ────────────────────────────────────────────────────────
read -r RICE < "$HOME/.config/bspwm/.rice" 2>/dev/null
# shellcheck disable=SC1090
. "$HOME/.config/bspwm/rices/${RICE:-crackone}/theme-config.bash" >/dev/null 2>&1
C_OK=${green:-#9ece6a}
C_MID=${yellow:-#e0af68}
C_LOW=${red:-#f7768e}
C_DOWN=${cyan:-#7dcfff}
C_UP=${magenta:-#bb9af7}
C_LINE=${blue:-#7aa2f7}
C_DIM=${blackb:-#414868}
C_TXT=${fg:-#c0caf5}

# ── the theme's arrows: down, up, left / middle / right decoration
case ${RICE_KIT:-$WIN_SKIN} in
    storm) AD=󰄼 AU=󰄿 ;;
    venom|liquid) AD=󰁊 AU=󰁢 ;;
    butterfly|glass|holo) AD=󰳛 AU=󰳡 ;;
    snake) AD=󰍝 AU=󰍠 ;;
    fire) AD=󰁆 AU=󰁞 ;;
    lava) AD=󰞒 AU=󰞕 ;;
    nature|sketch) AD=󱦳 AU=󱦲 ;;
    crystal) AD=󰁉 AU=󰁡 ;;
    neon) AD=󰁇 AU=󰁟 ;;
    cyber) AD=󰄼 AU=󰄿 ;;
    hud) AD=󰶡 AU=󰶣 ;;
    pixel) AD=󰜯 AU=󰜸 ;;
    *) AD=󰜮 AU=󰜷 ;;
esac
L='' M='  ' R=''
case ${RICE_KIT:-$WIN_SKIN} in
    hud)   L="%{F$C_DIM}[%{F-}" M="%{F$C_DIM}] [%{F-}" R="%{F$C_DIM}]%{F-}" ;;
    cyber) M=" %{F$C_DIM}//%{F-} " ;;
    pixel) M=" %{F$C_DIM}▪%{F-} " ;;
    sketch|nature|butterfly|minimal) M="  %{F$C_DIM}·%{F-}  " ;;
esac

prev_iface='' prev_rx=0 prev_tx=0 prev_t=0

active_iface() {
    local i
    i=$(ip -o route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
    if [ -z "$i" ]; then
        for c in /sys/class/net/*; do
            [ "${c##*/}" = lo ] && continue
            [ "$(cat "$c/operstate" 2>/dev/null)" = up ] && { i=${c##*/}; break; }
        done
    fi
    printf '%s' "$i"
}

# bytes/s -> "12.4" + unit, fixed width
human() {
    awk -v b="$1" 'BEGIN {
        k = b / 1024
        if (k >= 1000) printf "%5.1f|MB/s", k / 1024
        else if (k >= 100) printf "%5.0f|KB/s", k
        else printf "%5.1f|KB/s", k
    }'
}

# one direction: arrow (dim when idle) + speed, the unit a bit dimmer
part() { # arrow color bytes
    local col=$2 txt=$C_TXT v
    (( $3 < 512 )) && { col=$C_DIM; txt=$C_DIM; }
    v=$(human "$3")
    printf '%%{F%s}%%{T3}%s%%{T-}%%{F%s} %s%%{F%s} %s%%{F-}' "$col" "$1" "$txt" "${v%|*}" "$C_DIM" "${v#*|}"
}

while :; do
    mode=$(cat "$MODE_FILE" 2>/dev/null)
    iface=$(active_iface)

    if [ -z "$iface" ]; then
        printf '%s%%{F%s}%%{T3}%s%%{T-} offline%%{F-}%s\n' "$L" "$C_LOW" "$(printf '\U000f0c9b')" "$R"
        prev_iface=''
        sleep 2
        continue
    fi

    read -r rx < "/sys/class/net/$iface/statistics/rx_bytes"
    read -r tx < "/sys/class/net/$iface/statistics/tx_bytes"
    now=$(date +%s%N)
    down=0 up=0
    if [ "$iface" = "$prev_iface" ] && (( prev_t > 0 )); then
        dt=$(( (now - prev_t) / 1000000 ))   # ms
        (( dt <= 0 )) && dt=1000
        down=$(( (rx - prev_rx) * 1000 / dt )); (( down < 0 )) && down=0
        up=$(( (tx - prev_tx) * 1000 / dt ));   (( up < 0 )) && up=0
    fi
    prev_iface=$iface prev_rx=$rx prev_tx=$tx prev_t=$now

    if [ "$mode" = compact ]; then
        printf '%s%s%s\n' "$L" "$(part "$AD" "$C_DOWN" "$down")" "$R"
    else
        printf '%s%s%s%s%s\n' "$L" "$(part "$AD" "$C_DOWN" "$down")" "$M" "$(part "$AU" "$C_UP" "$up")" "$R"
    fi
    sleep 1
done
