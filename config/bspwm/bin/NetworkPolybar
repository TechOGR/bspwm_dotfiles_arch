#!/usr/bin/env bash
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
#
# NetworkPolybar - HUD network module for polybar (tail mode)
#   ✔ Wi-Fi signal ramp / ethernet / offline glyph
#   ✔ Live traffic trace: a sparkline tinted by intensity
#   ✔ Download and upload speed in KB/s and MB/s (bytes, never bits),
#     fixed width so the bar never jiggles
#   ✔ Right click cycles the view: full -> compact -> name
#   ✔ Colors from the rice palette (the bar restarts on palette change)
#
# Usage: NetworkPolybar            (polybar: tail = true)
#        NetworkPolybar --cycle    (switch view, bound to click-right)
#
# Dependencies: iproute2, NetworkManager (nmcli, optional)
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

CACHE_DIR="$HOME/.cache/$USER"
MODE_FILE="$CACHE_DIR/network_view"
mkdir -p "$CACHE_DIR"

if [ "$1" = "--cycle" ]; then
    case $(cat "$MODE_FILE" 2>/dev/null) in
        compact) echo name > "$MODE_FILE" ;;
        name)    echo full > "$MODE_FILE" ;;
        *)       echo compact > "$MODE_FILE" ;;
    esac
    exit 0
fi

# ── palette ────────────────────────────────────────────────────────
read -r RICE < "$HOME/.config/bspwm/.rice" 2>/dev/null
# shellcheck disable=SC1090
. "$HOME/.config/bspwm/rices/${RICE:-crackone}/theme-config.bash" >/dev/null 2>&1
C_OK=${green:-#9ece6a}
C_MID=${yellow:-#e0af68}
C_LOW=${red:-#f7768e}
C_DOWN=${cyan:-#7dcfff}
C_UP=${magenta:-#bb9af7}
C_LINE=${blue:-#7aa2f7}
C_DIM=${blackb:-#414868}
C_TXT=${fg:-#c0caf5}

HIST_LEN=8
BLOCKS=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)
hist=()
prev_iface='' prev_rx=0 prev_tx=0 prev_t=0
ssid='' signal=0 slow_tick=0

active_iface() {
    local i
    i=$(ip -o route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
    if [ -z "$i" ]; then
        for c in /sys/class/net/*; do
            [ "${c##*/}" = lo ] && continue
            [ "$(cat "$c/operstate" 2>/dev/null)" = up ] && { i=${c##*/}; break; }
        done
    fi
    printf '%s' "$i"
}

# bytes/s -> fixed width "  0.0 KB/s" / " 12.4 MB/s"
human() {
    awk -v b="$1" 'BEGIN {
        k = b / 1024
        if (k >= 1000) printf "%5.1f MB/s", k / 1024
        else if (k >= 100) printf "%5.0f KB/s", k
        else printf "%5.1f KB/s", k
    }'
}

sparkline() { # uses global hist (rx+tx samples)
    local max=1 v idx out='' col
    for v in "${hist[@]}"; do (( v > max )) && max=$v; done
    # an idle link should look idle, not autoscale noise to full height
    (( max < 4096 )) && max=4096
    for (( i = 0; i < HIST_LEN - ${#hist[@]}; i++ )); do out+="%{F$C_DIM}▁"; done
    for v in "${hist[@]}"; do
        idx=$(( v * 7 / max ))
        if   (( idx >= 6 )); then col=$C_UP
        elif (( idx >= 3 )); then col=$C_DOWN
        elif (( idx >= 1 )); then col=$C_LINE
        else col=$C_DIM; fi
        out+="%{F$col}${BLOCKS[idx]}"
    done
    printf '%s%%{F-}' "$out"
}

while :; do
    mode=$(cat "$MODE_FILE" 2>/dev/null)
    iface=$(active_iface)

    if [ -z "$iface" ]; then
        hist=()
        printf '%%{F%s}󰤮%%{F-} %%{F%s}▁▁▁▁▁▁▁▁%%{F-} %%{F%s}OFFLINE%%{F-}\n' "$C_LOW" "$C_DIM" "$C_LOW"
        prev_iface=''
        sleep 2
        continue
    fi

    # ── icon (Wi-Fi details are refreshed every 5 s, nmcli is slow)
    if [ -d "/sys/class/net/$iface/wireless" ]; then
        if (( slow_tick % 5 == 0 )) && command -v nmcli >/dev/null 2>&1; then
            IFS=: read -r signal ssid < <(nmcli -t -f active,signal,ssid dev wifi 2>/dev/null |
                awk -F: '$1=="yes"{print $2":"$3; exit}')
            signal=${signal:-0}
        fi
        if   (( signal >= 76 )); then icon=󰤨 icol=$C_OK
        elif (( signal >= 51 )); then icon=󰤥 icol=$C_OK
        elif (( signal >= 26 )); then icon=󰤢 icol=$C_MID
        elif (( signal >= 1 ));  then icon=󰤟 icol=$C_LOW
        else icon=󰤯 icol=$C_LOW; fi
        name=${ssid:-$iface}
    else
        icon=󰈀 icol=$C_OK name=$iface
    fi
    slow_tick=$((slow_tick + 1))

    # ── throughput
    read -r rx < "/sys/class/net/$iface/statistics/rx_bytes"
    read -r tx < "/sys/class/net/$iface/statistics/tx_bytes"
    now=$(date +%s%N)
    down=0 up=0
    if [ "$iface" = "$prev_iface" ] && (( prev_t > 0 )); then
        dt=$(( (now - prev_t) / 1000000 ))   # ms
        (( dt <= 0 )) && dt=1000
        down=$(( (rx - prev_rx) * 1000 / dt )); (( down < 0 )) && down=0
        up=$(( (tx - prev_tx) * 1000 / dt ));   (( up < 0 )) && up=0
    fi
    prev_iface=$iface prev_rx=$rx prev_tx=$tx prev_t=$now
    hist+=($((down + up)))
    (( ${#hist[@]} > HIST_LEN )) && hist=("${hist[@]: -HIST_LEN}")

    D=$(human "$down") U=$(human "$up")
    case $mode in
        compact)
            printf '%%{F%s}%s%%{F-} %%{F%s}󰁅%%{F%s}%s%%{F-}\n' "$icol" "$icon" "$C_DOWN" "$C_TXT" "$D" ;;
        name)
            printf '%%{F%s}%s%%{F-} %%{F%s}%s%%{F-} %%{F%s}%s%%{F-}\n' \
                "$icol" "$icon" "$C_TXT" "${name:0:16}" "$C_DIM" "$iface" ;;
        *)
            printf '%%{F%s}%s%%{F-} %s %%{F%s}󰁅%%{F%s}%s %%{F%s}󰁝%%{F%s}%s%%{F-}\n' \
                "$icol" "$icon" "$(sparkline)" "$C_DOWN" "$C_TXT" "$D" "$C_UP" "$C_TXT" "$U" ;;
    esac
    sleep 1
done
