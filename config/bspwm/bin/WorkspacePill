#!/usr/bin/env python3
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
#
# WorkspacePill - the bar's workspaces in the style picked in
# RiceEditor -> Polybar -> Workspace style (lib/wspill.py draws them)
#   ✔ Sits over the gap polybar leaves in its center (module ws-space)
#   ✔ focused = pac-man · occupied = ghost · empty = dot · urgent = red
#   ✔ Click a desktop to go there, scroll to move between them
#   ✔ Redrawn only when bspwm reports a change: no timers, ~0 % CPU
#   ✔ Hides with the bar (HideBar / auto-hide) and under fullscreen
#
#   WorkspacePill              run (exits when the style is "classic")
#   WorkspacePill --restart    replace the running one
#   WorkspacePill --stop | --hide | --show
#
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

import os
import sys
import time
import signal
import subprocess

sys.path.insert(0, os.path.expanduser('~/.config/bspwm/lib'))
import barconf as bc  # noqa: E402
import wspill  # noqa: E402
import bspcsafe  # noqa: E402,F401  every bspc call has a time limit (no bspwm freeze)

LOCK = os.path.join(bc.HOME, '.cache', os.environ.get('USER', 'user'), '.workspacepill.lock')


def running_pid():
    try:
        with open(LOCK) as f:
            pid = int(f.read().strip() or 0)
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def cli():
    arg = sys.argv[1] if len(sys.argv) > 1 else ''
    pid = running_pid()
    sig = {'--stop': signal.SIGTERM, '--restart': signal.SIGTERM,
           '--hide': signal.SIGUSR1, '--show': signal.SIGUSR2}.get(arg)
    if sig and pid:
        os.kill(pid, sig)
        if arg == '--restart':
            for _ in range(40):          # wait for it to let go of the lock
                if running_pid() is None:
                    break
                time.sleep(0.05)
    if arg in ('--stop', '--hide', '--show'):
        sys.exit(0)


def polybar_windows():
    out = subprocess.run(['xdotool', 'search', '--class', '^Polybar$'], capture_output=True, text=True).stdout
    return out.split()


def main():
    cli()
    conf = bc.load()
    style = conf.get('ws_style', 'classic')
    skin = conf.get('bar_skin', 'none') if bc.skin_on(conf) else None
    has_pill = bc.ws_widget(conf)
    if not (has_pill or skin):
        return
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    gi.require_version('GdkX11', '3.0')
    from gi.repository import Gtk, Gdk, GLib, GdkX11
    import cairo
    import riceui as ui
    _lock = ui.single_instance('workspacepill')  # noqa: F841  writes LOCK
    # the bar may still be starting (login, BarCtl apply)
    for _ in range(60):
        if polybar_windows():
            break
        time.sleep(0.25)
    else:
        return

    GLib.set_prgname('WorkspacePill')
    display = Gdk.Display.get_default()
    mon = display.get_primary_monitor() or display.get_monitor(0)
    geo = mon.get_geometry()
    mon_name = (subprocess.run(['bspc', 'query', '-M', '-m', 'primary', '--names'],
                               capture_output=True, text=True).stdout.strip() or
                subprocess.run(['bspc', 'query', '-M', '-m', 'focused', '--names'],
                               capture_output=True, text=True).stdout.strip())
    H = int(conf['height'])
    st = {'desks': [], 'hidden_bar': False, 'fullscreen': False, 'polybar': True, 'm': None}

    def popup():
        w = Gtk.Window(type=Gtk.WindowType.POPUP)
        w.set_title('WorkspacePill')
        w.set_app_paintable(True)
        visual = w.get_screen().get_rgba_visual()
        if visual:
            w.set_visual(visual)
        return w

    win = popup()
    win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.SCROLL_MASK)
    # the bar's background in the style: under polybar, which is transparent
    skin_win = popup() if skin else None
    bar_style = conf.get('style', 'capsule')
    off_y = 0 if bar_style == 'strip' else int(conf['offset_y'])
    skin_h = off_y + H + 8
    groups = {'list': None}   # islands / cyber: (x, w) of each module group
    if skin_win:
        skin_win.set_size_request(geo.width, skin_h)
        skin_win.move(geo.x, geo.y if conf['position'] != 'bottom' else geo.y + geo.height - skin_h)

        def draw_skin(_w, cr):
            cr.set_operator(cairo.OPERATOR_SOURCE)
            cr.set_source_rgba(0, 0, 0, 0)
            cr.paint()
            cr.set_operator(cairo.OPERATOR_OVER)
            y = off_y if conf['position'] != 'bottom' else skin_h - off_y - H
            if bar_style in ('islands', 'cyber'):
                # one skin under each group of modules (found in sample_groups)
                rects = [(gx, y, gw, H) for gx, gw in groups['list'] or []]
            else:
                mx = bc.margin(conf)
                rects = [(mx, y, geo.width - 2 * mx, H)]
            shape = {'cyber': 'chamfer', 'strip': 'square'}.get(bar_style, 'capsule')
            with wspill.tinted(skin, wspill.tint_target('bar')), wspill.bar_shape(shape):
                for r in rects:
                    wspill.paint_bar(cr, skin, geo.width, r)
                if bar_style == 'strip':   # the strip's neon line along its inner edge
                    ly = y + H if conf['position'] != 'bottom' else y
                    col = wspill.rgb(wspill.NATIVE.get(skin, '#6fa8ff'))
                    for lw, a in ((6, 0.12), (3, 0.3), (1.5, 1)):
                        cr.move_to(0, ly)
                        cr.line_to(geo.width, ly)
                        cr.set_line_width(lw)
                        cr.set_source_rgba(*col, a)
                        cr.stroke()
            return True

        def sample_groups():
            """Where polybar drew its pods (alpha 1/255 over a skin): one
            row of the bar window, runs of non-transparent pixels."""
            bars = polybar_windows()
            if not bars or not skin_win.get_visible():
                return True
            try:
                fw = GdkX11.X11Window.foreign_new_for_display(display, int(bars[0]))
                _ok, bx, _by = fw.get_origin()
                bw_, bh_ = fw.get_width(), fw.get_height()
                pb = Gdk.pixbuf_get_from_window(fw, 0, bh_ // 2, bw_, 1)
            except Exception:
                return True
            if pb is None or pb.get_n_channels() != 4:
                return True
            px = pb.get_pixels()
            runs, start, last = [], None, -99
            for x in range(bw_):
                if px[x * 4 + 3] > 0:
                    if start is None or x - last > 8:   # a gap: a new group
                        if start is not None:
                            runs.append((start, last + 1))
                        start = x
                    last = x
            if start is not None:
                runs.append((start, last + 1))
            found = [(bx - geo.x + a, b - a) for a, b in runs if b - a >= 12]
            old = groups['list'] or []
            if len(found) != len(old) or any(abs(a[0] - b[0]) > 2 or abs(a[1] - b[1]) > 2
                                             for a, b in zip(found, old)):
                groups['list'] = found
                skin_win.queue_draw()
            return True
        if bar_style in ('islands', 'cyber'):
            GLib.timeout_add(800, lambda: (sample_groups(), False)[1])
            GLib.timeout_add(1500, sample_groups)
        skin_win.connect('draw', draw_skin)
        skin_win.connect('realize', lambda w: w.get_window().input_shape_combine_region(cairo.Region(), 0, 0))

    def place():
        m = wspill.metrics(len(st['desks']) or 6, H)
        st['m'] = m
        x = geo.x + (geo.width - m['win_w']) // 2
        if conf['position'] == 'bottom':
            y = geo.y + geo.height - int(conf['offset_y']) - H - m['ext']
        else:
            y = geo.y + int(conf['offset_y']) - m['ext']
        win.set_size_request(m['win_w'], m['win_h'])
        win.resize(m['win_w'], m['win_h'])
        win.move(x, y)
        gw = win.get_window()
        if gw:   # clicks only on the pill, the rest lets them through
            px, py, pw, ph = wspill.pill_rect(m)
            region = cairo.Region(cairo.RectangleInt(int(px - 4), 0, int(pw + 8), m['win_h']))
            gw.input_shape_combine_region(region, 0, 0)

    def restack():
        bars = polybar_windows()
        if not bars:
            return
        # the pill right above the bar, the skin right under it: both under
        # every client, so a fullscreen window covers them
        for w, where in ((skin_win, 'below'), (win if has_pill else None, 'above')):
            gw = w.get_window() if w else None
            if gw:
                subprocess.run(['xdo', where, '-t', bars[0], hex(gw.get_xid())],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def update_visibility():
        want = st['polybar'] and not st['hidden_bar'] and not st['fullscreen']
        lead = win if has_pill else skin_win
        if want and not lead.get_visible():
            if skin_win:
                skin_win.show()
            if has_pill:
                win.show()
                place()
            restack()
        elif not want and lead.get_visible():
            win.hide()
            if skin_win:
                skin_win.hide()

    def on_draw(_w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        if has_pill and st['m'] and st['desks']:
            with wspill.tinted(style, wspill.tint_target('workspaces')):
                wspill.paint(cr, style, st['m'], [d[1] for d in st['desks']])
        return True

    def on_press(_w, ev):
        m = st['m']
        if not m or ev.button != 1:
            return False
        centers = wspill.icon_centers(m)
        i = min(range(len(centers)), key=lambda k: abs(centers[k][0] - ev.x))
        if abs(centers[i][0] - ev.x) <= m['step'] / 2 + 4:
            subprocess.Popen(['bspc', 'desktop', '-f', f'{mon_name}:^{i + 1}'])
        return True

    def on_scroll(_w, ev):
        d = ev.direction
        if d == Gdk.ScrollDirection.SMOOTH:
            ok, _dx, dy = ev.get_scroll_deltas()
            d = Gdk.ScrollDirection.DOWN if dy > 0 else Gdk.ScrollDirection.UP
        target = 'next' if d == Gdk.ScrollDirection.DOWN else 'prev'
        subprocess.Popen(['bspc', 'desktop', '-f', f'{target}.local'])
        return True

    def check_fullscreen():
        out = subprocess.run(['bspc', 'query', '-N', '-n', '.fullscreen.window.!hidden',
                              '-d', f'{mon_name}:focused'], capture_output=True, text=True).stdout
        st['fullscreen'] = bool(out.strip())

    def parse_report(line):
        # WMVirtual-1:oI:O2:f3:LT:TT:G  (one monitor after another)
        desks, cur = [], None
        for item in line[1:].split(':'):
            if not item:
                continue
            k, v = item[0], item[1:]
            if k in 'Mm':
                cur = v
            elif cur == mon_name and k in 'OoFfUu':
                state = {'O': 'focused', 'F': 'focused', 'U': 'focused',
                         'o': 'occupied', 'f': 'empty', 'u': 'urgent'}[k]
                desks.append((v, state))
        return desks

    buf = {'data': b''}

    def on_event(fd, cond):
        # Read everything bspwm sent: one desktop switch writes several
        # lines at once (desktop_focus + report); a buffered readline()
        # would leave the report waiting for the NEXT event (the pill
        # looked one switch behind).
        try:
            chunk = os.read(fd, 65536)
        except BlockingIOError:
            return True
        if not chunk:
            Gtk.main_quit()
            return False
        buf['data'] += chunk
        *lines, buf['data'] = buf['data'].split(b'\n')
        report, other = None, False
        for raw in lines:
            line = raw.decode(errors='replace').strip()
            if line.startswith('W'):
                report = line          # only the newest state matters
            elif line:
                other = True
        if report:
            desks = parse_report(report)
            if len(desks) != len(st['desks']):
                first = not st['desks']
                st['desks'] = desks
                place()
                if not first and has_pill:
                    # desktop added/removed: the bar's gap must change width too
                    subprocess.Popen([os.path.join(bc.BSPWM, 'bin/BarCtl'), 'apply'],
                                     start_new_session=True)
            st['desks'] = desks
            win.queue_draw()
        if other or report and st['fullscreen']:
            check_fullscreen()
        update_visibility()
        return True

    def watch_polybar():
        alive = bool(polybar_windows())
        if alive != st['polybar']:
            st['polybar'] = alive
            update_visibility()
        return True

    win.connect('draw', on_draw)
    win.connect('button-press-event', on_press)
    win.connect('scroll-event', on_scroll)
    win.connect('realize', lambda *_: place())

    proc = subprocess.Popen(['bspc', 'subscribe', 'report', 'node_state', 'node_remove', 'desktop_focus'],
                            stdout=subprocess.PIPE, bufsize=0)
    fd = proc.stdout.fileno()
    os.set_blocking(fd, False)
    GLib.unix_fd_add_full(GLib.PRIORITY_HIGH, fd, GLib.IO_IN | GLib.IO_HUP, on_event)
    GLib.timeout_add_seconds(3, watch_polybar)   # rice switch / bar killed

    def set_bar(hidden):
        st['hidden_bar'] = hidden
        update_visibility()
        return True
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGUSR1, lambda: set_bar(True))
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGUSR2, lambda: set_bar(False))
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, lambda: (Gtk.main_quit(), False)[1])
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, lambda: (Gtk.main_quit(), False)[1])

    win.realize()
    Gtk.main()
    proc.terminate()


if __name__ == '__main__':
    main()
