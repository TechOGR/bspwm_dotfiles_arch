#!/usr/bin/env bash
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
#
# Lock - locks the screen with BetterLock: the login card with the avatar
# (RiceEditor -> Login Lock).
# Everything that locks goes through here: super + shift + l, the power
# menu, suspend, the idle auto-lock (xss-lock)...
#
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

exec "$HOME/.config/bspwm/bin/BetterLock" --lock "$@"
