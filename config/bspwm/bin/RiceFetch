#!/usr/bin/env python3
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
#
# RiceFetch - the terminal's greeting in the theme: an emblem of its
# own (a lightning bolt for Storm, a skull for Venom, a butterfly, a
# coiled snake, a flame, a volcano, a tree, a drop...) in the palette's
# gradient, beside the system's details in a box drawn in the theme's
# style (rounded, double, heavy, dashed, pixel, hand-drawn), and the
# palette. Everything is read from files: no slow commands, the
# terminal opens at once. Narrow terminals get the details only.
#
#   RiceFetch            the current theme
#   RiceFetch STYLE      another one (preview)
#
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

import os
import re
import shutil
import sys
import time

HOME = os.path.expanduser('~')
BSPWM = os.path.join(HOME, '.config/bspwm')

# ═══════════════════════════════════════════════════════════ emblems
