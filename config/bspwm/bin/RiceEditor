                                          lambda *_: spawn([os.path.join(BIN, 'AvatarForge')]))),
                     False, False, 0)
        p.pack_start(c, False, False, 0)
        res = self.cfg.resolve(['gtk_theme', 'gtk_icons', 'gtk_cursor', 'rofi_font'])
        c = self.card('󰉼', 'GTK', 'xsettingsd · applied live')
        for var, kind, title in (('gtk_theme', 'gtk', 'GTK theme'), ('gtk_icons', 'icons', 'Icon theme'),
                                 ('gtk_cursor', 'cursor', 'Cursor theme')):
            items = self.list_themes(kind)
            cur = res.get(var, '')
            if cur and cur not in items:
                items.insert(0, cur)
            c.pack_start(self.row(title, '', self.combo([(i, i) for i in items], cur,
                                                        lambda v, vv=var, t=title: self.set_gtk(vv, v, t))),
                         False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰍉', 'Rofi', 'launcher · menus')
        fb = self.fontbutton(res.get('rofi_font') or 'JetBrainsMono NF Bold 9',
                             lambda _f, _s, full: self.set_rofi_font(full))
