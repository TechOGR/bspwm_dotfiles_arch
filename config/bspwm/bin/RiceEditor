        for g in self.gauges.values():
            gb.pack_start(g, True, True, 0)
        gcard.pack_start(gb, False, False, 0)
        p.pack_start(gcard, False, False, 0)
        self._cpu_prev = None

        qa = self.card('󱐋', 'Quick actions')
        grid = Gtk.Grid(column_spacing=12, row_spacing=12, column_homogeneous=True)
        actions = [
            ('󰸉', 'Wallpapers', '3D selector', lambda: spawn(['WallSelect'])),
            ('󰏘', 'Rices', 'switch rice', lambda: spawn(['RiceSelector'])),
            ('󰌾', 'Lock', 'lock screen now', lambda: spawn(['ScreenLocker'])),
            ('󰑓', 'Soft reload', 'bars · picom · dunst', self.soft_reload),
            ('󰄀', 'Screenshot', 'ScreenShoTer', lambda: spawn(['ScreenShoTer'])),
            ('󰁯', 'Snapshot', 'save rice state', lambda: self.snapshot_create('manual')),
        ]
        for i, (icon, title, sub, fn) in enumerate(actions):
            b = Gtk.Button()
