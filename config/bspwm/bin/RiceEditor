def read_rice():
    try:
        with open(os.path.join(BSPWM, '.rice')) as f:
            return f.read().strip()
    except OSError:
        return 'crackone'


RICE = read_rice()
RICE_DIR = os.path.join(BSPWM, 'rices', RICE)
THEME_CFG = os.path.join(RICE_DIR, 'theme-config.bash')
COLORS_FILE = os.path.join(RICE_DIR, 'theme_colors.bash')
WALL_DIR = os.path.join(RICE_DIR, 'walls')
THUMB_DIR = os.path.join(HOME, '.cache', os.environ.get('USER', 'user'), RICE, 'wallselect3d')


# ════════════════════════════════════════════════════════════ file helpers
def read_file(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ''


def write_file(path, text):
    tmp = f'{path}.rice-editor.tmp'
    with open(tmp, 'w') as f:
        f.write(text)
    os.replace(tmp, path)


def file_get(path, pattern, default='', group=1):
    m = re.search(pattern, read_file(path), re.M)
    return m.group(group) if m else default


def file_sub(path, pattern, repl, count=1):
    """Regex-replace inside a file. Returns True if something changed."""
    text = read_file(path)
    new, n = re.subn(pattern, repl, text, count=count, flags=re.M)
    if n and new != text:
        write_file(path, new)
    return n > 0


def clean_value(value):
    """Values go inside quotes in shell files: keep them harmless."""
    return re.sub(r'["\'`$\\\n]', '', str(value))


class ThemeConfig:
    """Read / write variables of theme-config.bash keeping comments."""

    def __init__(self, path):
        self.path = path

    def _pattern(self, name):
        return re.compile(rf'^({re.escape(name)}=)("[^"]*"|\'[^\']*\'|[^\s#]*)(.*)$', re.M)

    def raw(self, name, default=''):
        m = self._pattern(name).search(read_file(self.path))
        if not m:
            return default
        v = m.group(2)
        return v[1:-1] if v[:1] in '"\'' and len(v) >= 2 else v

    def set(self, name, value):
        value = clean_value(value)
        text = read_file(self.path)
        m = self._pattern(name).search(text)
        if m:
            q = m.group(2)[:1] if m.group(2)[:1] in '"\'' else '"'
            new = f'{name}={q}{value}{q}{m.group(3)}'
            text = text[:m.start()] + new + text[m.end():]
        else:
            if '# ── RiceEditor ──' not in text:
                text = text.rstrip('\n') + '\n\n# ── RiceEditor ──\n'
            text += f'{name}="{value}"\n'
        write_file(self.path, text)

    def resolve(self, names):
        """Values as bash sees them (palette references expanded)."""
        script = ('. "$1" >/dev/null 2>&1; shift; '
                  'for v in "$@"; do printf "%s\\t%s\\n" "$v" "${!v}"; done')
        try:
            out = subprocess.run(['bash', '-c', script, '_', self.path, *names],
                                 capture_output=True, text=True, timeout=4).stdout
        except Exception:
            out = ''
        res = {}
        for line in out.splitlines():
            k, _, v = line.partition('\t')
            res[k] = v
        return res

    def active_palette(self):
        m = re.search(r'^(cargar_\w+)\s*$', read_file(self.path), re.M)
        return m.group(1) if m else ''

    def set_palette(self, func):
        lines = read_file(self.path).splitlines(keepends=True)
        for i, line in enumerate(lines):
            m = re.match(r'^#?(cargar_\w+)\s*$', line)
            if m:
                lines[i] = (m.group(1) if m.group(1) == func else '#' + m.group(1)) + '\n'
        write_file(self.path, ''.join(lines))


def parse_palettes():
    """{func_name: {var: '#hex'}} from theme_colors.bash, in file order."""
    text = read_file(COLORS_FILE)
    palettes = {}
    for m in re.finditer(r'^(cargar_\w+)\s*\(\)\s*\{(.*?)^\}', text, re.M | re.S):
        palettes[m.group(1)] = dict(re.findall(r'(\w+)="(#[0-9A-Fa-f]{6})"', m.group(2)))
        gtk = re.search(r'gtk_themeb="([^"]+)"', m.group(2))
        if gtk:
            palettes[m.group(1)]['gtk_themeb'] = gtk.group(1)
    return palettes


def palette_title(func):
    return func.replace('cargar_', '').replace('_', ' ').upper()


def hex_rgb(h, fallback=(0.5, 0.5, 0.5)):
    h = (h or '').strip().lstrip('#')
    if len(h) < 6:
        return fallback
    try:
        return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    except ValueError:
        return fallback


def rgba_hex(rgba):
    return '#{:02x}{:02x}{:02x}'.format(*(round(c * 255) for c in (rgba.red, rgba.green, rgba.blue)))


def valid_hex(h):
    return bool(re.fullmatch(r'#[0-9A-Fa-f]{6}', h or ''))


# ═══════════════════════════════════════════════════════════ system actions
def spawn(cmd, shell=False):
    try:
        subprocess.Popen(cmd if not shell else ['sh', '-c', cmd], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as e:
        print(f'RiceEditor: {e}', file=sys.stderr)


def run_bg(fn, done=None):
    """Run fn in a thread; call done(result) back on the GTK thread."""
    def worker():
        try:
            res = fn()
        except Exception as e:  # keep the UI alive whatever happens
            print(f'RiceEditor: {e}', file=sys.stderr)
            res = None
        if done:
            GLib.idle_add(lambda: (done(res), False)[1], priority=GLib.PRIORITY_DEFAULT)
    threading.Thread(target=worker, daemon=True).start()


def bspc(*args):
    try:
        return subprocess.run(['bspc', *map(str, args)], capture_output=True, text=True,
                              timeout=2).stdout.strip()
    except Exception:
        return ''


def run_modules(*mods, reload_picom=False):
    """Re-run theme modules exactly like Theme.sh does, but only these."""
    script = ('read -r RICE < "$HOME/.config/bspwm/.rice"; '
              '. "$HOME/.config/bspwm/rices/$RICE/theme-config.bash"; '
              '_write() { t=$(mktemp "$(dirname "$1")/.tmp.XXXXXX") || return 1; '
              'cat > "$t" && mv -f "$t" "$1"; }; '
              'for m in "$@"; do . "$HOME/.config/bspwm/config/modules/$m"; done')
    subprocess.run(['bash', '-c', script, '_', *mods], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, timeout=30)
    if reload_picom:
        reload_picom()


# picom v13 occasionally dies on a SIGUSR1 reload: bring it back if so
PICOM_RUN = f'picom --config "{PICOM_CONF}" >/dev/null 2>&1 &'


def reload_picom():
    spawn('pkill -USR1 -x picom; sleep 1.5; pgrep -x picom >/dev/null || ' + PICOM_RUN, shell=True)


def restart_picom():
    spawn('pkill -x picom; while pgrep -x picom >/dev/null; do sleep 0.1; done; ' + PICOM_RUN, shell=True)


def bspwmrc_get(key, default=''):
    return file_get(BSPWMRC, rf'^bspc config\s+{key}\s+(\S+)', default)


def bspwmrc_set(key, value):
    if not file_sub(BSPWMRC, rf'^(bspc config\s+{key}\s+)\S+', rf'\g<1>{value}'):
        file_sub(BSPWMRC, r'^(bspc config\s+window_gap\s+\S+)$',
                 rf'\g<1>\nbspc config {key:<22}{value}')


def picom_get(key, default=''):
    return file_get(PICOM_CONF, rf'^{re.escape(key)}\s*=\s*"?([^";\n]+)"?', default).strip()


def picom_set(key, value, quoted=False):
    val = f'"{value}"' if quoted else value
    file_sub(PICOM_CONF, rf'^({re.escape(key)}\s*=\s*)[^;\n]+(;?)', rf'\g<1>{val}\g<2>')


def blur_get(key, default=''):
    block = read_file(PICOM_RULES).split('rules:')[0]
    m = re.search(rf'{key}\s*=\s*"?([\w.]+)"?;', block)
    return m.group(1) if m else default


def blur_set(key, value, quoted=False):
    text = read_file(PICOM_RULES)
    head, sep, tail = text.partition('rules:')
    val = f'"{value}"' if quoted else value
    head = re.sub(rf'({key}\s*=\s*)"?[\w.]+"?;', rf'\g<1>{val};', head, count=1)
    write_file(PICOM_RULES, head + sep + tail)


def wall_thumb(path):
    return os.path.join(THUMB_DIR, hashlib.md5(path.encode()).hexdigest() + '.jpg')


def ensure_thumb(path):
    thumb = wall_thumb(path)
    try:
        if os.path.getmtime(thumb) >= os.path.getmtime(path):
            return thumb
    except OSError:
        pass
    os.makedirs(THUMB_DIR, exist_ok=True)
    subprocess.run(['magick', '-define', 'jpeg:size=1280x720', path + '[0]', '-strip',
                    '-thumbnail', '640x360^', '-gravity', 'center', '-extent', '640x360',
                    '-quality', '88', thumb], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return thumb if os.path.exists(thumb) else None


def current_wallpaper():
    link = os.path.join(HOME, '.cache/current_wall')
    p = os.path.realpath(link) if os.path.islink(link) else ''
    if os.path.isfile(p):
        return p
    m = re.search(r"feh[^']*'([^']+)'", read_file(os.path.join(HOME, '.fehbg')))
    return m.group(1) if m else ''


def list_walls():
    try:
        return sorted(os.path.join(WALL_DIR, f) for f in os.listdir(WALL_DIR)
                      if f.lower().endswith(IMG_EXTS))
    except OSError:
        return []


def pretty_wall(path):
    name = os.path.splitext(os.path.basename(path))[0]
    name = re.split(r'-(4k-)?wallpaper-uhdpaper\.com', name)[0]
    return name.replace('-', ' ').replace('_', ' ').upper()


