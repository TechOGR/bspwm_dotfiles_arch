        p.pack_start(c, False, False, 0)
        return p

    def set_gtk(self, var, value, title):
        self.cfg.set(var, value)
        self.apply_modules(f'{title} → {value}', '03-gtk.sh')

    def set_rofi_font(self, full):
        self.cfg.set('rofi_font', full)
        self.apply_modules(f'Rofi font → {full}', '04-rofi.sh')

    # ─────────────────────────────────────────────────────── snapshots
    SNAP_FILES = [('theme-config.bash', THEME_CFG), ('picom.conf', PICOM_CONF),
                  ('picom-rules.conf', PICOM_RULES), ('bspwmrc', BSPWMRC), ('kitty.conf', KITTY_CONF),
                  ('dock.json', os.path.join(BSPWM, 'config/dock.json')),
                  ('polybar.json', os.path.join(BSPWM, 'config/polybar.json')),
                  ('avatar.json', os.path.join(BSPWM, 'config/avatar.json'))]

    def page_snapshots(self):
        p = self.page()
        c = self.card('󰁯', 'Save state', 'theme-config · picom · bspwmrc · kitty · dock · bar')
        self.snap_entry = Gtk.Entry()
        self.snap_entry.set_placeholder_text('snapshot name (optional)')
        self.snap_entry.set_width_chars(30)
        self.snap_entry.connect('activate', lambda e: self.snapshot_create(e.get_text() or 'manual'))
        c.pack_start(self.row('New snapshot', 'Freeze the current rice so you can come back to it (Ctrl+S)',
                              self.snap_entry,
                              self.button('󰆓  Save', 'neon',
                                          lambda *_: self.snapshot_create(self.snap_entry.get_text() or 'manual'))),
                     False, False, 0)
        p.pack_start(c, False, False, 0)
        self.snap_card = self.card('󰋚', 'Timeline', 'restore re-applies the whole rice')
        self.snap_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.snap_card.pack_start(self.snap_list, False, False, 0)
        p.pack_start(self.snap_card, False, False, 0)
        self.refresh_snapshots()
        return p

    def snapshots(self):
        base = os.path.join(SNAP_DIR, RICE)
        try:
            return sorted((d for d in os.listdir(base) if os.path.isdir(os.path.join(base, d))), reverse=True)
        except OSError:
            return []

    def snapshot_create(self, label, quiet=False):
        label = re.sub(r'[^\w-]+', '-', label.strip())[:40] or 'manual'
        name = f'{datetime.now():%Y%m%d-%H%M%S}__{label}'
        dest = os.path.join(SNAP_DIR, RICE, name)
        os.makedirs(dest, exist_ok=True)
        for fname, src in self.SNAP_FILES:
            if os.path.exists(src):
                shutil.copy2(src, os.path.join(dest, fname))
        if not quiet:
            self.toast(f'Snapshot "{label}" saved')
            if hasattr(self, 'snap_entry'):
                self.snap_entry.set_text('')
        if hasattr(self, 'snap_list'):
            self.refresh_snapshots()

    def auto_snapshot(self):
        today = f'{datetime.now():%Y%m%d}'
        if not any(s.startswith(today) and s.endswith('__auto') for s in self.snapshots()):
            self.snapshot_create('auto', quiet=True)
        # keep at most 10 automatic ones
        autos = [s for s in self.snapshots() if s.endswith('__auto')]
        for old in autos[10:]:
            shutil.rmtree(os.path.join(SNAP_DIR, RICE, old), ignore_errors=True)
        self.refresh_snapshots()

    def refresh_snapshots(self):
        for ch in self.snap_list.get_children():
            self.snap_list.remove(ch)
        snaps = self.snapshots()
        if not snaps:
            lb = Gtk.Label(label='No snapshots yet.', xalign=0)
            lb.get_style_context().add_class('dim')
            self.snap_list.pack_start(lb, False, False, 6)
        for s in snaps:
            stamp, _, label = s.partition('__')
            try:
                when = datetime.strptime(stamp, '%Y%m%d-%H%M%S').strftime('%d %b %Y · %H:%M:%S')
            except ValueError:
                when = stamp
            icon = '󰁯' if label == 'auto' else '󰆓'
            self.snap_list.pack_start(self.row(f'{icon}  {label.upper()}', when,
                                               self.button('Restore', 'neon', lambda *_, n=s: self.snapshot_restore(n)),
                                               self.button('Delete', 'danger', lambda *_, n=s: self.snapshot_delete(n))),
                                      False, False, 0)
        self.snap_list.show_all()

    def snapshot_restore(self, name):
        src = os.path.join(SNAP_DIR, RICE, name)
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.OK_CANCEL,
                                text=f'Restore snapshot {name.partition("__")[2]}?')
        dlg.format_secondary_text('The current state is saved first as "before-restore", so you can go back.')
        ok = dlg.run() == Gtk.ResponseType.OK
        dlg.destroy()
        if not ok:
            return
        self.snapshot_create('before-restore', quiet=True)
        for fname, dst in self.SNAP_FILES:
            f = os.path.join(src, fname)
            if os.path.exists(f):
                shutil.copy2(f, dst)
        self.load_colors()
        # bspwmrc re-runs Theme.sh, so this re-applies everything
        spawn(['bspc', 'wm', '-r'])
        self.toast('Snapshot restored — reopen RiceEditor to refresh every value')

    def snapshot_delete(self, name):
        shutil.rmtree(os.path.join(SNAP_DIR, RICE, name), ignore_errors=True)
        self.refresh_snapshots()
        self.toast('Snapshot deleted')

    # ──────────────────────────────────────────────────────────── help
    def page_help(self):
        p = self.page()
        c = self.card('󰌌', 'Shortcuts')
        for keys, what in (('Ctrl + 1 … 0', 'Jump to a section'), ('Ctrl + S', 'Save a snapshot'),
                           ('Ctrl + R', 'Soft reload (bars, picom, dunst, sxhkd)'),
                           ('Ctrl + L', 'Lock the screen'), ('Super + Shift + L', 'Login lock (betterlockscreen)'),
                           ('Ctrl + Q', 'Close RiceEditor')):
            k = Gtk.Label(label=keys)
            k.get_style_context().add_class('value')
            c.pack_start(self.row(what, '', k), False, False, 0)
        p.pack_start(c, False, False, 0)
        c = self.card('󰋗', 'How it works')
        text = (
            f'• Everything you touch is written to {THEME_CFG.replace(HOME, "~")} (or picom.conf /\n'
            '  bspwmrc for global options) and applied at once: bspc for windows, a picom reload\n'
            '  for the compositor, and the rice modules for dunst, gtk, rofi and terminals.\n'
            '• You always edit the rice that was active when RiceEditor opened. After switching\n'
            '  rice, close and reopen it.\n'
            '• A snapshot is taken automatically the first time you open RiceEditor each day,\n'
            '  so a bad tweak is always one click away from being undone (Snapshots).\n'
            '• Palettes come from theme_colors.bash; the editor itself follows the active one.')
        lb = Gtk.Label(label=text, xalign=0)
        lb.get_style_context().add_class('dim')
        c.pack_start(lb, False, False, 4)
        p.pack_start(c, False, False, 0)
        return p


def main():
    GLib.set_prgname('RiceEditor')
    app = RiceEditor()
    app.show_all()
    if '--section' in sys.argv[1:-1]:
        key = sys.argv[sys.argv.index('--section') + 1]
        if key in app.nav:
            app.go(key)
    Gtk.main()


if __name__ == '__main__':
    main()
