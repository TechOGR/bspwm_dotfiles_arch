        self.term_prev = TermPreview(self)
        self.term_prev.opacity = float(cfg.raw('P_TERM_OPACITY', '1.0') or 1)
        self.term_prev.font = cfg.raw('term_font_name', 'JetBrainsMono Nerd Font')
        self.term_prev.size = int(cfg.raw('term_font_size', '10') or 10)
        c = self.card('󰍹', 'Live preview')
        c.pack_start(self.term_prev, False, False, 4)
        p.pack_start(c, False, False, 0)

        c = self.card('󰆍', 'Appearance', 'kitty · alacritty · ghostty')
        sc, lab = self.scale(0.1, 1.0, 0.05, self.term_prev.opacity, 2, self.set_term_opacity, delay=350)
        sc.connect('value-changed', lambda s: (setattr(self.term_prev, 'opacity', s.get_value()),
                                               self.term_prev.queue_draw()))
        c.pack_start(self.row('Background opacity', '1.0 = solid. Blur only shows through transparency',
                              sc, lab), False, False, 0)
        fb = self.fontbutton(f'{self.term_prev.font} {self.term_prev.size}', self.set_term_font, mono=True)
        c.pack_start(self.row('Font', 'Monospace family and size', fb), False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰞷', 'Shell', '~/.zshrc')
        c.pack_start(self.row('Pixel-art on startup', 'Run colorscript when a terminal opens',
                              self.switch(self.zsh_line_active('$HOME/.local/bin/colorscript -r'),
                                          lambda on: self.zsh_toggle('$HOME/.local/bin/colorscript -r', on, 'Pixel-art'))),
                     False, False, 0)
        c.pack_start(self.row('Disable fzf-tab', 'Use plain zsh completion instead of fzf-tab',
                              self.switch(self.zsh_line_active('disable-fzf-tab'),
                                          lambda on: self.zsh_toggle('disable-fzf-tab', on, 'fzf-tab disabled'))),
                     False, False, 0)
        p.pack_start(c, False, False, 0)
        return p

    def set_term_opacity(self, v):
        self.cfg.set('P_TERM_OPACITY', f'{v:.2f}')
        self.apply_modules(f'Terminal opacity → {v:.2f}', '05-kitty.sh', '05-alacritty.sh', '05-ghostty.sh')

    def set_term_font(self, family, size, _full):
        self.cfg.set('term_font_name', family)
        self.cfg.set('term_font_size', size)
        file_sub(KITTY_CONF, r'^font_family\s+.*$', f'font_family {family}')
        file_sub(KITTY_CONF, r'^font_size\s+.*$', f'font_size {size}')
        self.term_prev.font, self.term_prev.size = family, size
        self.term_prev.queue_draw()
        self.apply_modules(f'Terminal font → {family} {size}', '05-alacritty.sh')
        spawn(['pkill', '-USR1', '-x', 'kitty'])

    @staticmethod
    def zsh_line_active(needle):
        for line in read_file(ZSHRC).splitlines():
            if needle in line:
                return not line.strip().startswith('#')
        return False

    def zsh_toggle(self, needle, on, title):
        lines = read_file(ZSHRC).splitlines(keepends=True)
        for i, line in enumerate(lines):
            if needle in line:
                lines[i] = line.lstrip('#') if on else (line if line.lstrip().startswith('#') else '#' + line)
                break
        else:
            self.toast(f'{needle} not found in ~/.zshrc', error=True)
            return
        write_file(ZSHRC, ''.join(lines))
        self.toast(f'{title} {"on" if on else "off"} — open a new terminal')

    # ─────────────────────────────────────────────────────── wallpaper
    def page_wallpaper(self):
        p = self.page()
        c = self.card('󰸉', 'On screen')
        hb = Gtk.Box(spacing=18)
        self.wall_prev = ImageBox(self, 400, 225, caption=pretty_wall(current_wallpaper()))
        self.wall_prev.set_image(current_wallpaper())
        hb.pack_start(self.wall_prev, False, False, 0)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        v.set_valign(Gtk.Align.CENTER)
        v.pack_start(self.button('󰸉  Open 3D selector', 'neon', lambda *_: spawn(['WallSelect'])), False, False, 0)
        v.pack_start(self.button('󰒝  Random wallpaper', 'ghost', lambda *_: self.random_wall()), False, False, 0)
        note = Gtk.Label(label='The lockscreen always uses the wallpaper\nthat is on screen.', xalign=0)
        note.get_style_context().add_class('mono-note')
        v.pack_start(note, False, False, 0)
        hb.pack_start(v, True, True, 0)
        c.pack_start(hb, False, False, 4)
        p.pack_start(c, False, False, 0)

        if videowall:
            p.pack_start(self.video_card(), False, False, 0)

        c = self.card('󰔟', 'Engine', 'how the wallpaper is chosen at login')
        self.engine_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        engine = self.cfg.raw('ENGINE', 'Default')
        c.pack_start(self.row('Wallpaper engine', '',
                              self.combo([('Default', 'Default · fixed image'), ('Random', 'Random · rice walls'),
                                          ('CustomDir', 'Random · custom folder'), ('Slideshow', 'Slideshow · 15 min'),
                                          ('Animated', 'Video · walls/videos')],
                                         engine, self.show_engine_opts)), False, False, 0)
        c.pack_start(self.engine_box, False, False, 0)
        self.show_engine_opts(engine)
        p.pack_start(c, False, False, 0)

        c = self.card('󰋩', 'Gallery', f'{len(list_walls())} walls · click to apply')
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_max_children_per_line(5)
        flow.set_min_children_per_line(3)
        flow.set_column_spacing(8)
        flow.set_row_spacing(8)
        cur = current_wallpaper()
        self.gallery = {}
        for path in list_walls():
            b = Gtk.Button()
            b.get_style_context().add_class('wall')
            if path == cur:
                b.get_style_context().add_class('current')
            img = Gtk.Image()
            img.set_size_request(160, 90)
            b.add(img)
            b.set_tooltip_text(pretty_wall(path))
            b.connect('clicked', lambda _b, pth=path: self.set_wallpaper(pth))
            flow.add(b)
            self.gallery[path] = b
            run_bg(lambda pth=path: ensure_thumb(pth),
                   lambda t, im=img: t and im.set_from_pixbuf(
                       GdkPixbuf.Pixbuf.new_from_file_at_scale(t, 160, 90, False)))
        c.pack_start(flow, False, False, 4)
        p.pack_start(c, False, False, 0)
        return p

    # ── video wallpapers (VideoWall · rices/<rice>/walls/videos)
    def video_card(self):
        cfg = self.cfg
        folder = videowall.videos_dir()
        c = self.card('󰕧', 'Video wallpapers', folder.replace(HOME, '~') + ' · click to play')
        self.video_status = Gtk.Label(xalign=0)
        self.video_status.get_style_context().add_class('mono-note')
        c.pack_start(self.video_status, False, False, 2)
        self.video_flow = Gtk.FlowBox()
        self.video_flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.video_flow.set_max_children_per_line(5)
        self.video_flow.set_min_children_per_line(3)
        self.video_flow.set_column_spacing(8)
        self.video_flow.set_row_spacing(8)
        c.pack_start(self.video_flow, False, False, 4)

        hb = Gtk.Box(spacing=8)
        hb.pack_start(self.button('󰐎  Play / pause', 'neon', lambda *_: self.video_toggle()), False, False, 0)
        hb.pack_start(self.button('󰓛  Stop · back to picture', 'ghost', lambda *_: self.video_stop()), False, False, 0)
        hb.pack_start(self.button('󰐕  Add video…', 'ghost', lambda *_: self.video_add()), False, False, 0)
        hb.pack_start(self.button('󰉋  Folder', 'ghost',
                                  lambda *_: (os.makedirs(folder, exist_ok=True), spawn(['xdg-open', folder]))),
                      False, False, 0)
        c.pack_start(hb, False, False, 6)

        c.pack_start(self.row('Pause automatically', 'Saves CPU/GPU: the video only plays when you can see it',
                              self.combo([('windows', 'When windows cover the desktop'),
                                          ('fullscreen', 'Only with a fullscreen window'), ('never', 'Never')],
                                         cfg.raw('VIDEO_PAUSE', 'windows'),
                                         lambda v: self.set_video('VIDEO_PAUSE', v, 'Pause'))), False, False, 0)
        c.pack_start(self.row('Fit', '',
                              self.combo([('fill', 'Fill (crop the edges)'), ('fit', 'Fit (black bars)'),
                                          ('stretch', 'Stretch')], cfg.raw('VIDEO_FIT', 'fill'),
                                         lambda v: self.set_video('VIDEO_FIT', v, 'Fit'))), False, False, 0)
        sc, lab = self.scale(0.25, 2.0, 0.05, cfg.raw('VIDEO_SPEED', '1.0'), 2,
                             lambda v: self.set_video('VIDEO_SPEED', v, 'Speed'), fmt=lambda v: f'{v:.2f}×')
        c.pack_start(self.row('Speed', '', sc, lab), False, False, 0)
        c.pack_start(self.row('Login lock', 'Play this video behind the betterlockscreen login card',
                              self.button('󰍁  Use on the login lock', 'ghost', lambda *_: self.video_to_lock())),
                     False, False, 0)
        self.refresh_videos()
        return c

    def video_state(self):
        try:
            out = subprocess.run([os.path.join(BIN, 'VideoWall'), '--status'], capture_output=True, text=True,
                                 timeout=5).stdout
            return json.loads(out or '{}')
        except Exception:
            return {}

    def refresh_videos(self):
        def done(st):
            st = st or {}
            playing = st.get('video') if st.get('running') else None
            for ch in self.video_flow.get_children():
                self.video_flow.remove(ch)
            vids = videowall.list_videos()
            if not vids:
                lb = Gtk.Label(label=f'No videos yet: put .mp4 · .mkv · .webm · .gif files in\n'
                                     f'{videowall.videos_dir().replace(HOME, "~")} (or use "Add video…").', xalign=0)
                lb.get_style_context().add_class('dim')
                self.video_flow.add(lb)
            for path in vids:
                b = Gtk.Button()
                b.get_style_context().add_class('wall')
                if path == playing:
                    b.get_style_context().add_class('current')
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                img = Gtk.Image()
                img.set_size_request(160, 90)
                box.pack_start(img, False, False, 0)
                name = Gtk.Label(label=('󰐊 ' if path == playing else '󰕧 ') + videowall.pretty(path))
                name.set_max_width_chars(20)
                name.set_ellipsize(Pango.EllipsizeMode.END)
                name.get_style_context().add_class('dim')
                box.pack_start(name, False, False, 0)
                b.add(box)
                b.set_tooltip_text(os.path.basename(path))
                b.connect('clicked', lambda _b, pth=path: self.video_play(pth))
                self.video_flow.add(b)
                run_bg(lambda pth=path: videowall.thumb(pth),
                       lambda t, im=img: t and im.set_from_pixbuf(
                           GdkPixbuf.Pixbuf.new_from_file_at_scale(t, 160, 90, False)))
            self.video_flow.show_all()
            if not st.get('running'):
                txt = '■ No video playing' + (' — the engine is "Video", it starts at login'
                                              if self.cfg.raw('ENGINE') == 'Animated' else '')
            else:
                paused = [pl for pl in st.get('players', []) if pl.get('paused')]
                why = ('paused by you' if st.get('manual_pause') else
                       'paused: windows cover it' if paused else 'playing')
                txt = f'▶ {videowall.pretty(st.get("video"))} · {why}'
            self.video_status.set_text(txt)
        run_bg(self.video_state, done)
        return False

    def video_play(self, path):
        self.cfg.set('ENGINE', 'Animated')
        self.cfg.set('ANIMATED_WALL', path)
        spawn('[ -f /tmp/wall_refresh.pid ] && kill "$(cat /tmp/wall_refresh.pid)" 2>/dev/null; '
              f'rm -f /tmp/wall_refresh.pid; VideoWall --start "{clean_value(path)}"', shell=True)
        self.toast(f'Video wallpaper → {videowall.pretty(path)}')
        GLib.timeout_add(1500, self.refresh_videos)
        GLib.timeout_add(2500, self.refresh_wall_views)

    def video_stop(self):
        wall = self.cfg.resolve(['DEFAULT_WALL']).get('DEFAULT_WALL') or current_wallpaper()
        if wall and os.path.isfile(wall) and not wall.startswith(os.path.join(HOME, '.cache')):
            self.set_wallpaper(wall)         # ENGINE=Default + VideoWall --stop + feh
        else:
            self.cfg.set('ENGINE', 'Default')
            spawn([os.path.join(BIN, 'VideoWall'), '--stop'])
        self.toast('Video stopped · back to the picture wallpaper')
        GLib.timeout_add(1200, self.refresh_videos)

    def video_toggle(self):
        def work():
            return subprocess.run([os.path.join(BIN, 'VideoWall'), '--toggle'], capture_output=True, text=True,
                                  timeout=5).stdout.strip()
        run_bg(work, lambda r: (self.toast(f'Video wallpaper {r}'), self.refresh_videos()))

    def set_video(self, var, value, title):
        self.cfg.set(var, value)
        spawn([os.path.join(BIN, 'VideoWall'), '--reload'])
        self.toast(f'Video · {title} → {value}')
        GLib.timeout_add(600, self.refresh_videos)

    def video_add(self):
        dlg = Gtk.FileChooserDialog(title='Add videos', parent=self, action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Add', Gtk.ResponseType.OK)
        dlg.set_select_multiple(True)
        flt = Gtk.FileFilter()
        flt.set_name('Videos')
        for ext in videowall.VIDEO_EXT:
            flt.add_pattern(f'*{ext}')
            flt.add_pattern(f'*{ext.upper()}')
        dlg.add_filter(flt)
        files = dlg.get_filenames() if dlg.run() == Gtk.ResponseType.OK else []
        dlg.destroy()
        if not files:
            return

        def work():
            os.makedirs(videowall.videos_dir(), exist_ok=True)
            for f in files:
                dst = os.path.join(videowall.videos_dir(), os.path.basename(f))
                if os.path.abspath(f) != dst:
                    shutil.copy2(f, dst)
            return len(files)
        self.toast('Copying videos…')
        run_bg(work, lambda n: (self.toast(f'{n or 0} video(s) added'), self.refresh_videos()))

    def video_to_lock(self):
        self.cfg.set('BL_VIDEO', '')
        if hasattr(self, 'bl_src') and self.bl_src.get_active_id() != 'video':
            self.bl_src.set_active_id('video')      # saves BL_WALL + re-renders
        else:
            self.set_bl('BL_WALL', 'video')
        self.toast('Login lock → the video wallpaper plays behind it')

    def show_engine_opts(self, engine):
        for ch in self.engine_box.get_children():
            self.engine_box.remove(ch)
        box = self.engine_box
        if engine in ('Random', 'Slideshow'):
            box.pack_start(self.row('Source', f'Images from ~/.config/bspwm/rices/{RICE}/walls',
                                    self.button('Apply', 'neon', lambda *_: self.apply_engine(engine))),
                           False, False, 0)
        else:
            var, what = {'CustomDir': ('CUSTOM_DIR', 'Folder'), 'Default': ('DEFAULT_WALL', 'Image'),
                         'Animated': ('ANIMATED_WALL', 'Video / gif')}[engine]
            entry = Gtk.Entry()
            entry.set_width_chars(38)
            entry.set_text(self.cfg.raw(var))
            browse = self.button('Browse', 'ghost', lambda *_: self.browse(entry, engine))
            box.pack_start(self.row(what, '', entry, browse,
                                    self.button('Apply', 'neon', lambda *_: self.apply_engine(engine, entry.get_text()))),
                           False, False, 0)
        box.show_all()

    def browse(self, entry, engine):
        action = Gtk.FileChooserAction.SELECT_FOLDER if engine == 'CustomDir' else Gtk.FileChooserAction.OPEN
        dlg = Gtk.FileChooserDialog(title='Select', parent=self, action=action)
        dlg.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Select', Gtk.ResponseType.OK)
        if engine != 'CustomDir':
            flt = Gtk.FileFilter()
            pats = ('*.mp4', '*.mkv', '*.gif', '*.webm') if engine == 'Animated' else \
                ('*.jpg', '*.jpeg', '*.png', '*.webp')
            for pat in pats:
                flt.add_pattern(pat)
                flt.add_pattern(pat.upper())
            dlg.add_filter(flt)
        if dlg.run() == Gtk.ResponseType.OK:
            entry.set_text(dlg.get_filename())
        dlg.destroy()

    def apply_engine(self, engine, value=''):
        self.cfg.set('ENGINE', engine)
        var = {'CustomDir': 'CUSTOM_DIR', 'Default': 'DEFAULT_WALL', 'Animated': 'ANIMATED_WALL'}.get(engine)
        if var and value:
            self.cfg.set(var, value)
        stop = ('VideoWall --stop; [ -f /tmp/wall_refresh.pid ] && kill "$(cat /tmp/wall_refresh.pid)" '
                '2>/dev/null; rm -f /tmp/wall_refresh.pid; ')
        find = "find \"$1\" -type f \\( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \\) | shuf -n 1"
        walls = WALL_DIR
        cmds = {
            'Default': 'feh --bg-fill "$1" && WallSync',
            'Random': f'feh --bg-fill "$({find})" && WallSync',
            'CustomDir': f'feh --bg-fill "$({find})" && WallSync',
            'Animated': 'VideoWall --start "$1"',
            'Slideshow': f'(while :; do feh --bg-fill "$({find})"; WallSync; sleep 900; done) & '
                         'echo $! > /tmp/wall_refresh.pid',
        }
        arg = value if engine in ('Default', 'CustomDir', 'Animated') else walls
        subprocess.Popen(['sh', '-c', stop + cmds[engine], '_', arg], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.toast(f'Wallpaper engine → {engine}')
        GLib.timeout_add(1500, self.refresh_wall_views)

    def set_wallpaper(self, path):
        self.cfg.set('ENGINE', 'Default')
        self.cfg.set('DEFAULT_WALL', path)
        spawn('VideoWall --stop; [ -f /tmp/wall_refresh.pid ] && kill "$(cat /tmp/wall_refresh.pid)" 2>/dev/null; '
              f'rm -f /tmp/wall_refresh.pid; feh --bg-fill "{path}" && WallSync', shell=True)
        self.toast(f'Wallpaper → {pretty_wall(path)}')
        GLib.timeout_add(900, self.refresh_wall_views)

    def random_wall(self):
        walls = [w for w in list_walls() if w != current_wallpaper()]
        if walls:
            self.set_wallpaper(random.choice(walls))

    def refresh_wall_views(self):
        cur = current_wallpaper()
        for img_box in (self.wall_prev, self.dash_wall):
            img_box.set_image(cur)
        self.wall_prev.caption = pretty_wall(cur)
        for path, b in self.gallery.items():
            ctx = b.get_style_context()
            (ctx.add_class if path == cur else ctx.remove_class)('current')
        return False

    # ─────────────────────────────────────────────────── notifications
    # ──────────────────────────────────────────────────────────── dock
    def dock_conf(self):
        return riceui.load_dock_conf()

    def dock_save(self, conf, msg):
        riceui.save_dock_conf(conf)  # the dock picks it up by itself (mtime)
        self.toast(msg)

    def dock_set(self, key, value, title):
        conf = self.dock_conf()
        conf[key] = value
        self.dock_save(conf, f'{title} → {value}')

    def dock_enable(self, on):
        conf = self.dock_conf()
        conf['enabled'] = on
        riceui.save_dock_conf(conf)
        if on:
            spawn([os.path.join(BIN, 'Dock')])
        self.toast('Dock enabled' if on else 'Dock disabled')

    def dock_restart(self):
        def work():
            subprocess.run([os.path.join(BIN, 'Dock'), '--quit'], timeout=5)
            time.sleep(0.6)
            spawn([os.path.join(BIN, 'Dock')])
        run_bg(work, lambda _r: self.toast('Dock restarted'))

    def page_dock(self):
        p = self.page()
        if riceui is None:
            c = self.card('󱂬', 'Dock')
            c.pack_start(Gtk.Label(label='~/.config/bspwm/lib/riceui.py is missing', xalign=0), False, False, 0)
            p.pack_start(c, False, False, 0)
            return p
        conf = self.dock_conf()
        self.dock_w = {}
        c = self.card('󱂬', 'Dock', 'bottom of the screen · follows the palette · saved in config/dock.json')
        self.dock_w['enabled'] = self.switch(conf.get('enabled', True), self.dock_enable)
        c.pack_start(self.row('Show the dock', 'Also starts with the session', self.dock_w['enabled']),
                     False, False, 0)
        for key, title, sub in (
                ('autohide', 'Auto-hide', 'Slides away until the pointer touches the bottom edge and comes '
                                          'back over the windows; they then use the whole screen'),
                ('magnify', 'Magnification', 'Wave zoom of the icons under the pointer'),
                ('show_launcher', 'Launcher button', 'Applications button at the left of the dock')):
            self.dock_w[key] = self.switch(conf.get(key), lambda v, k=key, t=title: self.dock_set(k, v, t))
            c.pack_start(self.row(title, sub, self.dock_w[key]), False, False, 0)
        sc, lab = self.scale(28, 72, 2, conf.get('icon_size', 44), 0,
                             lambda v: self.dock_set('icon_size', int(v), 'Icon size'), fmt=lambda v: f'{int(v)} px',
                             delay=350)
        self.dock_w['icon_size'] = sc
        sc.set_size_request(220, -1)
        c.pack_start(self.row('Icon size', '', sc, lab), False, False, 0)
        c.pack_start(self.row('Dock process', 'Restart it if something looks off',
                              self.button('󰑓  Restart dock', 'neon', lambda *_: self.dock_restart())),
                     False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰐃', 'Pinned apps', 'order = order in the dock')
        self.dock_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        c.pack_start(self.dock_list, False, False, 4)
        c.pack_start(self.row('Defaults', 'Brave · Thunar · kitty',
                              self.button('󰜉  Reset', 'ghost', lambda *_: self.dock_reset())), False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰐕', 'Add apps', 'click to pin')
        self.dock_search = Gtk.SearchEntry()
        self.dock_search.set_placeholder_text('search applications…')
        self.dock_search.connect('search-changed', lambda *_: self.dock_fill_picker())
        c.pack_start(self.dock_search, False, False, 6)
        self.dock_flow = Gtk.FlowBox()
        self.dock_flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.dock_flow.set_homogeneous(True)
        self.dock_flow.set_min_children_per_line(4)
        self.dock_flow.set_max_children_per_line(8)
        self.dock_flow.set_row_spacing(8)
        self.dock_flow.set_column_spacing(8)
        c.pack_start(self.dock_flow, False, False, 0)
        p.pack_start(c, False, False, 0)

        self.dock_all = sorted((a for a in Gio.AppInfo.get_all() if a.should_show() and a.get_id()),
                               key=lambda a: a.get_display_name().lower())
        self.dock_fill_list()
        self.dock_fill_picker()
        return p

    def dock_sync(self):
        """Show what dock.json holds now (the dock's own menu edits it too)."""
        if not getattr(self, 'dock_w', None):
            return
        conf = self.dock_conf()
        was, self.loading = self.loading, True
        try:
            for key, w in self.dock_w.items():
                if isinstance(w, Gtk.Switch):
                    w.set_active(bool(conf.get(key)))
                else:
                    w.set_value(float(conf.get(key, 44)))
        finally:
            self.loading = was
        self.dock_fill_list()
        self.dock_fill_picker()

    @staticmethod
    def app_icon(info, size):
        img = Gtk.Image()
        gicon = info.get_icon() if info else None
        if gicon:
            img.set_from_gicon(gicon, Gtk.IconSize.DIALOG)
        else:
            img.set_from_icon_name('application-x-executable', Gtk.IconSize.DIALOG)
        img.set_pixel_size(size)
        return img

    def dock_fill_list(self):
        for ch in self.dock_list.get_children():
            ch.destroy()
        apps = self.dock_conf().get('apps', [])
        if not apps:
            lb = Gtk.Label(label='No pinned apps yet: add some below', xalign=0)
            lb.get_style_context().add_class('dim')
            self.dock_list.pack_start(lb, False, False, 4)
        for i, app_id in enumerate(apps):
            info = Gio.DesktopAppInfo.new(app_id)
            r = Gtk.Box(spacing=12)
            r.get_style_context().add_class('dock-app')
            idx = Gtk.Label(label=f'{i + 1:02d}')
            idx.get_style_context().add_class('dock-idx')
            r.pack_start(idx, False, False, 0)
            r.pack_start(self.app_icon(info, 32), False, False, 0)
            texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            texts.set_valign(Gtk.Align.CENTER)
            t = Gtk.Label(label=info.get_display_name() if info else app_id, xalign=0)
            t.get_style_context().add_class('row-title')
            texts.pack_start(t, False, False, 0)
            d = Gtk.Label(label=app_id if info else f'{app_id} · not installed', xalign=0)
            d.get_style_context().add_class('row-desc')
            texts.pack_start(d, False, False, 0)
            r.pack_start(texts, True, True, 0)
            for icon, tip, cls, cb, ok in (
                    ('󰅁', 'Move left', 'icon-btn', lambda *_, k=i: self.dock_move(k, -1), i > 0),
                    ('󰅂', 'Move right', 'icon-btn', lambda *_, k=i: self.dock_move(k, 1), i < len(apps) - 1),
                    ('󰅖', 'Unpin', 'remove', lambda *_, a=app_id: self.dock_remove(a), True)):
                b = Gtk.Button(label=icon)
                b.get_style_context().add_class('icon-btn')
                if cls != 'icon-btn':
                    b.get_style_context().add_class(cls)
                b.set_tooltip_text(tip)
                b.set_sensitive(ok)
                b.set_valign(Gtk.Align.CENTER)
                b.connect('clicked', cb)
                r.pack_start(b, False, False, 0)
            self.dock_list.pack_start(r, False, False, 0)
        self.dock_list.show_all()

    def dock_fill_picker(self):
        for ch in self.dock_flow.get_children():
            ch.destroy()
        q = self.dock_search.get_text().strip().lower()
        pinned = set(self.dock_conf().get('apps', []))
        shown = 0
        for a in self.dock_all:
            if a.get_id() in pinned:
                continue
            if q and q not in a.get_display_name().lower() and q not in a.get_id().lower():
                continue
            b = Gtk.Button()
            b.get_style_context().add_class('dock-pick')
            b.set_tooltip_text(a.get_description() or a.get_display_name())
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.pack_start(self.app_icon(a, 36), False, False, 0)
            lb = Gtk.Label(label=a.get_display_name())
            lb.set_ellipsize(Pango.EllipsizeMode.END)
            lb.set_max_width_chars(12)
            box.pack_start(lb, False, False, 0)
            b.add(box)
            b.connect('clicked', lambda *_, i=a.get_id(), n=a.get_display_name(): self.dock_add(i, n))
            self.dock_flow.add(b)
            shown += 1
            if shown >= 48:
                break
        self.dock_flow.show_all()

    def dock_add(self, app_id, name):
        conf = self.dock_conf()
        if app_id not in conf['apps']:
            conf['apps'].append(app_id)
        self.dock_save(conf, f'{name} pinned to the dock')
        self.dock_fill_list()
        self.dock_fill_picker()

    def dock_remove(self, app_id):
        conf = self.dock_conf()
        if app_id in conf['apps']:
            conf['apps'].remove(app_id)
        self.dock_save(conf, 'App unpinned')
        self.dock_fill_list()
        self.dock_fill_picker()

    def dock_move(self, i, delta):
        conf = self.dock_conf()
        apps = conf['apps']
        j = i + delta
        if 0 <= j < len(apps):
            apps[i], apps[j] = apps[j], apps[i]
            self.dock_save(conf, 'Dock order updated')
            self.dock_fill_list()

    def dock_reset(self):
        conf = self.dock_conf()
        conf['apps'] = list(riceui.DOCK_DEFAULT['apps'])
        self.dock_save(conf, 'Dock apps reset to defaults')
        self.dock_fill_list()
        self.dock_fill_picker()

    # ─────────────────────────────────────────────────────────── polybar
    BAR_THEMES = [
        ('classic', '󰕮', 'Classic', 'Capsule bar · borderless windows',
         dict(style='capsule', opacity=100, border=False), 'minimal'),
        ('neonhud', '󱐋', 'Neon HUD', 'Angled cyber plates · glowing window frames',
         dict(style='cyber', opacity=90, separators=True), 'neon'),
        ('islands', '󰆧', 'Islands', 'Floating neon pills · glowing frames',
         dict(style='islands', opacity=92, separators=True), 'neon'),
        ('mainframe', '󰍹', 'Mainframe', 'Edge to edge strip · sharp HUD windows',
         dict(style='strip', opacity=96), 'hud'),
    ]
    SECTS = ('left', 'center', 'right')

    def bar_apply(self, msg=None):
        def go():
            run_bg(lambda: subprocess.run([os.path.join(BIN, 'BarCtl'), 'apply'], timeout=30,
                                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL),
                   lambda _r: msg and self.toast(msg))
        self.debounce('bar-apply', 450, go)

    def bar_set(self, key, value, title):
        conf = barconf.load()
        conf[key] = value
        barconf.save(conf)
        if key == 'style':
            self.mark_tiles(self.bar_style_btns, value)
        self.bar_apply(f'{title} → {value}')

    def bar_theme(self, key):
        _k, _i, title, _d, bar, win = next(t for t in self.BAR_THEMES if t[0] == key)
        conf = barconf.load()
        conf.update(bar)
        barconf.save(conf)
        self.mark_tiles(self.bar_theme_btns, key)
        self.set_win_style(win, quiet=True)
        self.bar_sync()
        self.bar_apply(f'Theme {title} applied')

    def page_polybar(self):
        p = self.page()
        if barconf is None:
            c = self.card('󱔓', 'Polybar')
            c.pack_start(Gtk.Label(label='~/.config/bspwm/lib/barconf.py is missing', xalign=0), False, False, 0)
            p.pack_start(c, False, False, 0)
            return p
        conf = barconf.load()
        self.bar_w = {}

        c = self.card('󰏘', 'Themes', 'bar + windows in one click · colors follow the palette')
        flow, self.bar_theme_btns = self.tiles([t[:4] for t in self.BAR_THEMES], '', self.bar_theme)
        c.pack_start(flow, False, False, 4)
        p.pack_start(c, False, False, 0)

        c = self.card('󱔓', 'Bar style')
        flow, self.bar_style_btns = self.tiles(
            [(k, {'capsule': '󰗇', 'islands': '󰆧', 'cyber': '󱐋', 'strip': '󰍹'}[k], t, d)
             for k, t, d in barconf.STYLES], conf['style'],
            lambda k: self.bar_set('style', k, 'Bar style'))
        c.pack_start(flow, False, False, 4)
        p.pack_start(c, False, False, 0)

        c = self.card('󰏘', 'Look', 'applied live')
        self.bar_w['position'] = self.combo([('top', 'Top'), ('bottom', 'Bottom')], conf['position'],
                                            lambda v: self.bar_set('position', v, 'Position'))
        c.pack_start(self.row('Position', 'Edge of the screen (windows make room for it)',
                              self.bar_w['position']), False, False, 0)
        for key, title, desc, lo, hi, fmt in (
                ('height', 'Height', 'Bar thickness', 22, 44, lambda v: f'{int(v)} px'),
                ('offset_y', 'Distance from the edge', 'Floating gap (not used by Strip)', 0, 24,
                 lambda v: f'{int(v)} px'),
                ('margin_x', 'Side margins', 'Space at the left and right ends', 0, 60, lambda v: f'{int(v)} px'),
                ('radius', 'Corner radius', 'Capsule style roundness', 0, 22, lambda v: f'{int(v)} px'),
                ('opacity', 'Opacity', 'Background transparency (needs picom)', 30, 100, lambda v: f'{int(v)} %')):
            sc, lab = self.scale(lo, hi, 1, conf[key], 0,
                                 lambda v, k=key, t=title: self.bar_set(k, int(v), t), fmt=fmt, delay=350)
            sc.set_size_request(220, -1)
            self.bar_w[key] = sc
            c.pack_start(self.row(title, desc, sc, lab), False, False, 0)
        colors = [(k, k) for k in ('bg', 'black', 'accent_color', 'blackb')]
        self.bar_w['bg_color'] = self.combo(colors, conf['bg_color'],
                                            lambda v: self.bar_set('bg_color', v, 'Background'))
        c.pack_start(self.row('Background color', 'Palette color of the bar / pills', self.bar_w['bg_color']),
                     False, False, 0)
        accents = [(k, k) for k in ('blue', 'cyan', 'magenta', 'green', 'yellow', 'red')]
        self.bar_w['accent'] = self.combo(accents, conf['accent'], lambda v: self.bar_set('accent', v, 'Accent'))
        c.pack_start(self.row('Accent color', 'Border and neon line (palette color)', self.bar_w['accent']),
                     False, False, 0)
        for key, title, desc in (('border', 'Border', 'Thin accent frame around the Capsule bar'),
                                 ('separators', 'Separators', 'Thin lines between modules')):
            self.bar_w[key] = self.switch(conf[key], lambda v, k=key, t=title: self.bar_set(k, v, t))
            c.pack_start(self.row(title, desc, self.bar_w[key]), False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰘸', 'Behaviour')
        self.bar_w['autohide'] = self.switch(conf['autohide'], lambda v: self.bar_set('autohide', v, 'Auto-hide'))
        c.pack_start(self.row('Auto-hide', 'Hidden until the pointer touches its screen edge; then it slides in '
                              'over the windows, which use the whole screen', self.bar_w['autohide']),
                     False, False, 0)
        c.pack_start(self.row('Keyboard', 'super + alt + u shows the bar (and keeps it pinned when auto-hide is on) · '
                              'super + alt + h hides it'), False, False, 0)
        c.pack_start(self.row('Bar process', 'Regenerate bar.ini and restart polybar',
                              self.button('󰑓  Restart bar', 'neon', lambda *_: self.bar_apply('Bar restarted'))),
                     False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰕰', 'Modules', 'order = order on the bar · "Gap" splits a group')
        self.bar_mods = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        c.pack_start(self.bar_mods, False, False, 4)
        p.pack_start(c, False, False, 0)

        c = self.card('󰐕', 'Add a module', 'click to add it')
        self.bar_add_to = self.combo([(s, s.title()) for s in self.SECTS], 'right', lambda _v: None)
        c.pack_start(self.row('Add to', 'Group that receives the new module', self.bar_add_to), False, False, 0)
        self.bar_flow = Gtk.FlowBox()
        self.bar_flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.bar_flow.set_homogeneous(True)
        self.bar_flow.set_min_children_per_line(4)
        self.bar_flow.set_max_children_per_line(6)
        self.bar_flow.set_row_spacing(8)
        self.bar_flow.set_column_spacing(8)
        c.pack_start(self.bar_flow, False, False, 4)
        p.pack_start(c, False, False, 0)
        self.bar_fill()
        return p

    def bar_sync(self):
        """Show what polybar.json holds now (ModulesList edits it too)."""
        if barconf is None or not getattr(self, 'bar_w', None):
            return
        conf = barconf.load()
        was, self.loading = self.loading, True
        try:
            for key, w in self.bar_w.items():
                if isinstance(w, Gtk.Switch):
                    w.set_active(bool(conf[key]))
                elif isinstance(w, Gtk.ComboBoxText):
                    w.set_active_id(str(conf[key]))
                else:
                    w.set_value(float(conf[key]))
        finally:
            self.loading = was
        self.mark_tiles(self.bar_style_btns, conf['style'])
        self.bar_fill()

    def bar_fill(self):
        conf = barconf.load()
        cat = {m[0]: m for m in barconf.CATALOG}
        for ch in self.bar_mods.get_children():
            ch.destroy()
        for sect in self.SECTS:
            head = Gtk.Label(label=f'// {sect.upper()}', xalign=0)
            head.get_style_context().add_class('bar-sect')
            self.bar_mods.pack_start(head, False, False, 0)
            mods = conf['modules'][sect]
            if not mods:
                lb = Gtk.Label(label='empty', xalign=0)
                lb.get_style_context().add_class('dim')
                self.bar_mods.pack_start(lb, False, False, 2)
            for i, mod in enumerate(mods):
                _id, icon, name, desc = cat.get(mod, (mod, '󰘦', mod, 'defined in modules.ini'))
                r = Gtk.Box(spacing=12)
                r.get_style_context().add_class('dock-app')
                idx = Gtk.Label(label=f'{i + 1:02d}')
                idx.get_style_context().add_class('dock-idx')
                r.pack_start(idx, False, False, 0)
                ic = Gtk.Label(label=icon)
                ic.get_style_context().add_class('style-icon')
                ic.set_size_request(34, -1)
                r.pack_start(ic, False, False, 0)
                texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                texts.set_valign(Gtk.Align.CENTER)
                t = Gtk.Label(label=name, xalign=0)
                t.get_style_context().add_class('row-title')
                texts.pack_start(t, False, False, 0)
                d = Gtk.Label(label=desc, xalign=0)
                d.get_style_context().add_class('row-desc')
                texts.pack_start(d, False, False, 0)
                r.pack_start(texts, True, True, 0)
                nxt = self.SECTS[(self.SECTS.index(sect) + 1) % 3]
                for bicon, tip, cls, cb, ok in (
                        ('󰅁', 'Move left', 'icon-btn', lambda *_, s=sect, k=i: self.bar_move(s, k, -1), i > 0),
                        ('󰅂', 'Move right', 'icon-btn', lambda *_, s=sect, k=i: self.bar_move(s, k, 1),
                         i < len(mods) - 1),
                        ('󰁔', f'Send to {nxt}', 'icon-btn', lambda *_, s=sect, k=i: self.bar_send(s, k), True),
                        ('󰅖', 'Remove', 'remove', lambda *_, s=sect, k=i: self.bar_remove(s, k),
                         mod not in barconf.FIXED)):
                    b = Gtk.Button(label=bicon)
                    b.get_style_context().add_class('icon-btn')
                    if cls != 'icon-btn':
                        b.get_style_context().add_class(cls)
                    b.set_tooltip_text(tip)
                    b.set_sensitive(ok)
                    b.set_valign(Gtk.Align.CENTER)
                    b.connect('clicked', cb)
                    r.pack_start(b, False, False, 0)
                self.bar_mods.pack_start(r, False, False, 0)
        self.bar_mods.show_all()

        for ch in self.bar_flow.get_children():
            ch.destroy()
        active = set(barconf.active_modules(conf))
        for mod, icon, name, desc in barconf.CATALOG:
            if mod in active:
                continue
            b = Gtk.Button()
            b.get_style_context().add_class('dock-pick')
            b.set_tooltip_text(desc)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            ic = Gtk.Label(label=icon)
            ic.get_style_context().add_class('style-icon')
            box.pack_start(ic, False, False, 0)
            box.pack_start(Gtk.Label(label=name), False, False, 0)
            b.add(box)
            b.connect('clicked', lambda *_, m=mod, n=name: self.bar_add(m, n))
            self.bar_flow.add(b)
        self.bar_flow.show_all()

    def bar_edit(self, fn, msg):
        conf = barconf.load()
        fn(conf['modules'])
        barconf.save(conf)
        self.bar_fill()
        self.bar_apply(msg)

    def bar_move(self, sect, i, d):
        def f(m):
            lst = m[sect]
            j = i + d
            if 0 <= j < len(lst):
                lst[i], lst[j] = lst[j], lst[i]
        self.bar_edit(f, 'Module order updated')

    def bar_send(self, sect, i):
        nxt = self.SECTS[(self.SECTS.index(sect) + 1) % 3]

        def f(m):
            m[nxt].append(m[sect].pop(i))
        self.bar_edit(f, f'Module moved to {nxt}')

    def bar_remove(self, sect, i):
        self.bar_edit(lambda m: m[sect].pop(i), 'Module removed')

    def bar_add(self, mod, name):
        sect = self.bar_add_to.get_active_id() or 'right'

        def f(m):
            lst = m[sect]
            tail = next((k for k, x in enumerate(lst) if x in ('modules_help', 'power')), len(lst))
            lst.insert(tail if sect == 'right' else len(lst), mod)
        self.bar_edit(f, f'{name} added to {sect}')

    def page_notifications(self):
        p = self.page()
        cfg = self.cfg
        c = self.card('󰩷', 'Placement')
        origins = ['top-left', 'top-center', 'top-right', 'left-center', 'center', 'right-center',
                   'bottom-left', 'bottom-center', 'bottom-right']
