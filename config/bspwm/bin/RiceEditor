# ═════════════════════════════════════════════════════════ custom widgets
def rounded(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def pango_text(cr, text, size, bold=False, spacing=0, family=FONT):
    layout = PangoCairo.create_layout(cr)
    layout.set_font_description(Pango.FontDescription(f'{family} {"Bold " if bold else ""}{size}'))
    if spacing:
        attrs = Pango.AttrList()
        attrs.insert(Pango.attr_letter_spacing_new(int(spacing * Pango.SCALE)))
        layout.set_attributes(attrs)
    layout.set_text(text, -1)
    return layout


def draw_text(cr, text, x, y, size, rgba, bold=False, align='left', spacing=0, family=FONT):
    layout = pango_text(cr, text, size, bold, spacing, family)
    w, h = layout.get_pixel_size()
    if align == 'center':
        x -= w / 2
    elif align == 'right':
        x -= w
    cr.move_to(x, y)
    cr.set_source_rgba(*rgba)
    PangoCairo.show_layout(cr, layout)
    return w, h


def load_surface(path, w, h, crop=True):
    """Image scaled to cover w x h, as a cairo surface (None on failure)."""
    try:
        pix = GdkPixbuf.Pixbuf.new_from_file(path)
    except (GLib.Error, TypeError):
        return None
    pw, ph = pix.get_width(), pix.get_height()
    s = max(w / pw, h / ph) if crop else min(w / pw, h / ph)
    sw, sh = max(1, int(pw * s)), max(1, int(ph * s))
    pix = pix.scale_simple(sw, sh, GdkPixbuf.InterpType.BILINEAR)
    if crop:
        x, y = (sw - w) // 2, (sh - h) // 2
        pix = pix.new_subpixbuf(max(0, x), max(0, y), min(w, sw), min(h, sh))
    return Gdk.cairo_surface_create_from_pixbuf(pix, 1, None)


class Animated(Gtk.DrawingArea):
    """DrawingArea redrawn at a fixed rate while mapped."""

    def __init__(self, app, fps=30):
        super().__init__()
        self.app = app
        self._fps = fps
        self._timer = None
        self.connect('map', self._on_map)
        self.connect('unmap', self._on_unmap)
        self.connect('draw', lambda w, cr: self.paint(cr, w.get_allocated_width(),
                                                      w.get_allocated_height()) or True)

    def _on_map(self, *_):
        if self._timer is None:
            self._timer = GLib.timeout_add(int(1000 / self._fps), self._tick)

    def _on_unmap(self, *_):
        if self._timer:
            GLib.source_remove(self._timer)
            self._timer = None

    def _tick(self):
        self.queue_draw()
        return True

    @property
    def c(self):
        return self.app.rgb

    def paint(self, cr, w, h):
        pass


class NeonLogo(Animated):
    def __init__(self, app, path, size=132):
        super().__init__(app, fps=30)
        self.set_size_request(size, size)
        self.surface = load_surface(path, size - 34, size - 34) if os.path.exists(path) else None

    def paint(self, cr, w, h):
        t = time.monotonic()
        cx, cy, r = w / 2, h / 2, min(w, h) / 2 - 4
        acc, acc2 = self.c['blue'], self.c['magenta']
        glow = cairo.RadialGradient(cx, cy, r * 0.6, cx, cy, r + 4)
        glow.add_color_stop_rgba(0, *acc, 0.0)
        glow.add_color_stop_rgba(0.8, *acc, 0.12 + 0.06 * math.sin(t * 2))
        glow.add_color_stop_rgba(1, *acc, 0)
        cr.set_source(glow)
        cr.paint()
        # avatar
        ir = r - 13
        cr.save()
        cr.arc(cx, cy, ir, 0, 2 * math.pi)
        cr.clip()
        if self.surface:
            cr.set_source_surface(self.surface, cx - self.surface.get_width() / 2,
                                  cy - self.surface.get_height() / 2)
            cr.paint()
        else:
            cr.set_source_rgb(*self.c['black'])
            cr.paint()
            draw_text(cr, '', cx, cy - 22, 26, (*acc, 1), align='center')
        cr.restore()
        # rotating HUD rings
        cr.set_line_width(2.5)
        for i in range(3):
            a0 = t * 1.2 + i * 2 * math.pi / 3
            cr.arc(cx, cy, r - 4, a0, a0 + 1.4)
            cr.set_source_rgba(*acc, 0.95)
            cr.stroke()
        cr.set_line_width(1.2)
        for i in range(24):
            a = -t * 0.5 + i * 2 * math.pi / 24
            cr.arc(cx, cy, r, a, a + 0.12)
            cr.set_source_rgba(*acc2, 0.7)
            cr.stroke()
        cr.arc(cx, cy, ir + 2, 0, 2 * math.pi)
        cr.set_source_rgba(*acc, 0.35)
        cr.stroke()


class HudHeader(Animated):
    GLYPHS = '!<>-_\\/[]{}=+*^?#01ABCDEFXZ'

    def __init__(self, app):
        super().__init__(app, fps=24)
        self.set_size_request(-1, 84)
        self.icon, self.title, self.sub = '', '', ''
        self.t_change = 0

    def set_section(self, icon, title, sub):
        self.icon, self.title, self.sub = icon, title, sub
        self.t_change = time.monotonic()

    def decrypted(self, now):
        p = min(1.0, (now - self.t_change) / 0.5)
        n = int(len(self.title) * p)
        rnd = random.Random(int(now * 30))
        return self.title[:n] + ''.join(rnd.choice(self.GLYPHS) if ch != ' ' else ' '
                                        for ch in self.title[n:])

    def paint(self, cr, w, h):
        now = time.monotonic()
        acc, acc2, fg = self.c['blue'], self.c['magenta'], self.c['fg']
        x = 26
        draw_text(cr, self.icon, x, 16, 20, (*acc2, 1))
        draw_text(cr, self.decrypted(now), x + 44, 14, 18, (*fg, 1), bold=True, spacing=4)
        draw_text(cr, self.sub, x + 46, 48, 8, (*fg, 0.45), spacing=1)
        # clock
        cw, _ = draw_text(cr, time.strftime('%H:%M:%S'), w - 26, 12, 17, (*acc, 1), bold=True,
                          align='right', spacing=2)
        draw_text(cr, time.strftime('%a %d %b %Y').upper(), w - 26, 44, 8, (*fg, 0.5),
                  align='right', spacing=2)
        # system status blinker
        lx = w - 26 - cw - 74
        blink = 0.4 + 0.6 * (0.5 + 0.5 * math.sin(now * 4))
        cr.arc(lx, 27, 4, 0, 2 * math.pi)
        cr.set_source_rgba(*self.c['green'], blink)
        cr.fill()
        draw_text(cr, 'LIVE', lx + 10, 20, 8, (*self.c['green'], 0.85), bold=True, spacing=2)
        # baseline with scanner
        y = h - 8
        lg = cairo.LinearGradient(x, 0, w - x, 0)
        lg.add_color_stop_rgba(0, *acc, 0.85)
        lg.add_color_stop_rgba(0.55, *acc2, 0.35)
        lg.add_color_stop_rgba(1, *acc, 0.03)
        cr.set_line_width(1)
        cr.move_to(x, y)
        cr.line_to(w - x, y)
        cr.set_source(lg)
        cr.stroke()
        sx = x + ((now * 0.3) % 1.0) * (w - 2 * x)
        sg = cairo.LinearGradient(sx - 80, 0, sx, 0)
        sg.add_color_stop_rgba(0, *acc2, 0)
        sg.add_color_stop_rgba(1, *acc2, 0.9)
        cr.rectangle(sx - 80, y - 1, 80, 2)
        cr.set_source(sg)
        cr.fill()
        # ticks
        for i in range(0, int(w - 2 * x), 42):
            cr.rectangle(x + i, y + 3, 1, 3)
        cr.set_source_rgba(*fg, 0.12)
        cr.fill()


class Gauge(Animated):
    def __init__(self, app, label, icon):
        super().__init__(app, fps=20)
        self.set_size_request(150, 150)
        self.label, self.icon = label, icon
        self.value = 0.0
        self.shown = 0.0
        self.detail = ''

    def paint(self, cr, w, h):
        self.shown += (self.value - self.shown) * 0.12
        t = time.monotonic()
        cx, cy = w / 2, h / 2 - 6
        r = min(w, h - 20) / 2 - 10
        acc, acc2, fg = self.c['blue'], self.c['magenta'], self.c['fg']
        start, span = math.radians(135), math.radians(270)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_width(8)
        cr.arc(cx, cy, r, start, start + span)
        cr.set_source_rgba(*fg, 0.08)
        cr.stroke()
        v = max(0.0, min(1.0, self.shown / 100))
        col = self.c['red'] if v > 0.85 else (self.c['yellow'] if v > 0.65 else acc)
        if v > 0.002:
            for lw, a in ((16, 0.10), (8, 1.0)):
                cr.set_line_width(lw)
                cr.arc(cx, cy, r, start, start + span * v)
                cr.set_source_rgba(*col, a)
                cr.stroke()
        # ticks
        cr.set_line_cap(cairo.LINE_CAP_BUTT)
        cr.set_line_width(1)
        for i in range(28):
            a = start + span * i / 27
            r0, r1 = r - 14, r - (19 if i % 3 == 0 else 16)
            cr.move_to(cx + r0 * math.cos(a), cy + r0 * math.sin(a))
            cr.line_to(cx + r1 * math.cos(a), cy + r1 * math.sin(a))
        cr.set_source_rgba(*fg, 0.22)
        cr.stroke()
        # orbiting dot
        a = t * 1.5
        cr.arc(cx + (r + 9) * math.cos(a), cy + (r + 9) * math.sin(a), 1.8, 0, 2 * math.pi)
        cr.set_source_rgba(*acc2, 0.8)
        cr.fill()
        draw_text(cr, f'{self.shown:.0f}%', cx, cy - 18, 16, (*fg, 1), bold=True, align='center')
        draw_text(cr, self.icon + '  ' + self.label, cx, cy + 10, 8, (*acc, 0.9), bold=True,
                  align='center', spacing=2)
        draw_text(cr, self.detail, cx, h - 20, 7, (*fg, 0.45), align='center')


class Swatches(Gtk.DrawingArea):
    def __init__(self, colors, height=22, radius=5):
        super().__init__()
        self.colors = colors
        self.radius = radius
        self.set_size_request(-1, height)
        self.connect('draw', self.on_draw)

    def on_draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        n = max(1, len(self.colors))
        rounded(cr, 0, 0, W, H, self.radius)
        cr.clip()
        for i, col in enumerate(self.colors):
            cr.rectangle(W * i / n, 0, W / n + 1, H)
            cr.set_source_rgb(*hex_rgb(col))
            cr.fill()
        return True


class PaletteArt(Gtk.DrawingArea):
    """Mini terminal mock painted with a palette."""

    def __init__(self, pal):
        super().__init__()
        self.pal = pal
        self.set_size_request(236, 118)
        self.connect('draw', self.on_draw)

    def on_draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        p = {k: hex_rgb(v) for k, v in self.pal.items() if isinstance(v, str) and v.startswith('#')}
        g = lambda k: p.get(k, (0.5, 0.5, 0.5))  # noqa: E731
        rounded(cr, 0, 0, W, H, 10)
        cr.set_source_rgb(*g('bg'))
        cr.fill()
        rounded(cr, 0, 0, W, 18, 10)
        cr.rectangle(0, 9, W, 9)
        cr.set_source_rgb(*g('black'))
        cr.fill()
        for i, k in enumerate(('red', 'yellow', 'green')):
            cr.arc(12 + i * 13, 9, 3.5, 0, 2 * math.pi)
            cr.set_source_rgb(*g(k))
            cr.fill()
        lines = [[('blue', ' ~/rice '), ('magenta', ' '), ('fg', 'neofetch')],
                 [('green', '✔ '), ('fg', 'bspwm '), ('cyan', 'picom '), ('yellow', 'polybar')],
                 [('red', '✘ '), ('fg', 'error '), ('blackb', '# comment')]]
        y = 26
        for line in lines:
            x = 10
            for key, txt in line:
                tw, _ = draw_text(cr, txt, x, y, 7.5, (*g(key), 1), bold=key != 'fg')
                x += tw
            y += 17
        n = 8
        bw = (W - 20) / n
        for i, k in enumerate(('black', 'red', 'green', 'yellow', 'blue', 'magenta', 'cyan', 'white')):
            rounded(cr, 10 + i * bw + 1, H - 20, bw - 2, 11, 3)
            cr.set_source_rgb(*g(k))
            cr.fill()
        return True


class ImageBox(Gtk.DrawingArea):
    """Rounded image with an optional HUD caption."""

    def __init__(self, app, w, h, caption=''):
        super().__init__()
        self.app = app
        self.set_size_request(w, h)
        self.surface = None
        self.caption = caption
        self.busy = False
        self.connect('draw', self.on_draw)

    def set_image(self, path):
        if not path:
            return

        def load():
            thumb = ensure_thumb(path) if not path.startswith(os.path.join(HOME, '.cache')) else path
            return thumb

        def done(thumb):
            if thumb:
                w, h = self.get_allocated_width(), self.get_allocated_height()
                self.surface = load_surface(thumb, max(w, 320), max(h, 180))
                self.queue_draw()
        run_bg(load, done)

    def on_draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        c = self.app.rgb
        rounded(cr, 0, 0, W, H, 12)
        cr.save()
        cr.clip()
        if self.surface:
            sw, sh = self.surface.get_width(), self.surface.get_height()
            s = max(W / sw, H / sh)
            cr.save()
            cr.scale(s, s)
            cr.set_source_surface(self.surface, (W / s - sw) / 2, (H / s - sh) / 2)
            cr.paint()
            cr.restore()
        else:
            cr.set_source_rgb(*c['black'])
            cr.paint()
        if self.caption:
            lg = cairo.LinearGradient(0, H * 0.55, 0, H)
            lg.add_color_stop_rgba(0, 0, 0, 0, 0)
            lg.add_color_stop_rgba(1, 0, 0, 0, 0.75)
            cr.rectangle(0, 0, W, H)
            cr.set_source(lg)
            cr.fill()
            draw_text(cr, self.caption, 14, H - 26, 8, (*c['fg'], 0.95), bold=True, spacing=2)
        cr.restore()
        rounded(cr, 0.5, 0.5, W - 1, H - 1, 12)
        cr.set_line_width(1)
        cr.set_source_rgba(*c['blue'], 0.5)
        cr.stroke()
        # HUD corners
        cr.set_line_width(2)
        cr.set_source_rgba(*c['magenta'], 0.9)
        L = 16
        for x0, y0, dx, dy in ((4, 4, 1, 1), (W - 4, 4, -1, 1), (W - 4, H - 4, -1, -1), (4, H - 4, 1, -1)):
            cr.move_to(x0, y0 + dy * L)
            cr.line_to(x0, y0)
            cr.line_to(x0 + dx * L, y0)
        cr.stroke()
        return True


class TermPreview(Gtk.DrawingArea):
    """Fake terminal over the wallpaper: shows opacity, font and colors live."""

    def __init__(self, app):
        super().__init__()
        self.app = app
        self.set_size_request(-1, 230)
        self.opacity = 1.0
        self.font = 'JetBrainsMono Nerd Font'
        self.size = 10
        self.wall = None
        self.connect('draw', self.on_draw)
        path = current_wallpaper()
        if path:
            run_bg(lambda: ensure_thumb(path),
                   lambda t: (setattr(self, 'wall', load_surface(t, 640, 360) if t else None),
                              self.queue_draw()))

    def on_draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        c = self.app.rgb
        rounded(cr, 0, 0, W, H, 12)
        cr.clip()
        if self.wall:
            sw, sh = self.wall.get_width(), self.wall.get_height()
            s = max(W / sw, H / sh)
            cr.save()
            cr.scale(s, s)
            cr.set_source_surface(self.wall, 0, 0)
            cr.paint()
            cr.restore()
        # the terminal window
        tx, ty, tw, th = 36, 26, W - 72, H - 52
        rounded(cr, tx + 6, ty + 10, tw, th, 10)
        cr.set_source_rgba(0, 0, 0, 0.35)
        cr.fill()
        rounded(cr, tx, ty, tw, th, 10)
        cr.set_source_rgba(*c['bg'], self.opacity)
        cr.fill()
        rounded(cr, tx, ty, tw, th, 10)
        cr.set_source_rgba(*c['blue'], 0.35)
        cr.set_line_width(1)
        cr.stroke()
        size = max(6, min(18, self.size))
        lh = size * 1.9
        lines = [
            [('blue', ' ~/Documentos '), ('magenta', ' main '), ('green', '❯ '), ('fg', 'fastfetch')],
            [('cyan', 'OS      '), ('fg', 'CachyOS x86_64')],
            [('cyan', 'WM      '), ('fg', 'bspwm'), ('blackb', '  (' + RICE + ')')],
            [('cyan', 'Shell   '), ('fg', 'zsh'), ('yellow', '  '), ('red', '●'), ('green', '●'),
             ('yellow', '●'), ('blue', '●'), ('magenta', '●'), ('cyan', '●')],
            [('blue', ' ~ '), ('green', '❯ '), ('fg', 'echo "hello rice"'), ('fg', '▌')],
        ]
        y = ty + 16
        cr.save()
        rounded(cr, tx, ty, tw, th, 10)
        cr.clip()
        for line in lines:
            x = tx + 16
            for key, txt in line:
                tw_, _ = draw_text(cr, txt, x, y, size, (*c.get(key, c['fg']), 1), family=self.font)
                x += tw_
            y += lh
        cr.restore()
        draw_text(cr, f'{self.font} · {self.size}pt · opacity {self.opacity:.2f}', W - 14, H - 20, 7,
                  (*c['fg'], 0.7), align='right')
        return True


class LockPreview(Animated):
    """Lockscreen mock: cached render + ring/clock at their real positions."""

    def __init__(self, app):
        super().__init__(app, fps=12)
        self.set_size_request(-1, 300)
        self.surface = None
        self.busy = False
        self.opts = {}
        self.reload()

    def reload(self):
        files = sorted(glob.glob(os.path.join(HOME, '.cache/lockscreen/lock-*.png')),
                       key=os.path.getmtime)
        if files:
            run_bg(lambda: files[-1], lambda f: (setattr(self, 'surface', load_surface(f, 960, 540)),
                                                 self.queue_draw()))

    def paint(self, cr, W, H):
        c = self.app.rgb
        o = self.opts
        # keep 16:9 inside the allocation
        pw = min(W, H * 16 / 9)
        ph = pw * 9 / 16
        ox, oy = (W - pw) / 2, (H - ph) / 2
        cr.save()
        rounded(cr, ox, oy, pw, ph, 12)
        cr.clip()
        if self.surface:
            sw, sh = self.surface.get_width(), self.surface.get_height()
            cr.save()
            cr.translate(ox, oy)
            cr.scale(pw / sw, ph / sh)
            cr.set_source_surface(self.surface, 0, 0)
            cr.paint()
            cr.restore()
        else:
            cr.set_source_rgb(*c['black'])
            cr.paint()
        pos = {'center': 0.5, 'right': 0.75}.get(o.get('pos'), 0.25)
        cx = ox + pw * pos
        s = pw / 1920
        clock = time.strftime(o.get('clock', '%H:%M')) if o.get('clock') else time.strftime('%H:%M')
        tcol = hex_rgb(o.get('date'), c['fg'])
        draw_text(cr, clock, cx, oy + ph * 0.36 - 140 * s * 1.25, 140 * s * 0.75, (*tcol, 1),
                  bold=True, align='center')
        draw_text(cr, time.strftime('%a, %d %b'), cx, oy + ph * 0.42 - 45 * s * 1.1, 45 * s * 0.75,
                  (*tcol, 1), align='center')
        ry = oy + ph * 0.56
        rr = 30 * s
        cr.set_line_width(60 * s * 0.25 + 2)
        cr.arc(cx, ry, rr + 6 * s, 0, 2 * math.pi)
        cr.set_source_rgb(*hex_rgb(o.get('ring'), c['black']))
        cr.stroke()
        a = time.monotonic() * 2
        cr.arc(cx, ry, rr + 6 * s, a, a + 0.9)
        cr.set_source_rgb(*hex_rgb(o.get('accent'), c['blue']))
        cr.stroke()
        cr.arc(cx, ry, rr, 0, 2 * math.pi)
        cr.set_source_rgba(*hex_rgb(o.get('bg'), c['bg']), 0.8)
        cr.fill()
        draw_text(cr, o.get('greeter', ''), cx, oy + ph * 0.72 - 10, 23 * s * 0.8,
                  (*hex_rgb(o.get('fg'), c['fg']), 1), align='center')
        if self.busy:
            cr.set_source_rgba(0, 0, 0, 0.55)
            cr.paint()
            dots = '.' * (int(time.monotonic() * 3) % 4)
            draw_text(cr, f'RENDERING{dots}', ox + pw / 2, oy + ph / 2 - 10, 11, (*c['blue'], 1),
                      bold=True, align='center', spacing=3)
        cr.restore()
        rounded(cr, ox + 0.5, oy + 0.5, pw - 1, ph - 1, 12)
        cr.set_line_width(1)
        cr.set_source_rgba(*c['blue'], 0.5)
        cr.stroke()


# ═══════════════════════════════════════════════════════════ main window
class RiceEditor(Gtk.Window):
    SECTIONS = [
        ('dashboard', '󰕮', 'Dashboard', 'SYSTEM OVERVIEW · QUICK ACTIONS'),
        ('palette', '󰏘', 'Palette', 'COLOR SCHEMES OF THE RICE · APPLIED INSTANTLY'),
        ('windows', '󰖲', 'Windows', 'BSPWM · BORDERS · GAPS · BEHAVIOUR'),
        ('compositor', '󰨇', 'Compositor', 'PICOM · CORNERS · SHADOWS · BLUR · OPACITY'),
        ('terminal', '󰆍', 'Terminal', 'KITTY · ALACRITTY · GHOSTTY · SHELL'),
        ('wallpaper', '󰸉', 'Wallpaper', 'ENGINE · GALLERY · 3D SELECTOR'),
        ('notifications', '󰂚', 'Notifications', 'DUNST · PLACEMENT · STYLE · MOTION'),
        ('lockscreen', '󰌾', 'Lockscreen', 'I3LOCK-COLOR · BETTERLOCKSCREEN'),
        ('appearance', '󰉼', 'Appearance', 'GTK · ICONS · CURSOR · ROFI'),
        ('snapshots', '󰁯', 'Snapshots', 'SAVE · RESTORE THE WHOLE RICE STATE'),
        ('help', '󰋗', 'Help', 'SHORTCUTS · HOW IT WORKS'),
    ]

    def __init__(self):
        super().__init__(title=f'Rice Editor: {RICE}')
        self.get_style_context().add_class('rice-editor')
        self.set_default_size(1220, 800)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.cfg = ThemeConfig(THEME_CFG)
        self.timers = {}
        self.loading = True
        self.css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), self.css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        settings = Gtk.Settings.get_default()
        settings.set_property('gtk-application-prefer-dark-theme', True)
        self.load_colors()

        overlay = Gtk.Overlay()
        self.add(overlay)
        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        overlay.add(root)
        root.pack_start(self.build_sidebar(), False, False, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        right.get_style_context().add_class('content')
        self.header = HudHeader(self)
        right.pack_start(self.header, False, False, 0)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_UP_DOWN)
        self.stack.set_transition_duration(320)
        right.pack_start(self.stack, True, True, 0)
        right.pack_start(self.build_statusbar(), False, False, 0)
        root.pack_start(right, True, True, 0)

        # toast
        self.toast_rev = Gtk.Revealer()
        self.toast_rev.set_transition_type(Gtk.RevealerTransitionType.SLIDE_UP)
        self.toast_rev.set_transition_duration(220)
        self.toast_rev.set_halign(Gtk.Align.END)
        self.toast_rev.set_valign(Gtk.Align.END)
        self.toast_rev.set_margin_end(26)
        self.toast_rev.set_margin_bottom(42)
        self.toast_box = Gtk.Box()
        self.toast_box.get_style_context().add_class('toast')
        self.toast_label = Gtk.Label()
        self.toast_box.pack_start(self.toast_label, False, False, 0)
        self.toast_rev.add(self.toast_box)
        overlay.add_overlay(self.toast_rev)
        self.toast_timer = None

        builders = {
            'dashboard': self.page_dashboard, 'palette': self.page_palette,
            'windows': self.page_windows, 'compositor': self.page_compositor,
            'terminal': self.page_terminal, 'wallpaper': self.page_wallpaper,
            'notifications': self.page_notifications, 'lockscreen': self.page_lockscreen,
            'appearance': self.page_appearance, 'snapshots': self.page_snapshots,
            'help': self.page_help,
        }
        for key, *_ in self.SECTIONS:
            page = builders[key]()
            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroller.add(page)
            self.stack.add_named(scroller, key)

        self.connect('key-press-event', self.on_key)
        self.connect('destroy', Gtk.main_quit)
        self.go('dashboard')
        self.loading = False
        GLib.timeout_add_seconds(1, self.update_stats)
        self.auto_snapshot()

    # ──────────────────────────────────────────────────────────── colors
    def load_colors(self):
        names = ['bg', 'fg', 'black', 'blackb', 'red', 'green', 'yellow', 'blue', 'magenta',
                 'cyan', 'white', 'accent_color']
        vals = self.cfg.resolve(names)
        defaults = dict(bg='#1a1b26', fg='#c0caf5', black='#15161e', blackb='#414868',
                        red='#f7768e', green='#9ece6a', yellow='#e0af68', blue='#7aa2f7',
                        magenta='#bb9af7', cyan='#7dcfff', white='#a9b1d6', accent_color='#222330')
        self.hex = {k: vals.get(k) if valid_hex(vals.get(k)) else defaults[k] for k in names}
        self.rgb = {k: hex_rgb(v) for k, v in self.hex.items()}
        self.css.load_from_data(build_css(self.hex).encode())
        if hasattr(self, 'brand'):
            self.paint_brand()
        self.queue_draw()

    def paint_brand(self):
        self.brand.set_markup('RICE<span foreground="{}">//</span>EDITOR'.format(self.hex['blue']))

    # ────────────────────────────────────────────────────────── layout
    def build_sidebar(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.get_style_context().add_class('sidebar')
        box.set_size_request(236, -1)
        logo = NeonLogo(self, os.path.join(BSPWM, 'config/assets/profile.png'))
        logo.set_halign(Gtk.Align.CENTER)
        box.pack_start(logo, False, False, 4)

        self.brand = Gtk.Label()
        self.brand.get_style_context().add_class('brand')
        self.paint_brand()
        box.pack_start(self.brand, False, False, 2)
        chip = Gtk.Label(label=f'◉ {RICE.upper()}')
        chip.get_style_context().add_class('rice-chip')
        chip.set_halign(Gtk.Align.CENTER)
        box.pack_start(chip, False, False, 8)

        self.nav = {}
        for i, (key, icon, title, _sub) in enumerate(self.SECTIONS):
            btn = Gtk.Button()
            btn.get_style_context().add_class('nav')
            inner = Gtk.Box(spacing=10)
            ic = Gtk.Label(label=icon)
            ic.get_style_context().add_class('nav-icon')
            inner.pack_start(ic, False, False, 0)
            lb = Gtk.Label(label=title, xalign=0)
            inner.pack_start(lb, True, True, 0)
            num = Gtk.Label(label=str((i + 1) % 10) if i < 10 else '')
            num.get_style_context().add_class('dim')
            inner.pack_end(num, False, False, 0)
            btn.add(inner)
            btn.connect('clicked', lambda _b, k=key: self.go(k))
            btn.set_tooltip_text(f'Ctrl+{(i + 1) % 10}' if i < 10 else None)
            box.pack_start(btn, False, False, 0)
            self.nav[key] = btn

        bottom = Gtk.Box(spacing=6)
        b1 = self.button('󰑓 Reload', 'neon', lambda *_: self.soft_reload())
        b1.set_tooltip_text('Soft reload: polybar, picom, dunst, sxhkd… (Ctrl+R)')
        b2 = self.button('󰔎 Rebuild', 'ghost', lambda *_: self.full_reload())
        b2.set_tooltip_text('Re-apply the whole rice (Theme.sh)')
        bottom.pack_start(b1, True, True, 0)
        bottom.pack_start(b2, True, True, 0)
        box.pack_end(bottom, False, False, 6)
        return box

    def build_statusbar(self):
        bar = Gtk.Box(spacing=8)
        bar.get_style_context().add_class('statusbar')
        dot = Gtk.Label(label='●')
        dot.get_style_context().add_class('live-dot')
        bar.pack_start(dot, False, False, 0)
        bar.pack_start(Gtk.Label(label='LIVE MODE — every change is applied and saved instantly'),
                       False, False, 0)
        bar.pack_end(Gtk.Label(label=THEME_CFG.replace(HOME, '~')), False, False, 0)
        return bar

    def go(self, key):
        self.stack.set_visible_child_name(key)
        for k, b in self.nav.items():
            ctx = b.get_style_context()
            (ctx.add_class if k == key else ctx.remove_class)('active')
        for k, icon, title, sub in self.SECTIONS:
            if k == key:
                self.header.set_section(icon, title.upper(), sub)
        if key == 'lockscreen':
            self.lock_prev.reload()

    def on_key(self, _w, ev):
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        k = ev.keyval
        if ctrl and k in (Gdk.KEY_q, Gdk.KEY_w):
            self.destroy()
            return True
        if ctrl and Gdk.KEY_0 <= k <= Gdk.KEY_9:
            idx = (k - Gdk.KEY_0 - 1) % 10
            if idx < len(self.SECTIONS):
                self.go(self.SECTIONS[idx][0])
            return True
        if ctrl and k == Gdk.KEY_s:
            self.snapshot_create('manual')
            return True
        if ctrl and k == Gdk.KEY_r:
            self.soft_reload()
            return True
        if ctrl and k == Gdk.KEY_l:
            spawn(['ScreenLocker'])
            return True
        return False

    # ──────────────────────────────────────────────────────── ui helpers
    def toast(self, msg, error=False):
        ctx = self.toast_box.get_style_context()
        (ctx.add_class if error else ctx.remove_class)('error')
        self.toast_label.set_text(('  ' if error else '  ') + msg)
        self.toast_rev.set_reveal_child(True)
        if self.toast_timer:
            GLib.source_remove(self.toast_timer)
        self.toast_timer = GLib.timeout_add(2400, self._hide_toast)

    def _hide_toast(self):
        self.toast_rev.set_reveal_child(False)
        self.toast_timer = None
        return False

    def debounce(self, key, ms, fn):
        if key in self.timers:
            GLib.source_remove(self.timers[key])

        def fire():
            self.timers.pop(key, None)
            fn()
            return False
        self.timers[key] = GLib.timeout_add(ms, fire)

    def page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.get_style_context().add_class('page')
        return box

    def card(self, icon, title, sub=''):
        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        frame.get_style_context().add_class('card')
        head = Gtk.Box(spacing=10)
        ic = Gtk.Label(label=icon)
        ic.get_style_context().add_class('card-icon')
        head.pack_start(ic, False, False, 0)
        tl = Gtk.Label(label=title.upper(), xalign=0)
        tl.get_style_context().add_class('card-title')
        head.pack_start(tl, False, False, 0)
        if sub:
            sl = Gtk.Label(label=sub, xalign=1)
            sl.get_style_context().add_class('card-sub')
            head.pack_end(sl, False, False, 0)
        frame.pack_start(head, False, False, 4)
        return frame

    def row(self, title, desc, *widgets):
        r = Gtk.Box(spacing=12)
        r.get_style_context().add_class('row')
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        t = Gtk.Label(label=title, xalign=0)
        t.get_style_context().add_class('row-title')
        texts.pack_start(t, False, False, 0)
        if desc:
            d = Gtk.Label(label=desc, xalign=0)
            d.set_line_wrap(True)
            d.get_style_context().add_class('row-desc')
            texts.pack_start(d, False, False, 0)
        texts.set_valign(Gtk.Align.CENTER)
        r.pack_start(texts, True, True, 0)
        for wdg in reversed(widgets):
            wdg.set_valign(Gtk.Align.CENTER)
            r.pack_end(wdg, False, False, 0)
        return r

    def button(self, label, cls, cb):
        b = Gtk.Button(label=label)
        b.get_style_context().add_class(cls)
        b.connect('clicked', cb)
        return b

    def scale(self, lo, hi, step, value, digits, on_change, fmt=None, delay=180):
        sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        sc.set_draw_value(False)
        sc.set_digits(digits)
        try:
            sc.set_value(float(value))
        except (TypeError, ValueError):
            sc.set_value(lo)
        lab = Gtk.Label(xalign=1)
        lab.get_style_context().add_class('value')
        fmt = fmt or (lambda v: f'{v:.{digits}f}')
        lab.set_text(fmt(sc.get_value()))

        def changed(s):
            v = round(s.get_value(), digits) if digits else int(round(s.get_value()))
            lab.set_text(fmt(v))
            if not self.loading:
                self.debounce(id(s), delay, lambda: on_change(v))
        sc.connect('value-changed', changed)
        return sc, lab

    def switch(self, active, on_change):
        sw = Gtk.Switch()
        sw.set_active(bool(active))

        def changed(s, _p):
            if not self.loading:
                on_change(s.get_active())
        sw.connect('notify::active', changed)
        return sw

    def color(self, hexv, on_change):
        rgba = Gdk.RGBA()
        rgba.parse(hexv if valid_hex(hexv) else '#000000')
        cb = Gtk.ColorButton.new_with_rgba(rgba)
        entry = Gtk.Entry()
        entry.set_width_chars(8)
        entry.set_max_length(7)
        entry.set_text(hexv if valid_hex(hexv) else '')

        def picked(b):
            h = rgba_hex(b.get_rgba())
            entry.set_text(h)
            on_change(h)

        def typed(e):
            h = e.get_text().strip()
            if valid_hex(h):
                r = Gdk.RGBA()
                r.parse(h)
                cb.set_rgba(r)
                on_change(h)
        cb.connect('color-set', picked)
        entry.connect('activate', typed)
        box = Gtk.Box(spacing=6)
        box.pack_start(entry, False, False, 0)
        box.pack_start(cb, False, False, 0)
        return box

    def combo(self, items, active, on_change):
        cb = Gtk.ComboBoxText()
        for item_id, label in items:
            cb.append(item_id, label)
        if not cb.set_active_id(active):
            cb.set_active(0)

        def changed(c):
            if not self.loading:
                on_change(c.get_active_id())
        cb.connect('changed', changed)
        return cb

    def spin(self, lo, hi, value, on_change):
        sp = Gtk.SpinButton.new_with_range(lo, hi, 1)
        try:
            sp.set_value(float(value))
        except (TypeError, ValueError):
            pass

        def changed(s):
            if not self.loading:
                self.debounce(id(s), 300, lambda: on_change(int(s.get_value())))
        sp.connect('value-changed', changed)
        return sp

    def fontbutton(self, font, on_change, mono=False):
        """Button showing the font string; opens a font chooser."""
        b = Gtk.Button(label=f'󰛖  {font}')
        b.get_style_context().add_class('neon')

        def pick(_b):
            dlg = Gtk.FontChooserDialog(title='Select font', transient_for=self)
            dlg.set_font(font)
            if mono:
                dlg.set_filter_func(lambda family, face: family.is_monospace())
            if dlg.run() == Gtk.ResponseType.OK and dlg.get_font():
                desc = Pango.FontDescription.from_string(dlg.get_font())
                size = max(1, int(desc.get_size() / Pango.SCALE))
                full = dlg.get_font()
                b.set_label(f'󰛖  {full}')
                on_change(desc.get_family(), size, full)
            dlg.destroy()
        b.connect('clicked', pick)
        return b

    # ─────────────────────────────────────────────────────── actions
    def soft_reload(self):
        spawn([os.path.join(BIN, 'SoftReload')])
        self.toast('Environment soft-reloaded')

    def full_reload(self, msg='Rice rebuilt'):
        spawn([os.path.join(BIN, 'Theme.sh')])
        self.toast(msg)

    def apply_modules(self, msg, *mods, reload_picom=False):
        run_bg(lambda: run_modules(*mods, reload_picom=reload_picom), lambda _r: self.toast(msg))

