        dirs = [(x, x) for x in ('up', 'down', 'left', 'right')]
        c.pack_start(self.row('Open animation', '',
                              self.combo(presets_in, cfg.raw('dunst_open_preset', 'fly-in'),
                                         lambda v: self.set_dunst('dunst_open_preset', v, 'Open animation', picom=True)),
                              self.combo(dirs, cfg.raw('dunst_open_direction', 'up'),
                                         lambda v: self.set_dunst('dunst_open_direction', v, 'Open direction', picom=True))),
                     False, False, 0)
        c.pack_start(self.row('Close animation', '',
                              self.combo(presets_out, cfg.raw('dunst_close_preset', 'fly-out'),
                                         lambda v: self.set_dunst('dunst_close_preset', v, 'Close animation', picom=True)),
                              self.combo(dirs, cfg.raw('dunst_close_direction', 'up'),
                                         lambda v: self.set_dunst('dunst_close_direction', v, 'Close direction', picom=True))),
                     False, False, 0)
        c.pack_start(self.row('Try it', 'Send a sample notification',
                              self.button('󰂚  Test notification', 'neon', lambda *_: self.test_notify())),
                     False, False, 0)
        p.pack_start(c, False, False, 0)
        return p

    def set_dunst(self, var, value, title, picom=False):
        self.cfg.set(var, value)
        mods = ('04-dunst.sh', '00-picom.sh') if picom else ('04-dunst.sh',)
        run_bg(lambda: run_modules(*mods, reload_picom=picom),
               lambda _r: (self.toast(f'{title} → {value}'), self.test_notify(quiet=True)))

    def set_dunst_offset(self, idx, v):
        self._dunst_off[idx] = v
        self.set_dunst('dunst_offset', f'({self._dunst_off[0]}, {self._dunst_off[1]})', 'Offset')

    def test_notify(self, quiet=False):
        spawn(['notify-send', '-a', 'RiceEditor', '-i', 'preferences-desktop-theme',
               'RiceEditor', 'This is how your notifications look now ✨'])
        if not quiet:
            self.toast('Test notification sent')

    # ────────────────────────────────────────────────────── lockscreen
    def page_lockscreen(self):
        p = self.page()
        cfg = self.cfg
        c = self.card('󰍹', 'Preview', 'real render of your wallpaper')
        self.lock_prev = LockPreview(self)
        self.refresh_lock_opts()
        c.pack_start(self.lock_prev, False, False, 4)
        hb = Gtk.Box(spacing=8)
        hb.pack_start(self.button('󰌾  Lock now', 'neon', lambda *_: spawn(['ScreenLocker'])), False, False, 0)
        hb.pack_start(self.button('󰑓  Re-render', 'ghost', lambda *_: self.rerender_lock()), False, False, 0)
        hb.pack_start(self.button('󰔎  Random wall', 'ghost', lambda *_: spawn(['ScreenLocker', '--rice'])),
                      False, False, 0)
        c.pack_start(hb, False, False, 6)
        p.pack_start(c, False, False, 0)

        c = self.card('󰋩', 'Background')
        sc, lab = self.scale(0, 30, 1, cfg.raw('LOCK_BLUR', '0'), 0, lambda v: self.set_lock('LOCK_BLUR', v, True))
        c.pack_start(self.row('Blur', '0 = sharp wallpaper', sc, lab), False, False, 0)
        sc, lab = self.scale(0, 80, 5, cfg.raw('LOCK_DIM', '20'), 0, lambda v: self.set_lock('LOCK_DIM', v, True),
                             fmt=lambda v: f'{int(v)}%')
        c.pack_start(self.row('Dim', 'Darken the wallpaper for readability', sc, lab), False, False, 0)
        c.pack_start(self.row('Glass panel', 'Frosted HUD panel behind the clock',
                              self.switch(cfg.raw('LOCK_GLASS', 'true') == 'true',
                                          lambda on: self.set_lock('LOCK_GLASS', 'true' if on else 'false', True))),
                     False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰥔', 'Clock & ring')
        c.pack_start(self.row('Position', '',
                              self.combo([('left', 'left'), ('center', 'center'), ('right', 'right')],
                                         cfg.raw('LOCK_POS', 'left'), lambda v: self.set_lock('LOCK_POS', v, True))),
                     False, False, 0)
        c.pack_start(self.row('Clock format', '',
                              self.combo([('%H:%M', '24h  ·  18:30'), ('%H:%M:%S', '24h  ·  18:30:05'),
                                          ('%I:%M %p', '12h  ·  06:30 PM')],
                                         cfg.raw('LOCK_CLOCK', '%H:%M'), lambda v: self.set_lock('LOCK_CLOCK', v))),
                     False, False, 0)
        entry = Gtk.Entry()
        entry.set_width_chars(30)
        entry.set_text(cfg.raw('LOCK_GREETER', 'Type the password to Unlock'))
        entry.connect('changed', lambda e: self.debounce('greeter', 500,
                                                         lambda: self.set_lock('LOCK_GREETER', e.get_text())))
        c.pack_start(self.row('Greeter text', '', entry), False, False, 0)
        res = cfg.resolve(['LOCK_ACCENT', 'sl_ring', 'sl_verify', 'sl_wrong', 'sl_date'])
        for var, title in (('LOCK_ACCENT', 'Accent (keypress & glass border)'), ('sl_ring', 'Ring'),
                           ('sl_verify', 'Verifying'), ('sl_wrong', 'Wrong password'), ('sl_date', 'Clock & date')):
            c.pack_start(self.row(title, '', self.color(res.get(var, ''),
                                                        lambda h, v=var: self.set_lock(v, h, v == 'LOCK_ACCENT'))),
                         False, False, 0)
        p.pack_start(c, False, False, 0)
        return p

    def refresh_lock_opts(self):
        r = self.cfg.resolve(['LOCK_POS', 'LOCK_CLOCK', 'LOCK_GREETER', 'LOCK_ACCENT', 'sl_ring',
                              'sl_date', 'sl_bg', 'sl_fg'])
        self.lock_prev.opts = dict(pos=r.get('LOCK_POS'), clock=r.get('LOCK_CLOCK'),
                                   greeter=r.get('LOCK_GREETER'), accent=r.get('LOCK_ACCENT'),
                                   ring=r.get('sl_ring'), date=r.get('sl_date'), bg=r.get('sl_bg'),
                                   fg=r.get('sl_fg'))

    def set_lock(self, var, value, rerender=False):
        self.cfg.set(var, value)
        self.refresh_lock_opts()
        self.toast(f'Lockscreen · {var} → {value}')
        if rerender:
            self.debounce('lock-render', 400, self.rerender_lock)
        else:
            run_bg(lambda: run_modules('07-screenlocker.sh'))

    def rerender_lock(self):
        self.lock_prev.busy = True

        def work():
            run_modules('07-screenlocker.sh')
            subprocess.run(['ScreenLocker', '--prepare'], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=120)

        def done(_r):
            self.lock_prev.busy = False
            self.lock_prev.reload()
        run_bg(work, done)

    # ────────────────────────────────────────────────────── appearance
    @staticmethod
    def list_themes(kind):
        bases = [os.path.join(HOME, '.themes'), os.path.join(HOME, '.local/share/themes'), '/usr/share/themes'] \
            if kind == 'gtk' else [os.path.join(HOME, '.icons'), os.path.join(HOME, '.local/share/icons'),
                                   '/usr/share/icons']
        found = set()
        for b in bases:
            for d in glob.glob(os.path.join(b, '*')):
                n = os.path.basename(d)
                if kind == 'gtk':
                    ok = os.path.isdir(os.path.join(d, 'gtk-3.0'))
                elif kind == 'cursor':
                    ok = os.path.isdir(os.path.join(d, 'cursors'))
                else:  # icon themes: index.theme plus real icon folders
                    ok = os.path.exists(os.path.join(d, 'index.theme')) and any(
                        e.is_dir() and e.name != 'cursors' for e in os.scandir(d))
                if ok:
                    found.add(n)
        found.discard('default')
        return sorted(found, key=str.lower)

    def page_appearance(self):
        p = self.page()
        res = self.cfg.resolve(['gtk_theme', 'gtk_icons', 'gtk_cursor', 'rofi_font'])
        c = self.card('󰉼', 'GTK', 'xsettingsd · applied live')
        for var, kind, title in (('gtk_theme', 'gtk', 'GTK theme'), ('gtk_icons', 'icons', 'Icon theme'),
                                 ('gtk_cursor', 'cursor', 'Cursor theme')):
            items = self.list_themes(kind)
            cur = res.get(var, '')
            if cur and cur not in items:
                items.insert(0, cur)
            c.pack_start(self.row(title, '', self.combo([(i, i) for i in items], cur,
                                                        lambda v, vv=var, t=title: self.set_gtk(vv, v, t))),
                         False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰍉', 'Rofi', 'launcher · menus')
        fb = self.fontbutton(res.get('rofi_font') or 'JetBrainsMono NF Bold 9',
                             lambda _f, _s, full: self.set_rofi_font(full))
        c.pack_start(self.row('Menu font', 'Used by every rofi menu of the rice', fb), False, False, 0)
        p.pack_start(c, False, False, 0)
        return p

    def set_gtk(self, var, value, title):
        self.cfg.set(var, value)
        self.apply_modules(f'{title} → {value}', '03-gtk.sh')

    def set_rofi_font(self, full):
        self.cfg.set('rofi_font', full)
        self.apply_modules(f'Rofi font → {full}', '04-rofi.sh')

    # ─────────────────────────────────────────────────────── snapshots
    SNAP_FILES = [('theme-config.bash', THEME_CFG), ('picom.conf', PICOM_CONF),
                  ('picom-rules.conf', PICOM_RULES), ('bspwmrc', BSPWMRC), ('kitty.conf', KITTY_CONF)]

    def page_snapshots(self):
        p = self.page()
        c = self.card('󰁯', 'Save state', 'theme-config · picom · bspwmrc · kitty')
        self.snap_entry = Gtk.Entry()
        self.snap_entry.set_placeholder_text('snapshot name (optional)')
        self.snap_entry.set_width_chars(30)
        self.snap_entry.connect('activate', lambda e: self.snapshot_create(e.get_text() or 'manual'))
        c.pack_start(self.row('New snapshot', 'Freeze the current rice so you can come back to it (Ctrl+S)',
                              self.snap_entry,
                              self.button('󰆓  Save', 'neon',
                                          lambda *_: self.snapshot_create(self.snap_entry.get_text() or 'manual'))),
                     False, False, 0)
        p.pack_start(c, False, False, 0)
        self.snap_card = self.card('󰋚', 'Timeline', 'restore re-applies the whole rice')
        self.snap_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.snap_card.pack_start(self.snap_list, False, False, 0)
        p.pack_start(self.snap_card, False, False, 0)
        self.refresh_snapshots()
        return p

    def snapshots(self):
        base = os.path.join(SNAP_DIR, RICE)
        try:
            return sorted((d for d in os.listdir(base) if os.path.isdir(os.path.join(base, d))), reverse=True)
        except OSError:
            return []

    def snapshot_create(self, label, quiet=False):
        label = re.sub(r'[^\w-]+', '-', label.strip())[:40] or 'manual'
        name = f'{datetime.now():%Y%m%d-%H%M%S}__{label}'
        dest = os.path.join(SNAP_DIR, RICE, name)
        os.makedirs(dest, exist_ok=True)
        for fname, src in self.SNAP_FILES:
            if os.path.exists(src):
                shutil.copy2(src, os.path.join(dest, fname))
        if not quiet:
            self.toast(f'Snapshot "{label}" saved')
            if hasattr(self, 'snap_entry'):
                self.snap_entry.set_text('')
        if hasattr(self, 'snap_list'):
            self.refresh_snapshots()

    def auto_snapshot(self):
        today = f'{datetime.now():%Y%m%d}'
        if not any(s.startswith(today) and s.endswith('__auto') for s in self.snapshots()):
            self.snapshot_create('auto', quiet=True)
        # keep at most 10 automatic ones
        autos = [s for s in self.snapshots() if s.endswith('__auto')]
        for old in autos[10:]:
            shutil.rmtree(os.path.join(SNAP_DIR, RICE, old), ignore_errors=True)
        self.refresh_snapshots()

    def refresh_snapshots(self):
        for ch in self.snap_list.get_children():
            self.snap_list.remove(ch)
        snaps = self.snapshots()
        if not snaps:
            lb = Gtk.Label(label='No snapshots yet.', xalign=0)
            lb.get_style_context().add_class('dim')
            self.snap_list.pack_start(lb, False, False, 6)
        for s in snaps:
            stamp, _, label = s.partition('__')
            try:
                when = datetime.strptime(stamp, '%Y%m%d-%H%M%S').strftime('%d %b %Y · %H:%M:%S')
            except ValueError:
                when = stamp
            icon = '󰁯' if label == 'auto' else '󰆓'
            self.snap_list.pack_start(self.row(f'{icon}  {label.upper()}', when,
                                               self.button('Restore', 'neon', lambda *_, n=s: self.snapshot_restore(n)),
                                               self.button('Delete', 'danger', lambda *_, n=s: self.snapshot_delete(n))),
                                      False, False, 0)
        self.snap_list.show_all()

    def snapshot_restore(self, name):
        src = os.path.join(SNAP_DIR, RICE, name)
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.OK_CANCEL,
                                text=f'Restore snapshot {name.partition("__")[2]}?')
        dlg.format_secondary_text('The current state is saved first as "before-restore", so you can go back.')
        ok = dlg.run() == Gtk.ResponseType.OK
        dlg.destroy()
        if not ok:
            return
        self.snapshot_create('before-restore', quiet=True)
        for fname, dst in self.SNAP_FILES:
            f = os.path.join(src, fname)
            if os.path.exists(f):
                shutil.copy2(f, dst)
        self.load_colors()
        # bspwmrc re-runs Theme.sh, so this re-applies everything
        spawn(['bspc', 'wm', '-r'])
        self.toast('Snapshot restored — reopen RiceEditor to refresh every value')

    def snapshot_delete(self, name):
        shutil.rmtree(os.path.join(SNAP_DIR, RICE, name), ignore_errors=True)
        self.refresh_snapshots()
        self.toast('Snapshot deleted')

    # ──────────────────────────────────────────────────────────── help
    def page_help(self):
        p = self.page()
        c = self.card('󰌌', 'Shortcuts')
        for keys, what in (('Ctrl + 1 … 0', 'Jump to a section'), ('Ctrl + S', 'Save a snapshot'),
                           ('Ctrl + R', 'Soft reload (bars, picom, dunst, sxhkd)'),
                           ('Ctrl + L', 'Lock the screen'), ('Ctrl + Q', 'Close RiceEditor')):
            k = Gtk.Label(label=keys)
            k.get_style_context().add_class('value')
            c.pack_start(self.row(what, '', k), False, False, 0)
        p.pack_start(c, False, False, 0)
        c = self.card('󰋗', 'How it works')
        text = (
            f'• Everything you touch is written to {THEME_CFG.replace(HOME, "~")} (or picom.conf /\n'
            '  bspwmrc for global options) and applied at once: bspc for windows, a picom reload\n'
            '  for the compositor, and the rice modules for dunst, gtk, rofi and terminals.\n'
            '• You always edit the rice that was active when RiceEditor opened. After switching\n'
            '  rice, close and reopen it.\n'
            '• A snapshot is taken automatically the first time you open RiceEditor each day,\n'
            '  so a bad tweak is always one click away from being undone (Snapshots).\n'
            '• Palettes come from theme_colors.bash; the editor itself follows the active one.')
        lb = Gtk.Label(label=text, xalign=0)
        lb.get_style_context().add_class('dim')
        c.pack_start(lb, False, False, 4)
        p.pack_start(c, False, False, 0)
        return p


def main():
    GLib.set_prgname('RiceEditor')
    app = RiceEditor()
    app.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
