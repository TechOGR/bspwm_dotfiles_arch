    def set_bl(self, var, value, render=True, idle=False):
        self.cfg.set(var, value)
        self.toast(f'Login lock · {var} → {value}')
        if render:
            self.debounce('bl-render', 450, self.bl_render)
        else:
            run_bg(lambda: subprocess.run([BETTERLOCK, '--config'], timeout=30))
        if idle:
            run_bg(lambda: subprocess.run([BETTERLOCK, '--idle'], timeout=30))

    def bl_choose_wall(self):
        dlg = Gtk.FileChooserDialog(title='Lock picture', parent=self, action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Select', Gtk.ResponseType.OK)
        flt = Gtk.FileFilter()
        flt.set_name('Pictures')
        for ext in ('png', 'jpg', 'jpeg', 'webp'):
            flt.add_pattern(f'*.{ext}')
            flt.add_pattern(f'*.{ext.upper()}')
        dlg.add_filter(flt)
        cur = self.cfg.raw('BL_WALL_PATH')
        if cur and os.path.isfile(cur):
            dlg.set_filename(cur)
        elif os.path.isdir(os.path.join(RICE_DIR, 'walls')):
            dlg.set_current_folder(os.path.join(RICE_DIR, 'walls'))
        path = dlg.get_filename() if dlg.run() == Gtk.ResponseType.OK else None
        dlg.destroy()
        if path:
            self.bl_file.set_label(f'󰋩  {os.path.basename(path)}')
            self.bl_pick_wall(path)

    def bl_pick_wall(self, path):
        if not path:
            return
        self.cfg.set('BL_WALL_PATH', path)
        if self.bl_src.get_active_id() == 'custom':
            self.set_bl('BL_WALL', 'custom')
        else:
            self.bl_src.set_active_id('custom')   # its handler saves BL_WALL + re-renders

    def bl_palette_colors(self):
        for var, ref in (('BL_ACCENT', 'blue'), ('BL_ACCENT2', 'magenta'), ('BL_FG', 'fg'),
                         ('BL_VERIFY', 'green'), ('BL_WRONG', 'red')):
            # cfg.set() strips "$": write the palette reference by hand
            if not file_sub(THEME_CFG, rf'^{var}=("[^"]*"|\S*)', f'{var}="${{{ref}}}"'):
                with open(THEME_CFG, 'a') as f:
                    f.write(f'{var}="${{{ref}}}"\n')
        self.toast('Login lock colors follow the palette — reopen the section to see them')
        self.bl_render()

    def bl_render(self):
        self.bl_prev.busy = True

        def work():
            subprocess.run([BETTERLOCK, '--preview', BL_PREVIEW], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=120)

        def done(_r):
            self.bl_prev.busy = False
            self.bl_prev.reload()
            # the real lock image + betterlockscreenrc, in the background
            spawn(['nice', '-n', '19', BETTERLOCK, '--prepare'])
        run_bg(work, done)

    # ────────────────────────────────────────────────────── appearance
    @staticmethod
    def list_themes(kind):
        bases = [os.path.join(HOME, '.themes'), os.path.join(HOME, '.local/share/themes'), '/usr/share/themes'] \
            if kind == 'gtk' else [os.path.join(HOME, '.icons'), os.path.join(HOME, '.local/share/icons'),
                                   '/usr/share/icons']
        found = set()
        for b in bases:
            for d in glob.glob(os.path.join(b, '*')):
                n = os.path.basename(d)
                if kind == 'gtk':
                    ok = os.path.isdir(os.path.join(d, 'gtk-3.0'))
                elif kind == 'cursor':
                    ok = os.path.isdir(os.path.join(d, 'cursors'))
                else:  # icon themes: index.theme plus real icon folders
                    ok = os.path.exists(os.path.join(d, 'index.theme')) and any(
                        e.is_dir() and e.name != 'cursors' for e in os.scandir(d))
                if ok:
                    found.add(n)
        found.discard('default')
        return sorted(found, key=str.lower)

    def page_appearance(self):
        p = self.page()
        c = self.card('󰀄', 'Avatar', 'UserCard · RiceEditor · picture or ASCII art')
        conf = avatar.load() if avatar else {}
