        sx = self.spin(0, 600, ox, lambda v: self.set_dunst_offset(0, v))
        sy = self.spin(0, 600, oy, lambda v: self.set_dunst_offset(1, v))
        c.pack_start(self.row('Offset', 'Horizontal · vertical distance from the edge', sx, sy), False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰏘', 'Style')
        sc, lab = self.scale(0, 30, 1, cfg.raw('dunst_corner_radius', '6'), 0,
                             lambda v: self.set_dunst('dunst_corner_radius', v, 'Corner radius'))
        c.pack_start(self.row('Corner radius', '', sc, lab), False, False, 0)
        sc, lab = self.scale(0, 100, 5, cfg.raw('dunst_transparency', '0'), 0,
