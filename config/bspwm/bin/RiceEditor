        frame = self.cfg.resolve(['dunst_frame_color']).get('dunst_frame_color', '#000000')
        c.pack_start(self.row('Border color', '', self.color(frame, lambda h: self.set_dunst('dunst_frame_color', h, 'Border color'))),
                     False, False, 0)
        fb = self.fontbutton(cfg.raw('dunst_font', 'JetBrainsMono NF Medium 9'),
                             lambda _fam, _sz, full: self.set_dunst('dunst_font', full, 'Font'))
        c.pack_start(self.row('Font', '', fb), False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰜎', 'Motion', 'picom animations')
        presets_in = [(x, x) for x in ('fly-in', 'slide-in', 'appear')]
        presets_out = [(x, x) for x in ('fly-out', 'slide-out', 'disappear')]
        dirs = [(x, x) for x in ('up', 'down', 'left', 'right')]
        c.pack_start(self.row('Open animation', '',
                              self.combo(presets_in, cfg.raw('dunst_open_preset', 'fly-in'),
                                         lambda v: self.set_dunst('dunst_open_preset', v, 'Open animation', picom=True)),
                              self.combo(dirs, cfg.raw('dunst_open_direction', 'up'),
                                         lambda v: self.set_dunst('dunst_open_direction', v, 'Open direction', picom=True))),
                     False, False, 0)
        c.pack_start(self.row('Close animation', '',
                              self.combo(presets_out, cfg.raw('dunst_close_preset', 'fly-out'),
                                         lambda v: self.set_dunst('dunst_close_preset', v, 'Close animation', picom=True)),
                              self.combo(dirs, cfg.raw('dunst_close_direction', 'up'),
                                         lambda v: self.set_dunst('dunst_close_direction', v, 'Close direction', picom=True))),
                     False, False, 0)
        c.pack_start(self.row('Try it', 'Send a sample notification',
                              self.button('󰂚  Test notification', 'neon', lambda *_: self.test_notify())),
                     False, False, 0)
        p.pack_start(c, False, False, 0)
