    def set_dunst(self, var, value, title, picom=False):
        self.cfg.set(var, value)
        mods = ('04-dunst.sh', '00-picom.sh') if picom else ('04-dunst.sh',)
        run_bg(lambda: run_modules(*mods, reload_picom=picom),
               lambda _r: (self.toast(f'{title} → {value}'), self.test_notify(quiet=True)))

    def set_dunst_offset(self, idx, v):
        self._dunst_off[idx] = v
        self.set_dunst('dunst_offset', f'({self._dunst_off[0]}, {self._dunst_off[1]})', 'Offset')

    def test_notify(self, quiet=False):
        spawn(['notify-send', '-a', 'RiceEditor', '-i', 'preferences-desktop-theme',
               'RiceEditor', 'This is how your notifications look now ✨'])
        if not quiet:
            self.toast('Test notification sent')

    # ────────────────────────────────────────────────────── lockscreen
    def page_lockscreen(self):
        p = self.page()
        cfg = self.cfg
        c = self.card('󰍹', 'Preview', 'real render of your wallpaper')
        self.lock_prev = LockPreview(self)
        self.refresh_lock_opts()
        c.pack_start(self.lock_prev, False, False, 4)
        hb = Gtk.Box(spacing=8)
        hb.pack_start(self.button('󰌾  Lock now', 'neon', lambda *_: spawn(['ScreenLocker'])), False, False, 0)
        hb.pack_start(self.button('󰑓  Re-render', 'ghost', lambda *_: self.rerender_lock()), False, False, 0)
        hb.pack_start(self.button('󰔎  Random wall', 'ghost', lambda *_: spawn(['ScreenLocker', '--rice'])),
                      False, False, 0)
        c.pack_start(hb, False, False, 6)
        p.pack_start(c, False, False, 0)

        c = self.card('󰋩', 'Background')
        sc, lab = self.scale(0, 30, 1, cfg.raw('LOCK_BLUR', '0'), 0, lambda v: self.set_lock('LOCK_BLUR', v, True))
        c.pack_start(self.row('Blur', '0 = sharp wallpaper', sc, lab), False, False, 0)
        sc, lab = self.scale(0, 80, 5, cfg.raw('LOCK_DIM', '20'), 0, lambda v: self.set_lock('LOCK_DIM', v, True),
                             fmt=lambda v: f'{int(v)}%')
        c.pack_start(self.row('Dim', 'Darken the wallpaper for readability', sc, lab), False, False, 0)
        c.pack_start(self.row('Glass panel', 'Frosted HUD panel behind the clock',
                              self.switch(cfg.raw('LOCK_GLASS', 'true') == 'true',
                                          lambda on: self.set_lock('LOCK_GLASS', 'true' if on else 'false', True))),
                     False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰥔', 'Clock & ring')
        c.pack_start(self.row('Position', '',
                              self.combo([('left', 'left'), ('center', 'center'), ('right', 'right')],
                                         cfg.raw('LOCK_POS', 'left'), lambda v: self.set_lock('LOCK_POS', v, True))),
                     False, False, 0)
        c.pack_start(self.row('Clock format', '',
                              self.combo([('%H:%M', '24h  ·  18:30'), ('%H:%M:%S', '24h  ·  18:30:05'),
                                          ('%I:%M %p', '12h  ·  06:30 PM')],
                                         cfg.raw('LOCK_CLOCK', '%H:%M'), lambda v: self.set_lock('LOCK_CLOCK', v))),
                     False, False, 0)
        entry = Gtk.Entry()
        entry.set_width_chars(30)
        entry.set_text(cfg.raw('LOCK_GREETER', 'Type the password to Unlock'))
        entry.connect('changed', lambda e: self.debounce('greeter', 500,
                                                         lambda: self.set_lock('LOCK_GREETER', e.get_text())))
        c.pack_start(self.row('Greeter text', '', entry), False, False, 0)
        res = cfg.resolve(['LOCK_ACCENT', 'sl_ring', 'sl_verify', 'sl_wrong', 'sl_date'])
        for var, title in (('LOCK_ACCENT', 'Accent (keypress & glass border)'), ('sl_ring', 'Ring'),
                           ('sl_verify', 'Verifying'), ('sl_wrong', 'Wrong password'), ('sl_date', 'Clock & date')):
            c.pack_start(self.row(title, '', self.color(res.get(var, ''),
                                                        lambda h, v=var: self.set_lock(v, h, v == 'LOCK_ACCENT'))),
                         False, False, 0)
        p.pack_start(c, False, False, 0)
        return p

    def refresh_lock_opts(self):
        r = self.cfg.resolve(['LOCK_POS', 'LOCK_CLOCK', 'LOCK_GREETER', 'LOCK_ACCENT', 'sl_ring',
                              'sl_date', 'sl_bg', 'sl_fg'])
        self.lock_prev.opts = dict(pos=r.get('LOCK_POS'), clock=r.get('LOCK_CLOCK'),
                                   greeter=r.get('LOCK_GREETER'), accent=r.get('LOCK_ACCENT'),
                                   ring=r.get('sl_ring'), date=r.get('sl_date'), bg=r.get('sl_bg'),
                                   fg=r.get('sl_fg'))

    def set_lock(self, var, value, rerender=False):
        self.cfg.set(var, value)
        self.refresh_lock_opts()
        self.toast(f'Lockscreen · {var} → {value}')
        if rerender:
            self.debounce('lock-render', 400, self.rerender_lock)
        else:
            run_bg(lambda: run_modules('07-screenlocker.sh'))

    def rerender_lock(self):
        self.lock_prev.busy = True

        def work():
            run_modules('07-screenlocker.sh')
            subprocess.run(['ScreenLocker', '--prepare'], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=120)

        def done(_r):
            self.lock_prev.busy = False
            self.lock_prev.reload()
        run_bg(work, done)

