tooltip {{ background-color: @black; border: 1px solid alpha(@accent, 0.4); border-radius: 8px; }}
tooltip label {{ color: @fg; }}
'''


# ═════════════════════════════════════════════════════════ custom widgets
def rounded(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def pango_text(cr, text, size, bold=False, spacing=0, family=FONT):
    layout = PangoCairo.create_layout(cr)
    layout.set_font_description(Pango.FontDescription(f'{family} {"Bold " if bold else ""}{size}'))
    if spacing:
        attrs = Pango.AttrList()
        attrs.insert(Pango.attr_letter_spacing_new(int(spacing * Pango.SCALE)))
        layout.set_attributes(attrs)
    layout.set_text(text, -1)
    return layout


def draw_text(cr, text, x, y, size, rgba, bold=False, align='left', spacing=0, family=FONT):
    layout = pango_text(cr, text, size, bold, spacing, family)
    w, h = layout.get_pixel_size()
    if align == 'center':
        x -= w / 2
    elif align == 'right':
        x -= w
    cr.move_to(x, y)
    cr.set_source_rgba(*rgba)
    PangoCairo.show_layout(cr, layout)
    return w, h


def load_surface(path, w, h, crop=True):
    """Image scaled to cover w x h, as a cairo surface (None on failure)."""
    try:
        pix = GdkPixbuf.Pixbuf.new_from_file(path)
    except (GLib.Error, TypeError):
        return None
    pw, ph = pix.get_width(), pix.get_height()
    s = max(w / pw, h / ph) if crop else min(w / pw, h / ph)
    sw, sh = max(1, int(pw * s)), max(1, int(ph * s))
    pix = pix.scale_simple(sw, sh, GdkPixbuf.InterpType.BILINEAR)
    if crop:
        x, y = (sw - w) // 2, (sh - h) // 2
        pix = pix.new_subpixbuf(max(0, x), max(0, y), min(w, sw), min(h, sh))
    return Gdk.cairo_surface_create_from_pixbuf(pix, 1, None)


class Animated(Gtk.DrawingArea):
    """DrawingArea redrawn at a fixed rate while mapped."""

    def __init__(self, app, fps=30):
        super().__init__()
        self.app = app
        self._fps = fps
        self._timer = None
        self.connect('map', self._on_map)
        self.connect('unmap', self._on_unmap)
        self.connect('draw', lambda w, cr: self.paint(cr, w.get_allocated_width(),
                                                      w.get_allocated_height()) or True)

    def _on_map(self, *_):
        if self._timer is None:
            self._timer = GLib.timeout_add(int(1000 / self._fps), self._tick)

    def _on_unmap(self, *_):
        if self._timer:
            GLib.source_remove(self._timer)
            self._timer = None

    def _tick(self):
        self.queue_draw()
        return True

    @property
    def c(self):
        return self.app.rgb

    def paint(self, cr, w, h):
        pass


class NeonLogo(Animated):
    def __init__(self, app, path, size=132):
        super().__init__(app, fps=30)
        self.set_size_request(size, size)
        self.size, self.path, self.mtime = size, path, None
        self.surface = None
        self.reload()
        # the avatar follows AvatarForge live; a click opens it
        GLib.timeout_add_seconds(2, self.reload)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.set_tooltip_text('Change the avatar (AvatarForge)')
        self.connect('button-press-event', lambda *_: spawn([os.path.join(BIN, 'AvatarForge')]))

    def reload(self):
        path = avatar_path()
        try:
            m = (path, os.path.getmtime(path))
        except OSError:
            m = None
        if m != self.mtime:
            self.mtime = m
            s = self.size - 34
            self.surface = load_surface(path, s, s) if m else None
        return True

    def paint(self, cr, w, h):
        t = time.monotonic()
        cx, cy, r = w / 2, h / 2, min(w, h) / 2 - 4
        acc, acc2 = self.c['blue'], self.c['magenta']
        glow = cairo.RadialGradient(cx, cy, r * 0.6, cx, cy, r + 4)
        glow.add_color_stop_rgba(0, *acc, 0.0)
        glow.add_color_stop_rgba(0.8, *acc, 0.12 + 0.06 * math.sin(t * 2))
        glow.add_color_stop_rgba(1, *acc, 0)
        cr.set_source(glow)
        cr.paint()
        # avatar
        ir = r - 13
        cr.save()
        cr.arc(cx, cy, ir, 0, 2 * math.pi)
        cr.clip()
        if self.surface:
            cr.set_source_surface(self.surface, cx - self.surface.get_width() / 2,
                                  cy - self.surface.get_height() / 2)
            cr.paint()
        else:
            cr.set_source_rgb(*self.c['black'])
            cr.paint()
            draw_text(cr, '', cx, cy - 22, 26, (*acc, 1), align='center')
        cr.restore()
        # rotating HUD rings
        cr.set_line_width(2.5)
        for i in range(3):
            a0 = t * 1.2 + i * 2 * math.pi / 3
            cr.arc(cx, cy, r - 4, a0, a0 + 1.4)
            cr.set_source_rgba(*acc, 0.95)
            cr.stroke()
        cr.set_line_width(1.2)
        for i in range(24):
            a = -t * 0.5 + i * 2 * math.pi / 24
            cr.arc(cx, cy, r, a, a + 0.12)
            cr.set_source_rgba(*acc2, 0.7)
            cr.stroke()
        cr.arc(cx, cy, ir + 2, 0, 2 * math.pi)
        cr.set_source_rgba(*acc, 0.35)
        cr.stroke()


class HudHeader(Animated):
    GLYPHS = '!<>-_\\/[]{}=+*^?#01ABCDEFXZ'

    def __init__(self, app):
        super().__init__(app, fps=24)
        self.set_size_request(-1, 84)
        self.icon, self.title, self.sub = '', '', ''
        self.t_change = 0

    def set_section(self, icon, title, sub):
        self.icon, self.title, self.sub = icon, title, sub
        self.t_change = time.monotonic()

    def decrypted(self, now):
        p = min(1.0, (now - self.t_change) / 0.5)
        n = int(len(self.title) * p)
        rnd = random.Random(int(now * 30))
        return self.title[:n] + ''.join(rnd.choice(self.GLYPHS) if ch != ' ' else ' '
                                        for ch in self.title[n:])

    def paint(self, cr, w, h):
        now = time.monotonic()
        acc, acc2, fg = self.c['blue'], self.c['magenta'], self.c['fg']
        x = 26
        draw_text(cr, self.icon, x, 16, 20, (*acc2, 1))
        draw_text(cr, self.decrypted(now), x + 44, 14, 18, (*fg, 1), bold=True, spacing=4)
        draw_text(cr, self.sub, x + 46, 48, 8, (*fg, 0.45), spacing=1)
        # clock
        cw, _ = draw_text(cr, time.strftime('%H:%M:%S'), w - 26, 12, 17, (*acc, 1), bold=True,
                          align='right', spacing=2)
        draw_text(cr, time.strftime('%a %d %b %Y').upper(), w - 26, 44, 8, (*fg, 0.5),
                  align='right', spacing=2)
        # system status blinker
        lx = w - 26 - cw - 74
        blink = 0.4 + 0.6 * (0.5 + 0.5 * math.sin(now * 4))
        cr.arc(lx, 27, 4, 0, 2 * math.pi)
        cr.set_source_rgba(*self.c['green'], blink)
        cr.fill()
        draw_text(cr, 'LIVE', lx + 10, 20, 8, (*self.c['green'], 0.85), bold=True, spacing=2)
        # baseline with scanner
        y = h - 8
        lg = cairo.LinearGradient(x, 0, w - x, 0)
        lg.add_color_stop_rgba(0, *acc, 0.85)
        lg.add_color_stop_rgba(0.55, *acc2, 0.35)
        lg.add_color_stop_rgba(1, *acc, 0.03)
        cr.set_line_width(1)
        cr.move_to(x, y)
        cr.line_to(w - x, y)
        cr.set_source(lg)
        cr.stroke()
        sx = x + ((now * 0.3) % 1.0) * (w - 2 * x)
        sg = cairo.LinearGradient(sx - 80, 0, sx, 0)
        sg.add_color_stop_rgba(0, *acc2, 0)
        sg.add_color_stop_rgba(1, *acc2, 0.9)
        cr.rectangle(sx - 80, y - 1, 80, 2)
        cr.set_source(sg)
        cr.fill()
        # ticks
        for i in range(0, int(w - 2 * x), 42):
            cr.rectangle(x + i, y + 3, 1, 3)
        cr.set_source_rgba(*fg, 0.12)
        cr.fill()


class Gauge(Animated):
    def __init__(self, app, label, icon):
        super().__init__(app, fps=20)
        self.set_size_request(150, 150)
        self.label, self.icon = label, icon
        self.value = 0.0
        self.shown = 0.0
        self.detail = ''

    def paint(self, cr, w, h):
        self.shown += (self.value - self.shown) * 0.12
        t = time.monotonic()
        cx, cy = w / 2, h / 2 - 6
        r = min(w, h - 20) / 2 - 10
        acc, acc2, fg = self.c['blue'], self.c['magenta'], self.c['fg']
        start, span = math.radians(135), math.radians(270)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_width(8)
        cr.arc(cx, cy, r, start, start + span)
        cr.set_source_rgba(*fg, 0.08)
        cr.stroke()
        v = max(0.0, min(1.0, self.shown / 100))
        col = self.c['red'] if v > 0.85 else (self.c['yellow'] if v > 0.65 else acc)
        if v > 0.002:
            for lw, a in ((16, 0.10), (8, 1.0)):
                cr.set_line_width(lw)
                cr.arc(cx, cy, r, start, start + span * v)
                cr.set_source_rgba(*col, a)
                cr.stroke()
        # ticks
        cr.set_line_cap(cairo.LINE_CAP_BUTT)
        cr.set_line_width(1)
        for i in range(28):
            a = start + span * i / 27
            r0, r1 = r - 14, r - (19 if i % 3 == 0 else 16)
            cr.move_to(cx + r0 * math.cos(a), cy + r0 * math.sin(a))
            cr.line_to(cx + r1 * math.cos(a), cy + r1 * math.sin(a))
        cr.set_source_rgba(*fg, 0.22)
        cr.stroke()
        # orbiting dot
        a = t * 1.5
        cr.arc(cx + (r + 9) * math.cos(a), cy + (r + 9) * math.sin(a), 1.8, 0, 2 * math.pi)
        cr.set_source_rgba(*acc2, 0.8)
        cr.fill()
        draw_text(cr, f'{self.shown:.0f}%', cx, cy - 18, 16, (*fg, 1), bold=True, align='center')
        draw_text(cr, self.icon + '  ' + self.label, cx, cy + 10, 8, (*acc, 0.9), bold=True,
                  align='center', spacing=2)
        draw_text(cr, self.detail, cx, h - 20, 7, (*fg, 0.45), align='center')


class Swatches(Gtk.DrawingArea):
    def __init__(self, colors, height=22, radius=5):
        super().__init__()
        self.colors = colors
        self.radius = radius
        self.set_size_request(-1, height)
        self.connect('draw', self.on_draw)

    def on_draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        n = max(1, len(self.colors))
        rounded(cr, 0, 0, W, H, self.radius)
        cr.clip()
        for i, col in enumerate(self.colors):
            cr.rectangle(W * i / n, 0, W / n + 1, H)
            cr.set_source_rgb(*hex_rgb(col))
            cr.fill()
        return True


class PaletteArt(Gtk.DrawingArea):
    """Mini terminal mock painted with a palette."""

    def __init__(self, pal):
        super().__init__()
        self.pal = pal
        self.set_size_request(236, 118)
        self.connect('draw', self.on_draw)

    def on_draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        p = {k: hex_rgb(v) for k, v in self.pal.items() if isinstance(v, str) and v.startswith('#')}
        g = lambda k: p.get(k, (0.5, 0.5, 0.5))  # noqa: E731
        rounded(cr, 0, 0, W, H, 10)
        cr.set_source_rgb(*g('bg'))
        cr.fill()
        rounded(cr, 0, 0, W, 18, 10)
        cr.rectangle(0, 9, W, 9)
        cr.set_source_rgb(*g('black'))
        cr.fill()
        for i, k in enumerate(('red', 'yellow', 'green')):
            cr.arc(12 + i * 13, 9, 3.5, 0, 2 * math.pi)
            cr.set_source_rgb(*g(k))
            cr.fill()
        lines = [[('blue', ' ~/rice '), ('magenta', ' '), ('fg', 'neofetch')],
                 [('green', '✔ '), ('fg', 'bspwm '), ('cyan', 'picom '), ('yellow', 'polybar')],
                 [('red', '✘ '), ('fg', 'error '), ('blackb', '# comment')]]
        y = 26
        for line in lines:
            x = 10
            for key, txt in line:
                tw, _ = draw_text(cr, txt, x, y, 7.5, (*g(key), 1), bold=key != 'fg')
                x += tw
            y += 17
        n = 8
        bw = (W - 20) / n
        for i, k in enumerate(('black', 'red', 'green', 'yellow', 'blue', 'magenta', 'cyan', 'white')):
            rounded(cr, 10 + i * bw + 1, H - 20, bw - 2, 11, 3)
            cr.set_source_rgb(*g(k))
            cr.fill()
        return True


class ImageBox(Gtk.DrawingArea):
    """Rounded image with an optional HUD caption."""

    def __init__(self, app, w, h, caption=''):
        super().__init__()
        self.app = app
        self.set_size_request(w, h)
        self.surface = None
        self.caption = caption
        self.busy = False
        self.connect('draw', self.on_draw)

    def set_image(self, path):
        if not path:
            return

        def load():
            thumb = ensure_thumb(path) if not path.startswith(os.path.join(HOME, '.cache')) else path
            return thumb

        def done(thumb):
            if thumb:
                w, h = self.get_allocated_width(), self.get_allocated_height()
                self.surface = load_surface(thumb, max(w, 320), max(h, 180))
                self.queue_draw()
        run_bg(load, done)

    def on_draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        c = self.app.rgb
        rounded(cr, 0, 0, W, H, 12)
        cr.save()
        cr.clip()
        if self.surface:
            sw, sh = self.surface.get_width(), self.surface.get_height()
            s = max(W / sw, H / sh)
            cr.save()
            cr.scale(s, s)
            cr.set_source_surface(self.surface, (W / s - sw) / 2, (H / s - sh) / 2)
            cr.paint()
            cr.restore()
        else:
            cr.set_source_rgb(*c['black'])
            cr.paint()
        if self.caption:
            lg = cairo.LinearGradient(0, H * 0.55, 0, H)
            lg.add_color_stop_rgba(0, 0, 0, 0, 0)
            lg.add_color_stop_rgba(1, 0, 0, 0, 0.75)
            cr.rectangle(0, 0, W, H)
            cr.set_source(lg)
            cr.fill()
            draw_text(cr, self.caption, 14, H - 26, 8, (*c['fg'], 0.95), bold=True, spacing=2)
        cr.restore()
        rounded(cr, 0.5, 0.5, W - 1, H - 1, 12)
        cr.set_line_width(1)
        cr.set_source_rgba(*c['blue'], 0.5)
        cr.stroke()
        # HUD corners
        cr.set_line_width(2)
        cr.set_source_rgba(*c['magenta'], 0.9)
        L = 16
        for x0, y0, dx, dy in ((4, 4, 1, 1), (W - 4, 4, -1, 1), (W - 4, H - 4, -1, -1), (4, H - 4, 1, -1)):
            cr.move_to(x0, y0 + dy * L)
            cr.line_to(x0, y0)
            cr.line_to(x0 + dx * L, y0)
        cr.stroke()
        return True


class TermPreview(Gtk.DrawingArea):
    """Fake terminal over the wallpaper: shows opacity, font and colors live."""

    def __init__(self, app):
        super().__init__()
        self.app = app
        self.set_size_request(-1, 230)
        self.opacity = 1.0
        self.font = 'JetBrainsMono Nerd Font'
        self.size = 10
        self.wall = None
        self.connect('draw', self.on_draw)
        path = current_wallpaper()
        if path:
            run_bg(lambda: ensure_thumb(path),
                   lambda t: (setattr(self, 'wall', load_surface(t, 640, 360) if t else None),
                              self.queue_draw()))

    def on_draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        c = self.app.rgb
        rounded(cr, 0, 0, W, H, 12)
        cr.clip()
        if self.wall:
            sw, sh = self.wall.get_width(), self.wall.get_height()
            s = max(W / sw, H / sh)
            cr.save()
            cr.scale(s, s)
            cr.set_source_surface(self.wall, 0, 0)
            cr.paint()
            cr.restore()
        # the terminal window
        tx, ty, tw, th = 36, 26, W - 72, H - 52
        rounded(cr, tx + 6, ty + 10, tw, th, 10)
        cr.set_source_rgba(0, 0, 0, 0.35)
        cr.fill()
        rounded(cr, tx, ty, tw, th, 10)
        cr.set_source_rgba(*c['bg'], self.opacity)
        cr.fill()
        rounded(cr, tx, ty, tw, th, 10)
        cr.set_source_rgba(*c['blue'], 0.35)
        cr.set_line_width(1)
        cr.stroke()
        size = max(6, min(18, self.size))
        lh = size * 1.9
        lines = [
            [('blue', ' ~/Documentos '), ('magenta', ' main '), ('green', '❯ '), ('fg', 'fastfetch')],
            [('cyan', 'OS      '), ('fg', 'CachyOS x86_64')],
            [('cyan', 'WM      '), ('fg', 'bspwm'), ('blackb', '  (' + RICE + ')')],
            [('cyan', 'Shell   '), ('fg', 'zsh'), ('yellow', '  '), ('red', '●'), ('green', '●'),
             ('yellow', '●'), ('blue', '●'), ('magenta', '●'), ('cyan', '●')],
            [('blue', ' ~ '), ('green', '❯ '), ('fg', 'echo "hello rice"'), ('fg', '▌')],
        ]
        y = ty + 16
        cr.save()
        rounded(cr, tx, ty, tw, th, 10)
        cr.clip()
        for line in lines:
            x = tx + 16
            for key, txt in line:
                tw_, _ = draw_text(cr, txt, x, y, size, (*c.get(key, c['fg']), 1), family=self.font)
                x += tw_
            y += lh
        cr.restore()
        draw_text(cr, f'{self.font} · {self.size}pt · opacity {self.opacity:.2f}', W - 14, H - 20, 7,
                  (*c['fg'], 0.7), align='right')
        return True


class LockPreview(Animated):
    """Lockscreen mock: cached render + ring/clock at their real positions."""

    def __init__(self, app):
        super().__init__(app, fps=12)
        self.set_size_request(-1, 300)
        self.surface = None
        self.busy = False
        self.opts = {}
        self.reload()

    def reload(self):
        files = sorted(glob.glob(os.path.join(HOME, '.cache/lockscreen/lock-*.png')),
                       key=os.path.getmtime)
        if files:
            run_bg(lambda: files[-1], lambda f: (setattr(self, 'surface', load_surface(f, 960, 540)),
                                                 self.queue_draw()))

    def paint(self, cr, W, H):
        c = self.app.rgb
        o = self.opts
        # keep 16:9 inside the allocation
        pw = min(W, H * 16 / 9)
        ph = pw * 9 / 16
        ox, oy = (W - pw) / 2, (H - ph) / 2
        cr.save()
        rounded(cr, ox, oy, pw, ph, 12)
        cr.clip()
        if self.surface:
            sw, sh = self.surface.get_width(), self.surface.get_height()
            cr.save()
            cr.translate(ox, oy)
            cr.scale(pw / sw, ph / sh)
            cr.set_source_surface(self.surface, 0, 0)
            cr.paint()
            cr.restore()
        else:
            cr.set_source_rgb(*c['black'])
            cr.paint()
        pos = {'center': 0.5, 'right': 0.75}.get(o.get('pos'), 0.25)
        cx = ox + pw * pos
        s = pw / 1920
        clock = time.strftime(o.get('clock', '%H:%M')) if o.get('clock') else time.strftime('%H:%M')
        tcol = hex_rgb(o.get('date'), c['fg'])
        draw_text(cr, clock, cx, oy + ph * 0.36 - 140 * s * 1.25, 140 * s * 0.75, (*tcol, 1),
                  bold=True, align='center')
        draw_text(cr, time.strftime('%a, %d %b'), cx, oy + ph * 0.42 - 45 * s * 1.1, 45 * s * 0.75,
                  (*tcol, 1), align='center')
        ry = oy + ph * 0.56
        rr = 30 * s
        cr.set_line_width(60 * s * 0.25 + 2)
        cr.arc(cx, ry, rr + 6 * s, 0, 2 * math.pi)
        cr.set_source_rgb(*hex_rgb(o.get('ring'), c['black']))
        cr.stroke()
        a = time.monotonic() * 2
        cr.arc(cx, ry, rr + 6 * s, a, a + 0.9)
        cr.set_source_rgb(*hex_rgb(o.get('accent'), c['blue']))
        cr.stroke()
        cr.arc(cx, ry, rr, 0, 2 * math.pi)
        cr.set_source_rgba(*hex_rgb(o.get('bg'), c['bg']), 0.8)
        cr.fill()
        draw_text(cr, o.get('greeter', ''), cx, oy + ph * 0.72 - 10, 23 * s * 0.8,
                  (*hex_rgb(o.get('fg'), c['fg']), 1), align='center')
        if self.busy:
            cr.set_source_rgba(0, 0, 0, 0.55)
            cr.paint()
            dots = '.' * (int(time.monotonic() * 3) % 4)
            draw_text(cr, f'RENDERING{dots}', ox + pw / 2, oy + ph / 2 - 10, 11, (*c['blue'], 1),
                      bold=True, align='center', spacing=3)
        cr.restore()
        rounded(cr, ox + 0.5, oy + 0.5, pw - 1, ph - 1, 12)
        cr.set_line_width(1)
        cr.set_source_rgba(*c['blue'], 0.5)
        cr.stroke()


class LoginPreview(Animated):
    """betterlockscreen preview: the real render made by BetterLock --preview."""

    def __init__(self, app):
        super().__init__(app, fps=12)
        self.set_size_request(-1, 340)
        self.surface = None
        self.busy = False

    def reload(self):
        if os.path.exists(BL_PREVIEW):
            run_bg(lambda: load_surface(BL_PREVIEW, 1280, 720),
                   lambda sf: (setattr(self, 'surface', sf), self.queue_draw()))

    def paint(self, cr, W, H):
        c = self.app.rgb
        pw = min(W, H * 16 / 9)
        ph = pw * 9 / 16
        ox, oy = (W - pw) / 2, (H - ph) / 2
        cr.save()
        rounded(cr, ox, oy, pw, ph, 12)
        cr.clip()
        if self.surface:
            sw, sh = self.surface.get_width(), self.surface.get_height()
            cr.save()
            cr.translate(ox, oy)
            cr.scale(pw / sw, ph / sh)
            cr.set_source_surface(self.surface, 0, 0)
            cr.get_source().set_filter(cairo.FILTER_GOOD)
            cr.paint()
            cr.restore()
        else:
            cr.set_source_rgb(*c['black'])
            cr.paint()
        if self.busy or not self.surface:
            cr.set_source_rgba(0, 0, 0, 0.55)
            cr.paint()
            dots = '.' * (int(time.monotonic() * 3) % 4)
            draw_text(cr, f'RENDERING{dots}', ox + pw / 2, oy + ph / 2 - 10, 11, (*c['blue'], 1),
                      bold=True, align='center', spacing=3)
        cr.restore()
        rounded(cr, ox + 0.5, oy + 0.5, pw - 1, ph - 1, 12)
        cr.set_line_width(1)
        cr.set_source_rgba(*c['blue'], 0.5)
        cr.stroke()


# ═══════════════════════════════════════════════════════════ main window
class RiceEditor(Gtk.Window):
    SECTIONS = [
        ('dashboard', '󰕮', 'Dashboard', 'SYSTEM OVERVIEW · QUICK ACTIONS'),
        ('palette', '󰏘', 'Palette', 'COLOR SCHEMES OF THE RICE · APPLIED INSTANTLY'),
        ('windows', '󰖲', 'Windows', 'BSPWM · BORDERS · GAPS · BEHAVIOUR'),
        ('compositor', '󰨇', 'Compositor', 'PICOM · CORNERS · SHADOWS · BLUR · OPACITY'),
        ('terminal', '󰆍', 'Terminal', 'KITTY · ALACRITTY · GHOSTTY · SHELL'),
        ('wallpaper', '󰸉', 'Wallpaper', 'ENGINE · GALLERY · 3D SELECTOR'),
        ('dock', '󱂬', 'Dock', 'PINNED APPS · SIZE · BEHAVIOUR'),
        ('polybar', '󱔓', 'Polybar', 'THEMES · STYLE · MODULES · AUTO-HIDE'),
        ('notifications', '󰂚', 'Notifications', 'DUNST · PLACEMENT · STYLE · MOTION'),
        ('lockscreen', '󰌾', 'Lockscreen', 'I3LOCK-COLOR · QUICK LOCK · SUPER+SHIFT+S'),
        ('loginlock', '󰍁', 'Login Lock', 'BETTERLOCKSCREEN · AVATAR CARD · AUTO-LOCK'),
        ('appearance', '󰉼', 'Appearance', 'GTK · ICONS · CURSOR · ROFI'),
        ('snapshots', '󰁯', 'Snapshots', 'SAVE · RESTORE THE WHOLE RICE STATE'),
        ('help', '󰋗', 'Help', 'SHORTCUTS · HOW IT WORKS'),
    ]

    def __init__(self):
        super().__init__(title=f'Rice Editor: {RICE}')
        self.get_style_context().add_class('rice-editor')
        self.set_default_size(1220, 800)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.cfg = ThemeConfig(THEME_CFG)
        self.timers = {}
        self.loading = True
        self.css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), self.css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        settings = Gtk.Settings.get_default()
        settings.set_property('gtk-application-prefer-dark-theme', True)
        self.load_colors()

        overlay = Gtk.Overlay()
        self.add(overlay)
        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        overlay.add(root)
        root.pack_start(self.build_sidebar(), False, False, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        right.get_style_context().add_class('content')
        self.header = HudHeader(self)
        right.pack_start(self.header, False, False, 0)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_UP_DOWN)
        self.stack.set_transition_duration(320)
        right.pack_start(self.stack, True, True, 0)
        right.pack_start(self.build_statusbar(), False, False, 0)
        root.pack_start(right, True, True, 0)

        # toast
        self.toast_rev = Gtk.Revealer()
        self.toast_rev.set_transition_type(Gtk.RevealerTransitionType.SLIDE_UP)
        self.toast_rev.set_transition_duration(220)
        self.toast_rev.set_halign(Gtk.Align.END)
        self.toast_rev.set_valign(Gtk.Align.END)
        self.toast_rev.set_margin_end(26)
        self.toast_rev.set_margin_bottom(42)
        self.toast_box = Gtk.Box()
        self.toast_box.get_style_context().add_class('toast')
        self.toast_label = Gtk.Label()
        self.toast_box.pack_start(self.toast_label, False, False, 0)
        self.toast_rev.add(self.toast_box)
        overlay.add_overlay(self.toast_rev)
        self.toast_timer = None

        builders = {
            'dashboard': self.page_dashboard, 'palette': self.page_palette,
            'windows': self.page_windows, 'compositor': self.page_compositor,
            'terminal': self.page_terminal, 'wallpaper': self.page_wallpaper,
            'dock': self.page_dock, 'polybar': self.page_polybar,
            'notifications': self.page_notifications, 'lockscreen': self.page_lockscreen,
            'loginlock': self.page_loginlock,
            'appearance': self.page_appearance, 'snapshots': self.page_snapshots,
            'help': self.page_help,
        }
        for key, *_ in self.SECTIONS:
            page = builders[key]()
            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroller.add(page)
            self.stack.add_named(scroller, key)

        self.connect('key-press-event', self.on_key)
        self.connect('destroy', self.on_destroy)
        self.go('dashboard')
        self.loading = False
        GLib.timeout_add_seconds(1, self.update_stats)
        self.auto_snapshot()

    # ──────────────────────────────────────────────────────────── colors
    def load_colors(self):
        names = ['bg', 'fg', 'black', 'blackb', 'red', 'green', 'yellow', 'blue', 'magenta',
                 'cyan', 'white', 'accent_color']
        vals = self.cfg.resolve(names)
        defaults = dict(bg='#1a1b26', fg='#c0caf5', black='#15161e', blackb='#414868',
                        red='#f7768e', green='#9ece6a', yellow='#e0af68', blue='#7aa2f7',
                        magenta='#bb9af7', cyan='#7dcfff', white='#a9b1d6', accent_color='#222330')
        self.hex = {k: vals.get(k) if valid_hex(vals.get(k)) else defaults[k] for k in names}
        self.rgb = {k: hex_rgb(v) for k, v in self.hex.items()}
        self.css.load_from_data(build_css(self.hex).encode())
        if hasattr(self, 'brand'):
            self.paint_brand()
        self.queue_draw()

    def paint_brand(self):
        self.brand.set_markup('RICE<span foreground="{}">//</span>EDITOR'.format(self.hex['blue']))

    # ────────────────────────────────────────────────────────── layout
    def build_sidebar(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.get_style_context().add_class('sidebar')
        box.set_size_request(236, -1)
        logo = NeonLogo(self, avatar_path())
        logo.set_halign(Gtk.Align.CENTER)
        box.pack_start(logo, False, False, 4)

        self.brand = Gtk.Label()
        self.brand.get_style_context().add_class('brand')
        self.paint_brand()
        box.pack_start(self.brand, False, False, 2)
        chip = Gtk.Label(label=f'◉ {RICE.upper()}')
        chip.get_style_context().add_class('rice-chip')
        chip.set_halign(Gtk.Align.CENTER)
        box.pack_start(chip, False, False, 8)

        self.nav = {}
        for i, (key, icon, title, _sub) in enumerate(self.SECTIONS):
            btn = Gtk.Button()
            btn.get_style_context().add_class('nav')
            inner = Gtk.Box(spacing=10)
            ic = Gtk.Label(label=icon)
            ic.get_style_context().add_class('nav-icon')
            inner.pack_start(ic, False, False, 0)
            lb = Gtk.Label(label=title, xalign=0)
            inner.pack_start(lb, True, True, 0)
            num = Gtk.Label(label=str((i + 1) % 10) if i < 10 else '')
            num.get_style_context().add_class('dim')
            inner.pack_end(num, False, False, 0)
            btn.add(inner)
            btn.connect('clicked', lambda _b, k=key: self.go(k))
            btn.set_tooltip_text(f'Ctrl+{(i + 1) % 10}' if i < 10 else None)
            box.pack_start(btn, False, False, 0)
            self.nav[key] = btn

        bottom = Gtk.Box(spacing=6)
        b1 = self.button('󰑓 Reload', 'neon', lambda *_: self.soft_reload())
        b1.set_tooltip_text('Soft reload: polybar, picom, dunst, sxhkd… (Ctrl+R)')
        b2 = self.button('󰔎 Rebuild', 'ghost', lambda *_: self.full_reload())
        b2.set_tooltip_text('Re-apply the whole rice (Theme.sh)')
        bottom.pack_start(b1, True, True, 0)
        bottom.pack_start(b2, True, True, 0)
        box.pack_end(bottom, False, False, 6)
        return box

    def build_statusbar(self):
        bar = Gtk.Box(spacing=8)
        bar.get_style_context().add_class('statusbar')
        dot = Gtk.Label(label='●')
        dot.get_style_context().add_class('live-dot')
        bar.pack_start(dot, False, False, 0)
        bar.pack_start(Gtk.Label(label='LIVE MODE — every change is applied and saved instantly'),
                       False, False, 0)
        bar.pack_end(Gtk.Label(label=THEME_CFG.replace(HOME, '~')), False, False, 0)
        return bar

    def go(self, key):
        self.stack.set_visible_child_name(key)
        for k, b in self.nav.items():
            ctx = b.get_style_context()
            (ctx.add_class if k == key else ctx.remove_class)('active')
        for k, icon, title, sub in self.SECTIONS:
            if k == key:
                self.header.set_section(icon, title.upper(), sub)
        if key == 'lockscreen':
            self.lock_prev.reload()
        if key == 'loginlock' and not self.loading:
            if os.path.exists(BL_PREVIEW):
                self.bl_prev.reload()
            else:
                self.bl_render()
        if key == 'dock' and not self.loading:
            self.dock_sync()
        if key == 'polybar' and not self.loading:
            self.bar_sync()

    def on_key(self, _w, ev):
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        k = ev.keyval
        if ctrl and k in (Gdk.KEY_q, Gdk.KEY_w):
            self.destroy()
            return True
        if ctrl and Gdk.KEY_0 <= k <= Gdk.KEY_9:
            idx = (k - Gdk.KEY_0 - 1) % 10
            if idx < len(self.SECTIONS):
                self.go(self.SECTIONS[idx][0])
            return True
        if ctrl and k == Gdk.KEY_s:
            self.snapshot_create('manual')
            return True
        if ctrl and k == Gdk.KEY_r:
            self.soft_reload()
            return True
        if ctrl and k == Gdk.KEY_l:
            spawn(['ScreenLocker'])
            return True
        return False

    # ──────────────────────────────────────────────────────── ui helpers
    def toast(self, msg, error=False):
        ctx = self.toast_box.get_style_context()
        (ctx.add_class if error else ctx.remove_class)('error')
        self.toast_label.set_text(('  ' if error else '  ') + msg)
        self.toast_rev.set_reveal_child(True)
        if self.toast_timer:
            GLib.source_remove(self.toast_timer)
        self.toast_timer = GLib.timeout_add(2400, self._hide_toast)

    def _hide_toast(self):
        self.toast_rev.set_reveal_child(False)
        self.toast_timer = None
        return False

    def debounce(self, key, ms, fn):
        if key in self.timers:
            GLib.source_remove(self.timers[key][0])

        def fire():
            self.timers.pop(key, None)
            fn()
            return False
        self.timers[key] = (GLib.timeout_add(ms, fire), fn)

    def on_destroy(self, *_):
        # a slider moved right before closing must still be saved
        for src, fn in list(self.timers.values()):
            GLib.source_remove(src)
            try:
                fn()
            except Exception as e:  # noqa: BLE001  never block the exit
                print(f'RiceEditor: {e}', file=sys.stderr)
        self.timers.clear()
        Gtk.main_quit()

    def page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.get_style_context().add_class('page')
        return box

    def card(self, icon, title, sub=''):
        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        frame.get_style_context().add_class('card')
        head = Gtk.Box(spacing=10)
        ic = Gtk.Label(label=icon)
        ic.get_style_context().add_class('card-icon')
        head.pack_start(ic, False, False, 0)
        tl = Gtk.Label(label=title.upper(), xalign=0)
        tl.get_style_context().add_class('card-title')
        head.pack_start(tl, False, False, 0)
        if sub:
            sl = Gtk.Label(label=sub, xalign=1)
            sl.get_style_context().add_class('card-sub')
            head.pack_end(sl, False, False, 0)
        frame.pack_start(head, False, False, 4)
        return frame

    def row(self, title, desc, *widgets):
        r = Gtk.Box(spacing=12)
        r.get_style_context().add_class('row')
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        t = Gtk.Label(label=title, xalign=0)
        t.get_style_context().add_class('row-title')
        texts.pack_start(t, False, False, 0)
        if desc:
            d = Gtk.Label(label=desc, xalign=0)
            d.set_line_wrap(True)
            d.get_style_context().add_class('row-desc')
            texts.pack_start(d, False, False, 0)
        texts.set_valign(Gtk.Align.CENTER)
        r.pack_start(texts, True, True, 0)
        for wdg in reversed(widgets):
            wdg.set_valign(Gtk.Align.CENTER)
            r.pack_end(wdg, False, False, 0)
        return r

    def button(self, label, cls, cb):
        b = Gtk.Button(label=label)
        b.get_style_context().add_class(cls)
        b.connect('clicked', cb)
        return b

    def scale(self, lo, hi, step, value, digits, on_change, fmt=None, delay=180):
        sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        sc.set_draw_value(False)
        sc.set_digits(digits)
        try:
            sc.set_value(float(value))
        except (TypeError, ValueError):
            sc.set_value(lo)
        lab = Gtk.Label(xalign=1)
        lab.get_style_context().add_class('value')
        fmt = fmt or (lambda v: f'{v:.{digits}f}')
        lab.set_text(fmt(sc.get_value()))

        def changed(s):
            v = round(s.get_value(), digits) if digits else int(round(s.get_value()))
            lab.set_text(fmt(v))
            if not self.loading:
                self.debounce(id(s), delay, lambda: on_change(v))
        sc.connect('value-changed', changed)
        return sc, lab

    def switch(self, active, on_change):
        sw = Gtk.Switch()
        sw.set_active(bool(active))

        def changed(s, _p):
            if not self.loading:
                on_change(s.get_active())
        sw.connect('notify::active', changed)
        return sw

    def color(self, hexv, on_change):
        rgba = Gdk.RGBA()
        rgba.parse(hexv if valid_hex(hexv) else '#000000')
        cb = Gtk.ColorButton.new_with_rgba(rgba)
        entry = Gtk.Entry()
        entry.set_width_chars(8)
        entry.set_max_length(7)
        entry.set_text(hexv if valid_hex(hexv) else '')

        def picked(b):
            h = rgba_hex(b.get_rgba())
            entry.set_text(h)
            on_change(h)

        def typed(e):
            h = e.get_text().strip()
            if valid_hex(h):
                r = Gdk.RGBA()
                r.parse(h)
                cb.set_rgba(r)
                on_change(h)
        cb.connect('color-set', picked)
        entry.connect('activate', typed)
        box = Gtk.Box(spacing=6)
        box.pack_start(entry, False, False, 0)
        box.pack_start(cb, False, False, 0)
        return box

    def combo(self, items, active, on_change):
        cb = Gtk.ComboBoxText()
        for item_id, label in items:
            cb.append(item_id, label)
        if not cb.set_active_id(active):
            cb.set_active(0)

        def changed(c):
            if not self.loading:
                on_change(c.get_active_id())
        cb.connect('changed', changed)
        return cb

    def spin(self, lo, hi, value, on_change):
        sp = Gtk.SpinButton.new_with_range(lo, hi, 1)
        try:
            sp.set_value(float(value))
        except (TypeError, ValueError):
            pass

        def changed(s):
            if not self.loading:
                self.debounce(id(s), 300, lambda: on_change(int(s.get_value())))
        sp.connect('value-changed', changed)
        return sp

    def fontbutton(self, font, on_change, mono=False):
        """Button showing the font string; opens a font chooser."""
        b = Gtk.Button(label=f'󰛖  {font}')
        b.get_style_context().add_class('neon')

        def pick(_b):
            dlg = Gtk.FontChooserDialog(title='Select font', transient_for=self)
            dlg.set_font(font)
            if mono:
                dlg.set_filter_func(lambda family, face: family.is_monospace())
            if dlg.run() == Gtk.ResponseType.OK and dlg.get_font():
                desc = Pango.FontDescription.from_string(dlg.get_font())
                size = max(1, int(desc.get_size() / Pango.SCALE))
                full = dlg.get_font()
                b.set_label(f'󰛖  {full}')
                on_change(desc.get_family(), size, full)
            dlg.destroy()
        b.connect('clicked', pick)
        return b

    # ─────────────────────────────────────────────────────── actions
    def soft_reload(self):
        spawn([os.path.join(BIN, 'SoftReload')])
        self.toast('Environment soft-reloaded')

    def full_reload(self, msg='Rice rebuilt'):
        spawn([os.path.join(BIN, 'Theme.sh')])
        self.toast(msg)

    def apply_modules(self, msg, *mods, reload_picom=False):
        run_bg(lambda: run_modules(*mods, reload_picom=reload_picom), lambda _r: msg and self.toast(msg))

    # ══════════════════════════════════════════════════════════ PAGES
    # ─────────────────────────────────────────────────────── dashboard
    def page_dashboard(self):
        p = self.page()
        hero = self.card('󰍹', 'Current rice', 'active setup')
        hb = Gtk.Box(spacing=20)
        self.dash_wall = ImageBox(self, 420, 236, caption='NOW ON SCREEN')
        self.dash_wall.set_image(current_wallpaper())
        hb.pack_start(self.dash_wall, False, False, 0)
        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        name = Gtk.Label(label=RICE.upper(), xalign=0)
        name.get_style_context().add_class('big')
        info.pack_start(name, False, False, 0)
        self.dash_pal = Gtk.Label(xalign=0)
        self.dash_pal.get_style_context().add_class('dim')
        info.pack_start(self.dash_pal, False, False, 0)
        self.dash_sw = Swatches([], height=24)
        info.pack_start(self.dash_sw, False, False, 4)
        grid = Gtk.Grid(column_spacing=18, row_spacing=6)
        self.sysinfo = {}
        for i, key in enumerate(('KERNEL', 'UPTIME', 'WM', 'COMPOSITOR', 'DISPLAY', 'PACKAGES')):
            k = Gtk.Label(label=key, xalign=0)
            k.get_style_context().add_class('card-title')
            v = Gtk.Label(label='…', xalign=0)
            v.set_ellipsize(Pango.EllipsizeMode.END)
            grid.attach(k, (i % 2) * 2, i // 2, 1, 1)
            grid.attach(v, (i % 2) * 2 + 1, i // 2, 1, 1)
            self.sysinfo[key] = v
        info.pack_start(grid, False, False, 8)
        hb.pack_start(info, True, True, 0)
        hero.pack_start(hb, False, False, 6)
        p.pack_start(hero, False, False, 0)
        self.refresh_dashboard_palette()
        run_bg(self.collect_sysinfo, self.show_sysinfo)

        gcard = self.card('󰓅', 'Telemetry', 'live')
        gb = Gtk.Box(spacing=10, homogeneous=True)
        self.gauges = {k: Gauge(self, k, i) for k, i in
                       (('CPU', '󰻠'), ('RAM', '󰍛'), ('DISK', '󰋊'), ('SWAP', '󰾴'))}
        for g in self.gauges.values():
            gb.pack_start(g, True, True, 0)
        gcard.pack_start(gb, False, False, 0)
        p.pack_start(gcard, False, False, 0)
        self._cpu_prev = None

        qa = self.card('󱐋', 'Quick actions')
        grid = Gtk.Grid(column_spacing=12, row_spacing=12, column_homogeneous=True)
        actions = [
            ('󰸉', 'Wallpapers', '3D selector', lambda: spawn(['WallSelect'])),
            ('󰀻', 'Apps', 'app launcher', lambda: spawn(['OpenApps', '--menu'])),
            ('󰌾', 'Lock', 'lock screen now', lambda: spawn(['ScreenLocker'])),
            ('󰑓', 'Soft reload', 'bars · picom · dunst', self.soft_reload),
            ('󰄀', 'Screenshot', 'ScreenShoTer', lambda: spawn(['ScreenShoTer'])),
            ('󰁯', 'Snapshot', 'save rice state', lambda: self.snapshot_create('manual')),
        ]
        for i, (icon, title, sub, fn) in enumerate(actions):
            b = Gtk.Button()
            b.get_style_context().add_class('action')
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            ic = Gtk.Label(label=icon)
            ic.get_style_context().add_class('action-icon')
            inner.pack_start(ic, False, False, 2)
            inner.pack_start(Gtk.Label(label=title), False, False, 0)
            sl = Gtk.Label(label=sub)
            sl.get_style_context().add_class('row-desc')
            inner.pack_start(sl, False, False, 0)
            b.add(inner)
            b.connect('clicked', lambda _b, f=fn: f())
            grid.attach(b, i % 3, i // 3, 1, 1)
        qa.pack_start(grid, False, False, 4)
        p.pack_start(qa, False, False, 0)
        return p

    def refresh_dashboard_palette(self):
        active = self.cfg.active_palette()
        self.dash_pal.set_text(f'PALETTE  ·  {palette_title(active) if active else "CUSTOM"}')
        self.dash_sw.colors = [self.hex[k] for k in ('bg', 'black', 'blackb', 'red', 'green', 'yellow',
                                                     'blue', 'magenta', 'cyan', 'white', 'fg')]
        self.dash_sw.queue_draw()

    @staticmethod
    def collect_sysinfo():
        info = {'KERNEL': platform.release()}
        try:
            with open('/proc/uptime') as f:
                s = int(float(f.read().split()[0]))
            info['UPTIME'] = f'{s // 86400}d {s % 86400 // 3600}h {s % 3600 // 60}m'
        except OSError:
            info['UPTIME'] = '?'
        info['WM'] = 'bspwm ' + (subprocess.run(['bspwm', '-v'], capture_output=True, text=True)
                                 .stdout.strip() if shutil.which('bspwm') else '')
        info['COMPOSITOR'] = f'picom · {picom_get("backend", "?")}'
        try:
            out = subprocess.run(['xrandr'], capture_output=True, text=True, timeout=2).stdout
            m = re.search(r'current (\d+) x (\d+)', out)
            info['DISPLAY'] = f'{m.group(1)}x{m.group(2)}' if m else '?'
        except Exception:
            info['DISPLAY'] = '?'
        try:
            n = len(subprocess.run(['pacman', '-Qq'], capture_output=True, text=True,
                                   timeout=5).stdout.split())
            info['PACKAGES'] = f'{n} (pacman)'
        except Exception:
            info['PACKAGES'] = '?'
        return info

    def show_sysinfo(self, info):
        for k, v in (info or {}).items():
            if k in self.sysinfo:
                self.sysinfo[k].set_text(v)

    def update_stats(self):
        try:
            with open('/proc/stat') as f:
                vals = list(map(int, f.readline().split()[1:]))
            idle, total = vals[3] + vals[4], sum(vals)
            if self._cpu_prev:
                di, dt = idle - self._cpu_prev[0], total - self._cpu_prev[1]
                self.gauges['CPU'].value = 100 * (1 - di / dt) if dt else 0
                self.gauges['CPU'].detail = f'{os.cpu_count()} threads'
            self._cpu_prev = (idle, total)
            mem = {}
            with open('/proc/meminfo') as f:
                for line in f:
                    k, v = line.split(':')
                    mem[k] = int(v.split()[0])
            used = mem['MemTotal'] - mem['MemAvailable']
            self.gauges['RAM'].value = 100 * used / mem['MemTotal']
            self.gauges['RAM'].detail = f'{used / 1048576:.1f} / {mem["MemTotal"] / 1048576:.1f} GiB'
            if mem.get('SwapTotal'):
                su = mem['SwapTotal'] - mem['SwapFree']
                self.gauges['SWAP'].value = 100 * su / mem['SwapTotal']
                self.gauges['SWAP'].detail = f'{su / 1048576:.1f} / {mem["SwapTotal"] / 1048576:.1f} GiB'
            else:
                self.gauges['SWAP'].detail = 'no swap'
            st = os.statvfs('/')
            tot, free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
            self.gauges['DISK'].value = 100 * (tot - free) / tot
            self.gauges['DISK'].detail = f'{(tot - free) / 2**30:.0f} / {tot / 2**30:.0f} GiB  /'
        except (OSError, ValueError, KeyError, ZeroDivisionError):
            pass
        return True

    # ───────────────────────────────────────────────────────── palette
    def page_palette(self):
        p = self.page()
        c = self.card('󰏘', 'Color schemes', 'click to apply · the editor re-themes too')
        self.pal_flow = Gtk.FlowBox()
        self.pal_flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.pal_flow.set_max_children_per_line(4)
        self.pal_flow.set_min_children_per_line(2)
        self.pal_flow.set_column_spacing(14)
        self.pal_flow.set_row_spacing(14)
        self.pal_buttons = {}
        active = self.cfg.active_palette()
        for func, pal in parse_palettes().items():
            b = Gtk.Button()
            b.get_style_context().add_class('palette')
            if func == active:
                b.get_style_context().add_class('active')
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            v.pack_start(PaletteArt(pal), False, False, 0)
            h = Gtk.Box(spacing=6)
            h.pack_start(Gtk.Label(label=palette_title(func), xalign=0), True, True, 0)
            chip = Gtk.Label(label='ACTIVE')
            chip.get_style_context().add_class('chip-active')
            chip.set_no_show_all(True)
            chip.set_visible(func == active)
            h.pack_end(chip, False, False, 0)
            v.pack_start(h, False, False, 0)
            b.add(v)
            b.connect('clicked', lambda _b, f=func: self.apply_palette(f))
            self.pal_flow.add(b)
            self.pal_buttons[func] = (b, chip)
        c.pack_start(self.pal_flow, False, False, 6)
        note = Gtk.Label(label='Palettes live in ' + COLORS_FILE.replace(HOME, '~') +
                         ' — add your own cargar_<name>() function and it shows up here.', xalign=0)
        note.get_style_context().add_class('mono-note')
        note.set_line_wrap(True)
        c.pack_start(note, False, False, 6)
        p.pack_start(c, False, False, 0)
        return p

    def apply_palette(self, func):
        self.cfg.set_palette(func)
        for f, (b, chip) in self.pal_buttons.items():
            ctx = b.get_style_context()
            (ctx.add_class if f == func else ctx.remove_class)('active')
            chip.set_visible(f == func)
        self.load_colors()
        self.refresh_dashboard_palette()
        self.full_reload(f'Palette {palette_title(func)} applied')

    # ───────────────────────────────────────────────────────── windows
    WIN_STYLES = [
        ('minimal', '󰖲', 'Minimal', 'No borders · rounded corners · soft shadow'),
        ('neon', '󱐋', 'Neon', '2 px frame that glows on focus · palette colors'),
        ('hud', '󰆧', 'HUD', '1 px sharp frame · square corners · accent glow'),
    ]
    WIN_PRESETS = {
        'minimal': dict(BORDER_WIDTH=0, P_CORNER_R=10, gap=5),
        'neon': dict(BORDER_WIDTH=2, P_CORNER_R=12, gap=10),
        'hud': dict(BORDER_WIDTH=1, P_CORNER_R=0, gap=8),
    }

    def tiles(self, items, active, on_click, per_line=4):
        """Row of selectable style tiles: items = (key, icon, title, desc)."""
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_homogeneous(True)
        flow.set_min_children_per_line(min(per_line, len(items)))
        flow.set_max_children_per_line(per_line)
        flow.set_column_spacing(10)
        flow.set_row_spacing(10)
        btns = {}
        for key, icon, title, desc in items:
            b = Gtk.Button()
            b.get_style_context().add_class('style-tile')
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            ic = Gtk.Label(label=icon, xalign=0)
            ic.get_style_context().add_class('style-icon')
            box.pack_start(ic, False, False, 0)
            t = Gtk.Label(label=title, xalign=0)
            t.get_style_context().add_class('row-title')
            box.pack_start(t, False, False, 0)
            d = Gtk.Label(label=desc, xalign=0)
            d.set_line_wrap(True)
            d.set_max_width_chars(24)
            d.get_style_context().add_class('row-desc')
            box.pack_start(d, False, False, 0)
            b.add(box)
            b.connect('clicked', lambda *_, k=key: on_click(k))
            flow.add(b)
            btns[key] = b
        self.mark_tiles(btns, active)
        return flow, btns

    @staticmethod
    def mark_tiles(btns, active):
        for k, b in btns.items():
            (b.get_style_context().add_class if k == active else b.get_style_context().remove_class)('active')

    def set_win_style(self, key, quiet=False):
        pre = self.WIN_PRESETS[key]
        self.cfg.set('WIN_STYLE', key)
        self.cfg.set('BORDER_WIDTH', pre['BORDER_WIDTH'])
        self.cfg.set('P_CORNER_R', pre['P_CORNER_R'])
        bspwmrc_set('window_gap', pre['gap'])
        bspc('config', 'window_gap', pre['gap'])
        if hasattr(self, 'win_style_btns'):
            self.mark_tiles(self.win_style_btns, key)
        # 01-bspwm.sh picks the border colors from the palette for WIN_STYLE,
        # 00-picom.sh the corners / glow
        self.apply_modules('' if quiet else f'Window style → {key}', '01-bspwm.sh', '00-picom.sh',
                           reload_picom=True)

    def page_windows(self):
        p = self.page()
        cfg = self.cfg

        c = self.card('󱂬', 'Window style', 'borders follow the palette · manual colors below = custom')
        flow, self.win_style_btns = self.tiles(self.WIN_STYLES, cfg.raw('WIN_STYLE', 'custom'),
                                               self.set_win_style, per_line=3)
        c.pack_start(flow, False, False, 4)
        p.pack_start(c, False, False, 0)

        c = self.card('󰢡', 'Borders')
        sc, lab = self.scale(0, 10, 1, cfg.raw('BORDER_WIDTH', '0'), 0, self.set_border_width,
                             fmt=lambda v: f'{int(v)} px')
        c.pack_start(self.row('Border width', 'Width of the window border', sc, lab), False, False, 0)
        c.pack_start(self.row('Normal border', 'Unfocused windows',
                              self.color(cfg.raw('NORMAL_BC'), lambda h: self.set_border_color('NORMAL_BC', 'normal_border_color', h))),
                     False, False, 0)
        c.pack_start(self.row('Focused border', 'The window with focus',
                              self.color(cfg.raw('FOCUSED_BC'), lambda h: self.set_border_color('FOCUSED_BC', 'focused_border_color', h))),
                     False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰕰', 'Gaps & padding', 'bspwmrc / theme-config')
        sc, lab = self.scale(0, 40, 1, bspc('config', 'window_gap') or bspwmrc_get('window_gap', '5'), 0,
                             self.set_gap, fmt=lambda v: f'{int(v)} px')
        c.pack_start(self.row('Window gap', 'Space between tiled windows', sc, lab), False, False, 0)
        pads = Gtk.Box(spacing=8)
        for side in ('TOP', 'BOTTOM', 'LEFT', 'RIGHT'):
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            lb = Gtk.Label(label=side)
            lb.get_style_context().add_class('row-desc')
            v.pack_start(lb, False, False, 0)
            v.pack_start(self.spin(0, 200, cfg.raw(f'{side}_PADDING', '0'),
                                   lambda val, s=side: self.set_padding(s, val)), False, False, 0)
            pads.pack_start(v, False, False, 0)
        c.pack_start(self.row('Screen padding', 'Reserved space at each edge (the bar lives in TOP)', pads),
                     False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰙵', 'Behaviour', 'bspwmrc')
        sc, lab = self.scale(0.3, 0.7, 0.01, bspc('config', 'split_ratio') or bspwmrc_get('split_ratio', '0.5'), 2,
                             lambda v: self.set_bspwm('split_ratio', f'{v:.2f}', 'Split ratio'))
        c.pack_start(self.row('Split ratio', 'Size of the new window when splitting', sc, lab), False, False, 0)
        for key, title, desc in (
                ('focus_follows_pointer', 'Focus follows pointer', 'Focus the window under the mouse'),
                ('pointer_follows_focus', 'Pointer follows focus', 'Warp the mouse to the focused window'),
                ('single_monocle', 'Single monocle', 'Monocle layout when only one window is open'),
                ('borderless_monocle', 'Borderless monocle', 'Remove borders in monocle layout'),
                ('gapless_monocle', 'Gapless monocle', 'Remove gaps in monocle layout')):
            live = bspc('config', key) or bspwmrc_get(key, 'false')
            c.pack_start(self.row(title, desc, self.switch(live == 'true',
                                                           lambda on, k=key, t=title: self.set_bspwm(k, 'true' if on else 'false', t))),
                         False, False, 0)
        c.pack_start(self.row('Automatic scheme', 'Where new windows are inserted',
                              self.combo([(x, x.replace('_', ' ')) for x in ('longest_side', 'alternate', 'spiral')],
                                         bspwmrc_get('automatic_scheme', 'longest_side'),
                                         lambda v: self.set_bspwm('automatic_scheme', v, 'Scheme'))),
                     False, False, 0)
        p.pack_start(c, False, False, 0)
        return p

    def set_border_width(self, v):
        self.cfg.set('WIN_STYLE', 'custom')
        self.mark_tiles(self.win_style_btns, 'custom')
        self.cfg.set('BORDER_WIDTH', v)
        bspc('config', 'border_width', v)
        self.toast(f'Border width → {v}px')

    def set_border_color(self, var, key, h):
        self.cfg.set('WIN_STYLE', 'custom')
        self.mark_tiles(self.win_style_btns, 'custom')
        self.cfg.set(var, h)
        bspc('config', key, h)
        self.toast(f'{var} → {h}')

    def set_gap(self, v):
        bspwmrc_set('window_gap', v)
        bspc('config', 'window_gap', v)
        self.toast(f'Window gap → {v}px')

    def set_padding(self, side, v):
        self.cfg.set(f'{side}_PADDING', v)
        bspc('config', f'{side.lower()}_padding', v)
        self.toast(f'{side.title()} padding → {v}px')

    def set_bspwm(self, key, value, title):
        bspwmrc_set(key, value)
        bspc('config', key, value)
        self.toast(f'{title} → {value}')

    # ────────────────────────────────────────────────────── compositor
    def page_compositor(self):
        p = self.page()
        cfg = self.cfg

        c = self.card('󰍹', 'Engine', 'needs a picom restart')
        c.pack_start(self.row('Backend', 'glx is the fastest; xrender works everywhere',
                              self.combo([('glx', 'glx'), ('egl', 'egl'), ('xrender', 'xrender')],
                                         picom_get('backend', 'glx'), self.set_backend)), False, False, 0)
        c.pack_start(self.row('VSync', 'Avoid tearing', self.switch(picom_get('vsync') == 'true', self.set_vsync)),
                     False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰢡', 'Corners & opacity')
        sc, lab = self.scale(0, 30, 1, cfg.raw('P_CORNER_R', '10'), 0, self.set_corners,
                             fmt=lambda v: f'{int(v)} px')
        c.pack_start(self.row('Corner radius', 'Rounded window corners (0 = square)', sc, lab), False, False, 0)
        sc, lab = self.scale(0.5, 1.0, 0.01, cfg.raw('P_ACTIVE_OPACITY', '0.97'), 2,
                             lambda v: self.set_opacity('P_ACTIVE_OPACITY', v, 'Focused'))
        c.pack_start(self.row('Focused opacity', 'Opacity of the focused window', sc, lab), False, False, 0)
        sc, lab = self.scale(0.5, 1.0, 0.01, cfg.raw('P_INACTIVE_OPACITY', '0.92'), 2,
                             lambda v: self.set_opacity('P_INACTIVE_OPACITY', v, 'Unfocused'))
        c.pack_start(self.row('Unfocused opacity', 'Opacity of the other windows', sc, lab), False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰊠', 'Shadows')
        c.pack_start(self.row('Shadows', 'Drop shadow under windows',
                              self.switch(cfg.raw('P_SHADOWS') == 'true',
                                          lambda on: self.set_picom_flag('P_SHADOWS', on, 'Shadows'))), False, False, 0)
        c.pack_start(self.row('Shadow color', '', self.color(cfg.raw('SHADOW_C', '#000000'), self.set_shadow_color)),
                     False, False, 0)
        for key, title, lo, hi, step, dg in (('shadow-radius', 'Shadow radius', 0, 60, 1, 0),
                                             ('shadow-opacity', 'Shadow opacity', 0, 1, 0.05, 2),
                                             ('shadow-offset-x', 'Offset X', -40, 40, 1, 0),
                                             ('shadow-offset-y', 'Offset Y', -40, 40, 1, 0)):
            sc, lab = self.scale(lo, hi, step, picom_get(key, '0'), dg,
                                 lambda v, k=key, t=title: self.set_picom_value(k, v, t))
            c.pack_start(self.row(title, '', sc, lab), False, False, 0)
        p.pack_start(c, False, False, 0)

        c = self.card('󰂵', 'Blur & fading')
        c.pack_start(self.row('Blur', 'Frosted background behind transparent windows',
                              self.switch(cfg.raw('P_BLUR') == 'true',
                                          lambda on: self.set_picom_flag('P_BLUR', on, 'Blur'))), False, False, 0)
        c.pack_start(self.row('Blur method', '',
                              self.combo([(m, m) for m in ('gaussian', 'dual_kawase', 'box')],
                                         blur_get('method', 'gaussian'), self.set_blur_method)), False, False, 0)
        sc, lab = self.scale(1, 20, 1, blur_get('size', '4'), 0, lambda v: self.set_blur('size', v))
        c.pack_start(self.row('Blur size', 'Kernel size (gaussian / box)', sc, lab), False, False, 0)
        sc, lab = self.scale(0.5, 10, 0.5, blur_get('deviation', '2.5'), 1, lambda v: self.set_blur('deviation', v))
        c.pack_start(self.row('Blur deviation', 'Softness (gaussian)', sc, lab), False, False, 0)
        c.pack_start(self.row('Fading', 'Fade windows in and out',
                              self.switch(cfg.raw('P_FADE') == 'true',
                                          lambda on: self.set_picom_flag('P_FADE', on, 'Fading'))), False, False, 0)
        sc, lab = self.scale(0.01, 0.15, 0.01, picom_get('fade-in-step', '0.03'), 2, self.set_fade_speed)
        c.pack_start(self.row('Fade speed', 'Opacity step per frame', sc, lab), False, False, 0)
        c.pack_start(self.row('Animations', 'Open/close/move animations (picom v12+)',
                              self.switch(cfg.raw('P_ANIMATIONS') == '@', self.set_animations)), False, False, 0)
        p.pack_start(c, False, False, 0)
        return p

    def set_backend(self, v):
        picom_set('backend', v, quoted=True)
        restart_picom()
        self.toast(f'Picom backend → {v} (restarted)')

    def set_vsync(self, on):
        picom_set('vsync', 'true' if on else 'false')
        restart_picom()
        self.toast(f'VSync {"on" if on else "off"} (picom restarted)')

    def set_corners(self, v):
        self.cfg.set('P_CORNER_R', v)
        file_sub(PICOM_CONF, r'^corner-radius = .*$', f'corner-radius = {v}')
        reload_picom()
        self.toast(f'Corner radius → {v}px')

    def set_opacity(self, var, v, title):
        self.cfg.set(var, f'{v:.2f}')
        tag = '#-active-opacity' if var == 'P_ACTIVE_OPACITY' else '#-inactive-opacity'
        file_sub(PICOM_RULES, rf'^(\s*)opacity\s*=\s*[0-9.]+;(\s*){tag}', rf'\g<1>opacity = {v:.2f};\g<2>{tag}')
        reload_picom()
        self.toast(f'{title} opacity → {v:.2f}')

    def set_picom_flag(self, var, on, title):
        self.cfg.set(var, 'true' if on else 'false')
        self.apply_modules(f'{title} {"enabled" if on else "disabled"}', '00-picom.sh', reload_picom=True)

    def set_shadow_color(self, h):
        self.cfg.set('SHADOW_C', h)
        self.apply_modules(f'Shadow color → {h}', '00-picom.sh', reload_picom=True)

    def set_picom_value(self, key, v, title):
        picom_set(key, v)
        reload_picom()
        self.toast(f'{title} → {v}')

    def set_blur_method(self, m):
        blur_set('method', m, quoted=True)
        if m == 'dual_kawase' and not re.search(r'strength\s*=', read_file(PICOM_RULES).split('rules:')[0]):
            file_sub(PICOM_RULES, r'(method\s*=\s*"dual_kawase";)', r'\g<1>\n\t\tstrength = 5;')
        reload_picom()
        self.toast(f'Blur method → {m}')

    def set_blur(self, key, v):
        blur_set(key, v)
        reload_picom()
        self.toast(f'Blur {key} → {v}')

    def set_fade_speed(self, v):
        picom_set('fade-in-step', v)
        picom_set('fade-out-step', v)
        reload_picom()
        self.toast(f'Fade speed → {v}')

    def set_animations(self, on):
        self.cfg.set('P_ANIMATIONS', '@' if on else '#')
        self.apply_modules(f'Animations {"enabled" if on else "disabled"}', '00-picom.sh', reload_picom=True)

    # ──────────────────────────────────────────────────────── terminal
    def page_terminal(self):
        p = self.page()
