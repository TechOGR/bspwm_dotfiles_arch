#!/usr/bin/env python3
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
#
# PassVault - the password manager of the rice (pass + GPG, rofi, the
# theme's panel). super + alt + x
#
#   ✔ Guided setup: installs pass, picks or creates a GPG key, inits
#   ✔ Search every entry (folders shown as paths)
#   ✔ Copy password / username / URL / OTP code (pass-otp)
#   ✔ Auto-type username + password, or the password only
#   ✔ New entry: username, URL, and a generated password (length and
#     symbols chosen) or your own (typed twice, hidden)
#   ✔ Regenerate a password keeping the other fields, rename, edit
#     (terminal), delete (confirmed), git sync when the store is a repo
#   ✔ Lock: forget the cached GPG passphrase right now
#
# Security:
#   · a copied secret is cleared after CLIP_TIME seconds (only if it is
#     still what the clipboard holds) and never enters the clipboard
#     history: clipcat's watcher is paused while it is there
#   · secrets never go through a command line (visible in ps): pass
#     reads them from stdin, xdotool types them from a private file
#   · never in notifications; typed passwords are hidden in rofi
#
#   PassVault           the menu
#   PassVault --type    pick an entry and type it (like RofiPass --type)
#
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

import os
import re
import secrets
import shutil
import string
import subprocess
import sys
import tempfile
import time

HOME = os.path.expanduser('~')
BSPWM = os.path.join(HOME, '.config/bspwm')
STORE = os.environ.get('PASSWORD_STORE_DIR', os.path.join(HOME, '.password-store'))
THEME = os.path.join(BSPWM, 'config/rofi-themes/Pass.rasi')
CLIP_TIME = int(os.environ.get('PASSVAULT_CLIP_TIME', '30'))


def es():
    try:
        sys.path.insert(0, os.path.join(BSPWM, 'lib'))
        import ricelang
        return ricelang.get_lang() == 'es'
    except Exception:
        return True


ES = es()
