    'Copy password': 'Copiar contraseña', 'Copy username': 'Copiar usuario', 'Copy URL': 'Copiar URL',
    'Copy OTP code': 'Copiar código OTP', 'Type username + password': 'Escribir usuario + contraseña',
    'Type password': 'Escribir contraseña', 'Show': 'Mostrar', 'Regenerate password': 'Regenerar contraseña',
    'Rename': 'Renombrar', 'Edit (terminal)': 'Editar (terminal)', 'Delete': 'Eliminar',
    'Name (folders with /, e.g. web/github)': 'Nombre (carpetas con /, p. ej. web/github)',
    'Username or email (optional)': 'Usuario o correo (opcional)', 'URL (optional)': 'URL (opcional)',
    'Password': 'Contraseña', 'Generate one': 'Generar una', 'Type my own': 'Escribir la mía',
    'Length': 'Longitud', 'With symbols': 'Con símbolos', 'Letters and numbers only': 'Solo letras y números',
    'Type it': 'Escríbela', 'Again, to confirm': 'Otra vez, para confirmar',
    "They don't match": 'No coinciden', 'Saved': 'Guardada', 'Copied': 'Copiada',
    'cleared from the clipboard in': 'se borra del portapapeles en', 'seconds': 'segundos',
    'Delete it?': '¿Eliminarla?', 'Yes, delete': 'Sí, eliminar', 'Cancel': 'Cancelar',
