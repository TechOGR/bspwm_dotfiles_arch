#!/bin/sh
# =============================================================
# ModulesList - Polybar module browser / toggler for bspwm
#
# Shows every polybar module known to this rice (active or not)
# in a rofi menu, with an icon, a short description and its
# current status. Selecting a non-fixed module toggles it on/off
# (BarCtl edits config/polybar.json and restarts polybar; the full
# editor is RiceEditor -> Polybar). Bound to
# `super + alt + m` in sxhkdrc, and to the "" help button in the
# bar itself.
# =============================================================

CONFIG_DIR="$HOME/.config/bspwm"
read -r RICE < "$CONFIG_DIR/.rice"
THEME="$CONFIG_DIR/config/rofi-themes/ModulesList.rasi"
WS_PREVIEW_FLAG="$CONFIG_DIR/config/.ws_preview_enabled"


# id|icon|name|description|fixed(0/1)|kind(bar/service)
# "bar" entries live in config/polybar.json (modules left/center/right). "service"
# entries are background daemons started/stopped directly (nothing to
# add/remove from the bar's module lists).
_catalog='
launcher||Lanzador|Menú de aplicaciones y selector de rice|1|bar
bspwm||Escritorios|Indicador de espacios de trabajo|1|bar
cpu_wave||CPU Wave|Gráfico animado de carga de CPU|0|bar
memory_bar||Memoria|Uso de RAM|0|bar
filesystem||Disco|Espacio usado en /|0|bar
uptime||Uptime|Tiempo desde el último arranque|0|bar
sensors_temp||Temperatura|Temperatura de la CPU|0|bar
gpu||GPU|Uso y temperatura de la GPU|0|bar
heartbeat||Heartbeat|Pulso neón animado (decorativo)|0|bar
song_wave||Now Playing|Ticker animado de la canción en MPD|0|bar
mpd||MPD|Estado corto del reproductor MPD|0|bar
mplayer||Reproductor|Accesos directos al panel de reproducción|0|bar
bluetooth||Bluetooth|Estado del adaptador Bluetooth|0|bar
network||Red|Estado y velocidad de red|0|bar
pulseaudio||Volumen|Control y nivel de audio|0|bar
mic||Micrófono|Silenciar/activar el micrófono|0|bar
battery||Batería|Nivel y estado de carga|0|bar
updates||Actualizaciones|Paquetes pendientes de actualizar|0|bar
weather||Clima|Temperatura y clima actual|0|bar
brightness||Brillo|Nivel de brillo de pantalla|0|bar
xkeyboard||Teclado|Diseño de teclado activo|0|bar
colorpicker||Selector de color|Captura colores en pantalla|0|bar
clipboard||Portapapeles|Historial de portapapeles (clipcat)|0|bar
screenshot||Captura|Herramienta de captura de pantalla|0|bar
sysmonitor||Monitor|Abre el monitor de procesos del sistema|0|bar
caffeine||Modo despierto|Evita que la pantalla se apague|0|bar
workspace_preview||Preview de workspaces|Miniatura al pasar el mouse sobre el selector de escritorios|0|service
date||Fecha y hora|Reloj del sistema|1|bar
tray||Bandeja|Iconos de apps en segundo plano|0|bar
power||Energía|Menú de apagado / reinicio|1|bar
modules_help||Ayuda de módulos|Abre este mismo listado|1|bar
'

# Modules live in config/polybar.json (BarCtl renders bar.ini from it)
get_lines() {
    active=$("$CONFIG_DIR/bin/BarCtl" list 2>/dev/null)
}

is_active() {
    id="$1"
    kind="$2"
    if [ "$kind" = "service" ]; then
        # enabled AND really running (a dead daemon shows as inactive)
        [ -f "$WS_PREVIEW_FLAG" ] && "$CONFIG_DIR/bin/WorkspacePreview" status
    else
        printf '%s\n' "$active" | grep -qx "$id"
    fi
}

toggle_module() {
    mod="$1"
    if [ "$("$CONFIG_DIR/bin/BarCtl" toggle "$mod")" = "on" ]; then
        action="activado"
    else
        action="desactivado"
    fi
    dunstify -i dialog-information "Módulos de Polybar" "'$mod' $action"
}

toggle_service() {
    mod="$1"
    case "$mod" in
        workspace_preview)
            if [ "$("$CONFIG_DIR/bin/WorkspacePreview" toggle)" = "on" ]; then
                action="activado"
            else
                action="desactivado"
            fi
            ;;
        *)
            return 1
            ;;
    esac
    dunstify -i dialog-information "Módulos de Polybar" "'$mod' $action"
}

build_menu() {
    printf '%s\n' "$_catalog" | while IFS='|' read -r id icon name desc fixed kind; do
        [ -z "$id" ] && continue
        if is_active "$id" "$kind"; then
            status="<span foreground='#9ece6a'>● Activo</span>"
        else
            status="<span foreground='#565f89'>○ Inactivo</span>"
        fi
        [ "$fixed" = "1" ] && status="<span foreground='#7aa2f7'>▣ Base</span>"
        printf "$icon  <b>%s</b>  <span foreground='#8C8C8C'>— %s</span>   %s\n" "$name" "$desc" "$status"
    done
}

get_lines

selection_index=$(build_menu | rofi -dmenu -i -markup-rows -format i \
    -p "Módulos de Polybar" \
    -mesg "Enter: activar / desactivar   ·   Esc: cerrar" \
    -theme "$THEME")

[ -z "$selection_index" ] && exit 0

sel_id=$(printf '%s\n' "$_catalog" | awk -F'|' -v n="$((selection_index + 1))" 'NF{c++} c==n{print $1; exit}')
sel_fixed=$(printf '%s\n' "$_catalog" | awk -F'|' -v n="$((selection_index + 1))" 'NF{c++} c==n{print $5; exit}')
sel_kind=$(printf '%s\n' "$_catalog" | awk -F'|' -v n="$((selection_index + 1))" 'NF{c++} c==n{print $6; exit}')

[ -z "$sel_id" ] && exit 0

if [ "$sel_fixed" = "1" ]; then
    dunstify "Módulos de Polybar" "'$sel_id' es un módulo base y no se puede desactivar."
elif [ "$sel_kind" = "service" ]; then
    toggle_service "$sel_id"
else
    toggle_module "$sel_id"
fi
