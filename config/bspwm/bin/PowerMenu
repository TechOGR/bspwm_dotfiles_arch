#!/usr/bin/env python3
# =============================================================
# Author:  TechOGR
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch
#
# PowerMenu - HUD session menu for the rice
#   ✔ Full screen: blurred wallpaper, clock, uptime, user@host
#   ✔ Lock · Suspend · Logout · Reboot · Shut down
#   ✔ Logout / reboot / shut down ask for a second press (3 s)
#   ✔ Keyboard: ←→ / Tab move · Enter select · L S E R P hotkeys ·
#     Esc (or a click on the backdrop) closes
#   ✔ Follows the rice palette
#
# Usage: PowerMenu   (a second launch closes it)
#
# Copyright (C) 2021-2026 TechOGR <https://github.com/TechOGR>
# Licensed under GPL-3.0 license
# =============================================================

import os
import sys
import time
import socket
import subprocess

sys.path.insert(0, os.path.expanduser('~/.config/bspwm/lib'))
import riceui as ui  # noqa: E402
from riceui import Gtk, Gdk, GLib, cairo  # noqa: E402

ACTIONS = [
    # key, glyph, label, hotkey, command, confirm, color
    ('lock', '󰌾', 'Lock', 'L', ['ScreenLocker'], False, 'cyan'),
    ('suspend', '󰤄', 'Suspend', 'S', ['sh', '-c', 'ScreenLocker & sleep 1; systemctl suspend'], False, 'blue'),
    ('logout', '󰍃', 'Logout', 'E', ['bspc', 'quit'], True, 'magenta'),
    ('reboot', '󰜉', 'Reboot', 'R', ['systemctl', 'reboot'], True, 'yellow'),
    ('poweroff', '󰐥', 'Shutdown', 'P', ['systemctl', 'poweroff'], True, 'red'),
]


def uptime():
    try:
        secs = int(float(open('/proc/uptime').read().split()[0]))
    except (OSError, ValueError):
        return ''
    d, r = divmod(secs, 86400)
    h, m = divmod(r // 60, 60)
    return (f'{d}d ' if d else '') + f'{h}h {m:02d}m'


class Power(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.set_title('PowerMenu')
        ui.rgba_window(self)
        geo = ui.monitor_geometry()
        self.W, self.H = geo.width, geo.height
        self.move(geo.x, geo.y)
        self.set_size_request(self.W, self.H)
        self.pal = ui.load_palette()
        self.c = ui.rgb_palette(self.pal)
        self.bg = ui.backdrop(self.W, self.H, self.pal, darken=0.6)
        self.t0 = time.monotonic()
        self.closing = None
        self.armed = None
        self.sel = 0
        self.install_css()

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.get_style_context().add_class('hud')
        self.add(root)
        root.pack_start(Gtk.Box(), True, True, 0)

        row = Gtk.Box(spacing=18)
        row.set_halign(Gtk.Align.CENTER)
        root.pack_start(row, False, False, 0)
        self.tiles = []
        for i, (key, glyph, label, hot, _cmd, _confirm, col) in enumerate(ACTIONS):
            b = Gtk.Button()
            b.get_style_context().add_class('ptile')
            b.get_style_context().add_class(f'c-{col}')
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            hk = Gtk.Label(label=hot, xalign=1)
            hk.get_style_context().add_class('hot')
            v.pack_start(hk, False, False, 0)
            g = Gtk.Label(label=glyph)
            g.get_style_context().add_class('pglyph')
            g.set_size_request(-1, 84)  # glyphs have different line heights
            v.pack_start(g, False, False, 0)
            name = Gtk.Label(label=label.upper())
            name.get_style_context().add_class('pname')
            v.pack_start(name, False, False, 0)
            b.sub = Gtk.Label(label='')
            b.sub.get_style_context().add_class('psub')
            v.pack_start(b.sub, False, False, 0)
            b.add(v)
            b.connect('clicked', lambda _b, i=i: self.activate(i))
            b.connect('enter-notify-event', lambda _b, _e, i=i: self.select(i))
            row.pack_start(b, False, False, 0)
            self.tiles.append(b)

        self.msg = Gtk.Label(label='')
        self.msg.get_style_context().add_class('pmsg')
        root.pack_start(self.msg, False, False, 22)
        foot = Gtk.Label(label='←→ SELECT   ·   ⏎ CONFIRM   ·   L S E R P   ·   ESC CANCEL')
        foot.get_style_context().add_class('foot')
        root.pack_start(foot, False, False, 0)
        root.pack_start(Gtk.Box(), True, True, 0)

        self.add_events(Gdk.EventMask.KEY_PRESS_MASK | Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect('draw', self.on_draw)
        self.connect('key-press-event', self.on_key)
        self.connect('button-press-event', self.on_bg_click)
        self.connect('map-event', lambda *_: ui.grab_input(self))
        self.connect('destroy', Gtk.main_quit)
        self.fade_id = self.add_tick_callback(self.on_tick)
        GLib.timeout_add_seconds(1, self.clock)
        self.select(0)

    def install_css(self):
        css = Gtk.CssProvider()
        extra = ''.join(f'''
button.ptile.c-{k} .pglyph {{ color: {self.pal[k]}; }}
button.ptile.c-{k}.sel {{ border-color: {self.pal[k]}; box-shadow: 0 0 28px alpha({self.pal[k]}, 0.35);
    background-color: alpha({self.pal[k]}, 0.08); }}
button.ptile.c-{k}.sel .pname {{ color: {self.pal[k]}; }}''' for k in ('cyan', 'blue', 'magenta', 'yellow', 'red'))
        css.load_from_data((ui.hud_css(self.pal) + '''
button.ptile { background-image: none; background-color: alpha(@bg, 0.72); box-shadow: none;
    border: 1px solid alpha(@fg, 0.08); border-radius: 22px; padding: 14px 22px 22px 22px;
    min-width: 128px; transition: all 160ms ease; }
.pglyph { font-size: 38pt; }
.pname { font-weight: 800; letter-spacing: 3px; font-size: 10pt; }
.psub { font-size: 7pt; letter-spacing: 2px; color: @red; font-weight: 800; }
.hot { font-size: 7pt; font-weight: 800; color: alpha(@fg, 0.4); }
button.ptile.armed { border: 2px solid @red; background-color: alpha(@red, 0.14);
    box-shadow: 0 0 40px alpha(@red, 0.45); }
button.ptile.armed .pglyph, button.ptile.armed .pname { color: @red; }
.pmsg { font-size: 9pt; letter-spacing: 3px; color: @red; font-weight: 800; }
.foot { font-size: 7pt; letter-spacing: 3px; color: alpha(@fg, 0.4); }
''' + extra).encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    # ─────────────────────────────────────────────────────────── actions
    def select(self, i):
        self.sel = i % len(self.tiles)
        for k, b in enumerate(self.tiles):
            (b.get_style_context().add_class if k == self.sel else b.get_style_context().remove_class)('sel')
        return False

    def activate(self, i):
        key, _g, label, _h, cmd, confirm, _c = ACTIONS[i]
        self.select(i)
        if confirm and self.armed != i:
            self.disarm()
            self.armed = i
            b = self.tiles[i]
            b.get_style_context().add_class('armed')
            b.sub.set_text('PRESS AGAIN')
            self.msg.set_text(f'{label.upper()} IN A MOMENT — PRESS AGAIN TO CONFIRM')
            GLib.timeout_add(3000, lambda k=i: self.disarm() if self.armed == k else False)
            return
        self.hide()
        subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        GLib.timeout_add(60, lambda: self.destroy() or False)

    def disarm(self):
        if self.armed is not None:
            b = self.tiles[self.armed]
            b.get_style_context().remove_class('armed')
            b.sub.set_text('')
            self.msg.set_text('')
        self.armed = None
        return False

    def on_key(self, _w, ev):
        k = ev.keyval
        if k == Gdk.KEY_Escape:
            if self.armed is not None:
                self.disarm()
            else:
                self.close()
        elif k in (Gdk.KEY_Left, Gdk.KEY_ISO_Left_Tab):
            self.disarm()
            self.select(self.sel - 1)
        elif k in (Gdk.KEY_Right, Gdk.KEY_Tab):
            self.disarm()
            self.select(self.sel + 1)
        elif k in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_space):
            self.activate(self.sel)
        else:
            ch = chr(Gdk.keyval_to_unicode(k) or 0).upper()
            for i, a in enumerate(ACTIONS):
                if ch and a[3] == ch:
                    self.activate(i)
                    break
            else:
                return False
        return True

    def on_bg_click(self, _w, ev):
        if ev.window == self.get_window():
            self.close()
        return False

    # ─────────────────────────────────────────────────────────── drawing
    def on_draw(self, _w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_surface(self.bg, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        c = self.c
        cx, top = self.W / 2, self.H * 0.2
        ui.text(cr, time.strftime('%H:%M'), cx, top, 54, (*c['fg'], 0.95), bold=True, align='center', spacing=6)
        ui.text(cr, time.strftime('%A %d %B').upper(), cx, top + 92, 9, (*c['blue'], 0.85),
                align='center', spacing=5)
        who = f'{os.environ.get("USER", "user")}@{socket.gethostname()}'.upper()
        ui.text(cr, f'SESSION  //  {who}', cx, top + 122, 8, (*c['magenta'], 0.9), bold=True,
                align='center', spacing=4)
        ui.text(cr, f'UPTIME  {uptime()}', cx, top + 146, 8, (*c['fg'], 0.5), align='center', spacing=4)
        # neon rule with a marker
        w = 460
        x0, y = cx - w / 2, top + 176
        lg = cairo.LinearGradient(x0, 0, x0 + w, 0)
        lg.add_color_stop_rgba(0, *c['blue'], 0)
        lg.add_color_stop_rgba(0.5, *c['cyan'], 0.85)
        lg.add_color_stop_rgba(1, *c['magenta'], 0)
        cr.rectangle(x0, y, w, 1)
        cr.set_source(lg)
        cr.fill()
        for dx in (-6, 0, 6):
            cr.rectangle(cx + dx - 1.5, y - 1, 3, 3)
        cr.set_source_rgba(*c['cyan'], 1)
        cr.fill()
        return False

    def clock(self):
        self.queue_draw_area(0, 0, self.W, int(self.H * 0.2) + 190)
        return not self.closing

    def on_tick(self, *_):
        # only animates the fade in / out: an idle menu costs nothing
        now = time.monotonic()
        if self.closing:
            a = 1 - (now - self.closing) / 0.14
            if a <= 0:
                self.destroy()
                return False
        else:
            a = min(1.0, (now - self.t0) / 0.18)
        if self.get_window():
            self.get_window().set_opacity(max(0.0, a))
        return self.closing is not None or a < 1.0

    def close(self):
        if not self.closing:
            self.closing = time.monotonic()
            self.add_tick_callback(self.on_tick)


def main():
    GLib.set_prgname('PowerMenu')
    _lock = ui.single_instance('powermenu', toggle=True)  # noqa: F841
    win = Power()
    ui.quit_on_sigterm(win.close)
    win.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
