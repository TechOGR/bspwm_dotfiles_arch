#!/bin/sh
# =============================================================
# Author:  techogr
# Repo:    https://github.com/TechOGR/bspwm_dotfiles_arch.git
# Date:    13.09.2026
#
# RiceSelector - Dynamic theme switcher for TechOGR bspwm
# =============================================================

# Some vars
bspwm_dir="$HOME/.config/bspwm"
read -r current_rice < "$bspwm_dir"/.rice

# List rices (rutas completas; sin forks de basename)
rices=$(find "$bspwm_dir/rices/" -mindepth 1 -maxdepth 1 -type d | sort)

IFS='
'

# Find current rice
selected_index=-1
index=0
for rice in $rices; do
    [ "${rice##*/}" = "$current_rice" ] && { selected_index=$index; break; }
    index=$((index + 1))
done

# Show the rofi selection menu.
selected=$(
    for rice in $rices; do
        name=${rice##*/}
        printf "%s\000icon\037%s/preview.jpg\n" "$name" "$rice"
    done | rofi -dmenu -p "RiceSelector" \
                -theme "$bspwm_dir/config/rofi-themes/RiceSelector.rasi" \
                -selected-row "$selected_index"
)
unset IFS

# If a valid option was selected, write the value to the configuration file and change theme.
if [ -n "$selected" ] && [ "$selected" != "$current_rice" ]; then
    echo "$selected" > "$bspwm_dir"/.rice
    "${bspwm_dir}"/bin/Theme.sh
fi
